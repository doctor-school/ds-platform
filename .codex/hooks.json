{
  "description": "DS Platform agent-discipline hooks for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/run-project-hook.mjs\" bootstrap",
            "commandWindows": "powershell -NoProfile -Command \"node ((git rev-parse --show-toplevel) + '/tools/hooks/run-project-hook.mjs') bootstrap\"",
            "timeout": 60,
            "statusMessage": "Loading DS Platform project state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|MultiEdit|Bash|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/run-project-hook.mjs\" worktree-path-guard",
            "commandWindows": "powershell -NoProfile -Command \"node ((git rev-parse --show-toplevel) + '/tools/hooks/run-project-hook.mjs') worktree-path-guard\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^((collaboration\\.?)?spawn_agent|Agent|Task|apply_patch|Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/run-project-hook.mjs\" dispatch-guard",
            "commandWindows": "powershell -NoProfile -Command \"node ((git rev-parse --show-toplevel) + '/tools/hooks/run-project-hook.mjs') dispatch-guard\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*__browser_(take_screenshot|pdf_save)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/run-project-hook.mjs\" screenshot-path-guard",
            "commandWindows": "powershell -NoProfile -Command \"node ((git rev-parse --show-toplevel) + '/tools/hooks/run-project-hook.mjs') screenshot-path-guard\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^((collaboration\\.?)?spawn_agent|Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/run-project-hook.mjs\" lead-context-budget",
            "commandWindows": "powershell -NoProfile -Command \"node ((git rev-parse --show-toplevel) + '/tools/hooks/run-project-hook.mjs') lead-context-budget\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/run-project-hook.mjs\" subagent-context-budget",
            "commandWindows": "powershell -NoProfile -Command \"node ((git rev-parse --show-toplevel) + '/tools/hooks/run-project-hook.mjs') subagent-context-budget\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^((collaboration\\.?)?(spawn_agent|followup_task)|Agent|Task|Read|Skill|Bash|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/run-project-hook.mjs\" wrap-owner-only",
            "commandWindows": "powershell -NoProfile -Command \"node ((git rev-parse --show-toplevel) + '/tools/hooks/run-project-hook.mjs') wrap-owner-only\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/run-project-hook.mjs\" context-budget",
            "commandWindows": "powershell -NoProfile -Command \"node ((git rev-parse --show-toplevel) + '/tools/hooks/run-project-hook.mjs') context-budget\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
