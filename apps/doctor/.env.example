# Doctor storefront environment (copy to .env.local). Read at RUNTIME by the server.

# REQUIRED (#3147) — the Academy origin the doctor footer crossing links to
# (017 EARS-12 / LD-4). Read at REQUEST time by the storefront layout; the doctor
# app refuses to render without it (no production fallback). Local: the portal
# you run (`pnpm --filter @ds/portal dev` binds :3001); stage slot: rendered by
# tools/staging/slot.mjs; production: /etc/ds-platform/api.env.
ACADEMY_PUBLIC_ORIGIN=http://localhost:3001
