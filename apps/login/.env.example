# apps/login — the sign-in host (ADR-0015 §4). Dev values; the stand's ports
# come from `pnpm dev:ports` (login = API + 5).
#
# The api upstream the `/v1/*` rewrite and the server-side entry read use.
API_PROXY_TARGET=http://localhost:3000
# Yandex SmartCaptcha client key (runtime env, read per request by the
# @ds/auth-flow server mounts). Empty in dev = the widget is not rendered.
SMARTCAPTCHA_SITE_KEY=
