# Portal environment (copy to .env.local). Read at RUNTIME by the server (#2981).

# Yandex SmartCaptcha CLIENT key — the public half of the keypair (003 #84).
# Read per request by the @ds/auth-flow server mounts. Unset ⇒ the
# BotProtectionField renders an inactive placeholder; set it to render the live
# widget. The SERVER key lives in the API env (SMARTCAPTCHA_SERVER_KEY), never
# here.
SMARTCAPTCHA_SITE_KEY=

# REQUIRED (#3147) — the doctor storefront origin the Academy footer crossing
# links to (017 EARS-12). Read at REQUEST time by the root layout and the shell
# header; the portal refuses to render without it (no production fallback).
# Local: the doctor app you run (`pnpm --filter @ds/doctor dev` binds :3004);
# stage slot: rendered by tools/staging/slot.mjs; production:
# /etc/ds-platform/api.env.
DOCTOR_PUBLIC_ORIGIN=http://localhost:3004
