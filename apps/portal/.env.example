# Portal environment (copy to .env.local). Read at RUNTIME by the server (#2981).

# Yandex SmartCaptcha CLIENT key — the public half of the keypair (003 #84).
# Read per request by the @ds/auth-flow server mounts. Unset ⇒ the
# BotProtectionField renders an inactive placeholder; set it to render the live widget. The SERVER key lives in the
# API env (SMARTCAPTCHA_SERVER_KEY), never here.
SMARTCAPTCHA_SITE_KEY=
