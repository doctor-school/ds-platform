# /etc/ds-platform/api.env — TEMPLATE (DSO-100 spec §5.4; wave-1 increment #729 /
# DSO-134). Copy onto api-prod as /etc/ds-platform/api.env, root:root 0600, fill
# REAL values. NEVER commit real values. Consumed by the `api`, `portal`, `admin`,
# `centrifugo`, `sms-aero-adapter`, and `migrate` services
# (compose/api-prod/compose.yml) via env_file. Every NAME below is read by the
# built code — verified against apps/api/src/config/env.schema.ts,
# apps/api/src/main.ts, apps/portal/next.config.ts, apps/admin/next.config.ts,
# apps/api/src/room/chat.gateway.ts, and the sms-aero-adapter.
#
# The `ds` DB password here MUST equal POSTGRES_PASSWORD in data.env and the
# ZITADEL_DATABASE_*_PASSWORD in zitadel.env (one Postgres role, `ds`).
#
# QUOTING: besides compose env_file, this file is BASH-SOURCED by the deploy
# runbook (`set -a; . /etc/ds-platform/api.env; set +a` — infra/deploy/README.md),
# so any value containing spaces MUST be double-quoted (e.g.
# SMSAERO_SIGN="SMS Aero"). Unquoted, bash truncates the variable at the first
# space and tries to execute the remainder (`command not found`).

# === Core datastores → data-prod PRIVATE VPC IP (var.data_prod_private_ip) ===
# Host is the private IP ONLY (data-prod has no inbound public path — spec §5.1).
DATABASE_URL=postgresql://ds:<db-password>@192.168.0.10:5432/ds_prod
REDIS_URL=redis://192.168.0.10:6379
# NO PORT line here on purpose (DSO-100 on-box find): this env_file is SHARED by
# api + portal + sms-aero-adapter + migrate, and a PORT=3000 here overrides the
# portal image's ENV PORT=3001 → the portal binds 3000 and Caddy's portal:3001
# upstream breaks. The api defaults PORT to 3000 in code (env.schema.ts); the
# portal's 3001 is pinned via compose `environment:` (compose/api-prod/compose.yml).

# === Error monitoring (GlitchTip — DSO-125) ===
# Self-hosted GlitchTip on data-prod (152-ФЗ: Sentry SaaS rejected — ADR-0004 §15 /
# ADR-0005 §10). The api reports over the VPC to the GlitchTip web/ingest port on
# data-prod's PRIVATE IP (never a public host). DSN = the ds-platform-api project DSN
# from the GlitchTip UI, with its host rewritten to the VPC endpoint
# (192.168.0.10:8000). Absent ⇒ Sentry SDK is a no-op (env.schema.ts SENTRY_DSN
# optional); the api boots identically without it (like the IdP / Redis fakes).
# NO PII leaves the process (beforeSend strips request/user/server; breadcrumbs off).
SENTRY_DSN=http://<project-key>@192.168.0.10:8000/<project-id>
SENTRY_ENVIRONMENT=production

# === Identity provider (Zitadel) — issuer + OIDC app (spec §5.4, §6.1) ===
# The bare https origin Caddy fronts (must byte-match Zitadel's advertised issuer).
IDP_ISSUER=https://id.doctor.school
# The ds-bootstrap machine-user PAT captured at Zitadel first-init (README init
# step). Binds the REAL Zitadel adapter (with IDP_ISSUER); absent ⇒ in-memory fake.
IDP_SERVICE_TOKEN=<ds-bootstrap-pat>
# OIDC confidential-client creds emitted by idp/provision.sh (README init step).
IDP_CLIENT_ID=<from-provision.sh>
IDP_CLIENT_SECRET=<from-provision.sh>
# The Zitadel project that owns the doctor_guest role (provision.sh IDP_PROJECT_ID).
IDP_PROJECT_ID=<from-provision.sh>
# The api BFF OIDC callback — MUST byte-match a redirect URI provision.sh registers
# (run provision.sh with IDP_REDIRECT_URIS=https://api.doctor.school/auth/callback).
IDP_REDIRECT_URI=https://api.doctor.school/auth/callback
# Shared secret authenticating the Zitadel Action webhook (EARS-19 mirror sync).
# Fail-closed when unset (the webhook 401s); set it and configure the Action in
# Zitadel to converge the users mirror in real time (the periodic sweep backstops it).
IDP_WEBHOOK_SECRET=<random-hex>
# IDP_ORG_ID — optional; the adapter resolves it at runtime from the service
# account's own org and caches it. Pin only in a multi-org deployment.
# IDP_ORG_ID=

# === Audit ledger HMAC pepper (REQUIRED — #141 fail-closed at boot) ===
# Unset ⇒ the audit writer DI throws and `node dist/main.js` never finishes boot.
# Generate once, keep stable:  openssl rand -hex 32
AUDIT_IDENTIFIER_PEPPER=<openssl-rand-hex-32>

# === Lifecycle-impact token HMAC secret (REQUIRED — 012 §3.1 fail-closed at boot) ===
# Signs the preview→confirm envelope of every taxonomy lifecycle transition.
# Unset ⇒ `LifecycleImpactService` throws at construction and `node dist/main.js`
# never finishes boot. Generate once, keep stable:  openssl rand -hex 32
# (Rotating it invalidates in-flight preview tokens only — operators re-confirm.)
LIFECYCLE_IMPACT_TOKEN_SECRET=<openssl-rand-hex-32>

# === Sign-in host at-rest key (REQUIRED once ds-login ships — ADR-0015 §4, #3171) ===
# AES-256-GCM key for the sign-in host's records (base64 of exactly 32 bytes).
# Unset ⇒ the sign-in-host module is disabled and every form post 404s, so
# `pnpm deploy:prod` refuses a target that ships ds-login without it (counted on
# the box, never printed). Generate once, keep stable:  openssl rand -base64 32
SIGN_IN_RECORD_KEY=<openssl-rand-base64-32>

# === Storefront redeem secrets (003 EARS-62/71, ADR-0015 §4 — TOOL-WRITTEN, #3172) ===
# NOT in this file: the portal and doctor load the whole api.env (#3258), and they
# must never hold a client key. `pnpm deploy:prod`'s pre-swap IdP converge
# (provision.sh step 3.bis.2) writes them, keeps them while valid, and refuses the
# release before the swap when it cannot, into two root-only (0600) files:
#   /etc/ds-platform/api-sign-in.env — the three names below; the api ALONE loads it.
#   /etc/ds-platform/internal.env    — INTERNAL_API_TOKEN only (the same value);
#                                      the portal and doctor load it.
# Never printed — the deploy log carries key ids only; the deploy refuses when
# api.env carries a client key.
#   IDP_ACADEMY_CLIENT_KEY / IDP_DOCTOR_CLIENT_KEY — the storefront clients'
#     private_key_jwt Zitadel JSON key (base64 of the key file, one line); the api
#     signs its token-endpoint assertions with them. Re-minted when the key is
#     revoked at the IdP.
#   INTERNAL_API_TOKEN — the bearer of every `/v1/internal/*` route (≥32 bytes).
#     The portal and doctor servers read it from internal.env and call
#     INTERNAL_API_URL=http://api:3000 (set in compose.yml). Unset ⇒ the internal
#     routes answer 404.
# (api-sign-in.env) IDP_ACADEMY_CLIENT_KEY=<tool-written>
# (api-sign-in.env) IDP_DOCTOR_CLIENT_KEY=<tool-written>
# (api-sign-in.env, internal.env) INTERNAL_API_TOKEN=<tool-written>

# === Public congress sign-up (044 — REQUIRED wherever the congress intake is served) ===
# The intake registers every submitter for ONE event and stamps ONE consent
# version, both read from here and never from the submission: a caller able to
# name the event could register strangers for any event in the catalogue, and a
# caller able to name the consent version could choose which version they are
# recorded as having accepted.
#
# The event uuid differs per environment — take it from the congress event row of
# THIS environment's catalogue, not from another stand.
CONGRESS_SIGNUP_EVENT_ID=<uuid-of-the-congress-event-in-this-environment>
# ADR-0009 §2.1 — publication date of the congress personal-data text plus the
# sha256 of the published text, exactly `YYYY-MM-DD.sha256-<64 lowercase hex>`.
# The text is published on the congress site (a different repository), so this is
# configuration rather than a code literal and changing it needs no API release.
# Compute:  sha256sum <the published text file>
CONGRESS_SIGNUP_CONSENT_VERSION=<YYYY-MM-DD>.sha256-<64-lowercase-hex>
#
# 044 EARS-28 — REQUIRED, both of them. The registration window: the instant the
# public congress intake starts accepting submissions and the instant it stops.
# Format: an ISO-8601 date-time that STATES ITS OWN OFFSET, e.g.
# `2026-10-01T00:00:00.000+03:00` (Moscow) or `2026-09-30T21:00:00Z`. An
# offset-less value is REFUSED rather than guessed: the API runs in UTC and the
# congress is in Moscow, so `2026-10-01T00:00:00` would open registration three
# hours early. The close must be strictly after the open.
#
# Each environment carries its OWN window: a stand or a stage slot needs a
# window that is open right now for the intake to be exercisable at all, while
# the production values are the owner's real dates — a launch input on #2292,
# and the same instants the congress site displays.
CONGRESS_SIGNUP_WINDOW_OPENS_AT=2026-10-01T00:00:00.000+03:00
CONGRESS_SIGNUP_WINDOW_CLOSES_AT=<YYYY-MM-DD>T00:00:00.000+03:00
#
# 044 EARS-34 — REQUIRED. The congress DAYS the registrar marks attendance on at
# the desk: comma-separated ISO calendar dates, ascending, no repeats. A mark for
# any other date is refused; the roster renders one attendance box per day.
CONGRESS_SIGNUP_EVENT_DAYS=2027-04-23,2027-04-24
# The six keys above unset, malformed or (for the window) inverted ⇒ the intake
# refuses every submission with its one generic refusal, before any side effect
# (fail-closed); the rest of the API boots normally.
#
# 044 EARS-7 — OPTIONAL. Whole milliseconds every intake response is padded to,
# so that creating an account in the IdP (unknown address) and attaching a
# registration to an existing one (known address) take the same time on the
# wire. Unset ⇒ the conservative default of 1000. Set it to at least the p99 of
# the new-account path as measured on THIS environment: a floor below the slower
# branch pads neither and reopens the «does this address already have an
# account?» oracle. It is read per request, so raising it needs no release; a
# value that is not whole milliseconds refuses the intake rather than quietly
# falling back.
# CONGRESS_SIGNUP_TIMING_FLOOR_MS=1000

# 003 EARS-51 — OPTIONAL. Whole milliseconds every `POST /v1/me/phone` response is
# padded to, so a number confirmed on another account and a free number take
# the same time on the wire. Unset or malformed ⇒ the conservative default of
# 1000. Set it to at least the p99 of the free-number (IdP write + SMS) path on
# THIS environment; it is read per request, so raising it needs no release.
# PHONE_CODE_REQUEST_TIMING_FLOOR_MS=1000

# 003 EARS-41/16 — OPTIONAL. Only POST /v1/auth/verify uses this timing floor.
# Unset, empty, malformed, below 40 or above 2147483647 whole milliseconds falls
# back to 1000. The upper bound prevents Node timer overflow from becoming 1 ms.
# Calibrate to at least the heaviest real-IdP branch's p99 plus scheduling margin
# on THIS environment; five browser samples are not a p99 estimate. A branch
# exceeding the floor remains visible, so recheck after IdP/network changes.
# Read per request; a changed env_file reaches an existing process on restart.
# The shared 40 ms floor and detached mail-send responses are unaffected.
# AUTH_VERIFY_TIMING_FLOOR_MS=1000

# === Delivery mode (spec §6.1/§6.2) — LIVE email + SMS for the slice DoD ===
# Unleash is out of slice (spec §8), so these env values ARE the delivery decision:
# `real` ⇒ the api's flag fallback treats email-delivery-real / sms-delivery-real as
# ON, and idp/provision.sh activates the matching Zitadel provider at boot.
EMAIL_DELIVERY_MODE=real
SMS_DELIVERY_MODE=real

# === Real SMTP relay — mail.ru business (spec §6.1) ===
# Consumed by the BFF MailerModule (real transport when email-delivery-real is ON)
# AND by idp/provision.sh for Zitadel's real SMTP provider (source api.env when you
# run provision.sh). HOST carries host:port; secure is derived from :465.
# Deliberate compatibility selection until controlled activation (#2116).
# See smtp-activation.md before deploying this configuration revision.
IDP_SMTP_REAL_PROVIDER=mail.ru
IDP_SMTP_REAL_HOST=smtp.mail.ru:465
IDP_SMTP_REAL_USER=noreply@doctor.school
IDP_SMTP_REAL_PASSWORD=<mailru-app-password>
IDP_SMTP_REAL_SENDER_ADDRESS=noreply@doctor.school
IDP_SMTP_REAL_SENDER_NAME=Doctor.School
# REQUIRED by the admin container (it shares this env_file; #2619): the Academy
# public origin admin «Публичная ссылка» (project / partner / expert) links to.
# Also REQUIRED by the doctor container (#3147): the target of its footer
# crossing to the Academy (017 EARS-12 / LD-4). Read at request time; both
# refuse to render without it.
ACADEMY_PUBLIC_ORIGIN=https://academy.doctor.school
# REQUIRED by the portal container (it shares this env_file; #3147): the doctor
# storefront origin the Academy footer crossing links to (017 EARS-12). Read at
# request time; the portal refuses to render without it.
DOCTOR_PUBLIC_ORIGIN=https://doctor.school
# MAILER_SMTP_* is the Mailpit-intercept transport (flag OFF). Unused when
# email-delivery-real is ON (the real transport reuses IDP_SMTP_REAL_* above). Leave
# unset in prod so the intercept path degrades to a logged no-op.
# MAILER_SMTP_HOST=
# MAILER_SMTP_PORT=
# MAILER_SMTP_FROM=noreply@doctor.school

# === BFF-only reserve chain: Postbox -> mail.ru -> Resend (003 design section 14.3) ===
# Each reserve is off by default and joins only with its own switch AND complete
# credentials; credentials alone never activate or promote a provider. An enabled
# reserve with incomplete credentials, or a mail.ru reserve while
# IDP_SMTP_REAL_PROVIDER=mail.ru, fails api startup. The next channel is tried only
# after a definite provider failure; an ambiguous, recipient-permanent or accepted
# attempt stops the chain (40 s total budget). Native Zitadel SMTP has no BFF
# reserve/deadline. Runbook: infra/deploy/smtp-activation.md.
# mail.ru reserve: own credentials, never the IDP_SMTP_REAL_* values.
MAILER_FALLBACK_SMTP_ENABLED=false
# MAILER_FALLBACK_SMTP_PROVIDER=mail.ru
# MAILER_FALLBACK_SMTP_HOST=smtp.mail.ru
# MAILER_FALLBACK_SMTP_PORT=465
# MAILER_FALLBACK_SMTP_USER=<mail.ru-mailbox>
# MAILER_FALLBACK_SMTP_PASSWORD=<mail.ru-app-password>
# MAILER_FALLBACK_SMTP_SENDER_ADDRESS=noreply@doctor.school
# Resend: last channel; enable only with the recorded processing decision.
RESEND_ENABLED=false
# RESEND_API_KEY=<resend-api-key>

# === SMS-Aero (Gate API v2, spec §6.2) — consumed by sms-aero-adapter ===
# REAL SMS COSTS MONEY — the SmsBudgetService guards it; exercise with ONE
# supervised paid test. Prod creds otherwise live in Beget ~/.env; never commit.
# The EARS-14 budget ceilings are env-overridable (#3047; unset = the defaults
# per-phone 3/h, per-IP 10/h, per-ASN 100/h, global 2000/day). Production sets
# NONE of them — they exist for one-IP test stands (the stage slots):
# SMS_BUDGET_PER_PHONE_1H= SMS_BUDGET_PER_IP_1H= SMS_BUDGET_PER_ASN_1H=
# SMS_BUDGET_GLOBAL_1D=
SMSAERO_EMAIL=<smsaero-account-email>
SMSAERO_API_KEY=<smsaero-api-key>
# Sender signature carries a SPACE — KEEP the double quotes (header QUOTING
# note): the runbook bash-sources this file, and an unquoted space truncates
# the value and emits `command not found`.
SMSAERO_SIGN="SMS Aero"

# === Portal → same-origin BFF proxy (apps/portal/next.config.ts) ===
# Internal compose URL of the api; the portal rewrites /v1/* here server-side so the
# __Host- session cookie stays same-origin. NOT a public URL.
API_PROXY_TARGET=http://api:3000

# === Centrifugo — webinar room chat (wave-1, spec §5.4; #729) ===
# The api mints gate-scoped connection tokens and publishes over the server API;
# room chat is FAIL-CLOSED without the triple (no tokens minted, chat degrades) —
# all three are MANDATORY in prod. CENTRIFUGO_URL is the ONE origin the api
# derives BOTH endpoints from (apps/api/src/room/chat.gateway.ts): the browser
# wss URL (wss://<host>/connection/websocket) and the HTTP-API base (<url>/api).
# Caddy routes those two path families on api.doctor.school to the centrifugo
# container — so the value is the PUBLIC api origin, not an internal compose URL.
CENTRIFUGO_URL=https://api.doctor.school
# Generate each independently: openssl rand -hex 32
CENTRIFUGO_API_KEY=<openssl-rand-hex-32>
CENTRIFUGO_TOKEN_HMAC_SECRET=<openssl-rand-hex-32>
# Chat connection-token TTL (seconds). Optional — the api defaults to 3600.
# CHAT_TOKEN_TTL_SECONDS=3600
# Centrifugo-NATIVE duplicates of the two secrets above — the centrifugo
# container reads THIS file too (compose env_file) and env overrides its
# config.json, which carries no secrets. Each MUST byte-equal its api-named
# twin, or token verification / server publishes break:
#   CENTRIFUGO_HTTP_API_KEY                  == CENTRIFUGO_API_KEY
#   CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY  == CENTRIFUGO_TOKEN_HMAC_SECRET
CENTRIFUGO_HTTP_API_KEY=<same-as-CENTRIFUGO_API_KEY>
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=<same-as-CENTRIFUGO_TOKEN_HMAC_SECRET>

# === Object storage — Timeweb S3 `uploads` bucket (wave-1, spec §6.3; #729) ===
# Program-PDF uploads/downloads. ALL SIX keys are MANDATORY in prod: with
# S3_ENDPOINT unset the api silently FAIL-OPENS to an in-memory FakeObjectStorage
# (a silent prod failure mode — spec §10.8 asserts the real path explicitly).
# Values come from the Terraform uploads-bucket outputs (README wave-1 step):
#   S3_ENDPOINT      = https://<terraform output -raw uploads_s3_hostname>
#   S3_BUCKET_UPLOADS = <terraform output -raw uploads_bucket_full_name>
#   S3_ACCESS_KEY    = <terraform output -raw uploads_s3_access_key>
#   S3_SECRET_KEY    = <terraform output -raw uploads_s3_secret_key>
# These are the UPLOADS creds — never the pgbackrest repo keys (separate bucket,
# separate creds; backup creds stay in data.env — spec §6.3).
S3_ENDPOINT=https://<uploads_s3_hostname>
S3_REGION=ru-1
S3_BUCKET_UPLOADS=<uploads_bucket_full_name>
S3_ACCESS_KEY=<uploads_s3_access_key>
S3_SECRET_KEY=<uploads_s3_secret_key>
S3_FORCE_PATH_STYLE=true

# === Client-IP resolution behind the proxy chain (#1655) ===
# The reverse proxies the api trusts to have set `x-forwarded-for`. Comma-
# separated IP addresses, CIDR blocks, or the preset names loopback / linklocal /
# uniquelocal. LEAVE UNSET in this deployment: the default (loopback + linklocal +
# uniquelocal, i.e. the private ranges) is exactly the compose network Caddy and
# the doctor app's `/v1/:path*` rewrite reach the api from, so `request.ip`
# resolves to the real client on BOTH the 1-hop (Caddy → api) and 2-hop
# (Caddy → doctor → api) chains, while a forwarded header from any public peer is
# ignored. Set it only to NARROW the trusted set (e.g. after moving the api onto a
# network shared with untrusted workloads). A malformed entry is dropped with a
# warn and the default applies — it can never fail open (apps/api/src/config/
# trust-proxy.ts).
# TRUSTED_PROXIES=

# === Bot protection (Yandex SmartCaptcha) — ON on prod ===
# The SERVER half of the prod keypair lives here; the CLIENT half
# (SMARTCAPTCHA_SITE_KEY) is portal/doctor RUNTIME env (#2981: the images are
# environment-agnostic), interpolated by compose from the .env beside
# compose.yml — NOT from this file.
# ONE compose var (SMARTCAPTCHA_SITE_KEY) feeds BOTH the portal and the doctor
# containers, so bot protection is all-or-nothing across the two storefronts —
# it cannot be ON for academy.doctor.school alone.
# Owner console screenshot, 2026-09-09 (#2117, follow-up to #1959):
# ds-platform-prod allows academy.doctor.school + new.doctor.school, with
# domain validation ON. Console configuration is confirmed; successful live
# registration/resend must be evidenced separately on the linked task.
# Domain-only changes need no rebuild/deploy when site/server keys are unchanged.
# Turn it OFF (all three steps, in order):
#   1. Here: BOT_PROTECTION_ENABLED=false + comment out SMARTCAPTCHA_SERVER_KEY.
#   2. Empty the site key (SMARTCAPTCHA_SITE_KEY=) in the compose `.env` beside
#      compose/api-prod/compose.yml.
#   3. `pnpm deploy:prod` — it recreates the storefront containers, which read the
#      site key at runtime (no rebuild needed). The clients then submit tokenless and the api guard
#      stays wired and no-ops (003 design §10.1 fallback).
# Turn it back ON: reverse the same three steps — BOT_PROTECTION_ENABLED=true
# plus the ysc2_ server half here, SMARTCAPTCHA_SITE_KEY=ysc1_… in the compose
# `.env`, then `pnpm deploy:prod`.
# Either direction, back up both files on the box first, naming the state the
# flip moves TO: `cp api.env api.env.bak-captcha-<on|off>-<ts>` (same pattern
# for the compose `.env`).
# Rate limits are independent of this flag and stay on in both states.
BOT_PROTECTION_ENABLED=true
SMARTCAPTCHA_SERVER_KEY=<smartcaptcha-server-key>
# Validation endpoint override — optional; the api defaults to the public
# Yandex endpoint (apps/api/src/bot-protection/smart-captcha.provider.ts).
# SMARTCAPTCHA_VALIDATE_URL=

# === Feature flags (Unleash) — OUT OF SLICE (spec §8); env fallback only ===
# Leave UNLEASH_URL/UNLEASH_API_TOKEN unset ⇒ every flag resolves to its env
# bootstrap defaults above (delivery = the *_DELIVERY_MODE values;
# bot-protection = BOT_PROTECTION_ENABLED).
# UNLEASH_URL=
# UNLEASH_API_TOKEN=
