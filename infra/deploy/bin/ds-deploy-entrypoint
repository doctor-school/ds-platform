#!/usr/bin/env bash
# ds-deploy-entrypoint — the forced command of every CI key (Issue #2984; tech spec
# apps/docs/content/specs/tech/2026-10-16-release-pipeline-off-workstation-en.md §4,
# §8 step (c)).
#
# A CI key in deploy's authorized_keys carries
#   command="/usr/local/bin/ds-deploy-entrypoint",no-pty,no-port-forwarding,...
# (on ds-api-prod `command="sudo -n /usr/local/bin/ds-deploy-entrypoint",...`: deploy's
# one sudo right there, /etc/sudoers.d/90-ds-deploy, which keeps SSH_ORIGINAL_COMMAND
# through sudo's env reset — spec §4 «sudo on prod»; the per-call `sudo` below is then
# a no-op as root)
# so sshd runs this file whatever the client asked for, and the request arrives in
# SSH_ORIGINAL_COMMAND. It is split on single spaces into words — never `eval`d,
# never handed to a shell — and must be exactly one of:
#
#   status <env> <sha>     -> sudo /usr/local/bin/ds-release status <env> <sha>, with
#                             the release driver's unit state added as `driver`
#   release <env> <sha>    -> /usr/local/lib/ds-platform/release-driver <env> <sha>
#                             (stdin = the images-<sha>.json manifest)
#   rollback prod <sha>    -> release-driver rollback prod <sha> (prod box only;
#                             stdin = the target's images-<sha>.json; #2987)
#   rollback-status prod <sha>
#                          -> release-driver rollback-status prod <sha>: the rollback
#                             record and the -rollback unit state (prod box only)
#   redeploy prod <sha>    -> release-driver redeploy prod <sha> (prod box only; the
#                             live SHA's release run again, every container
#                             recreated; stdin = its images-<sha>.json; #3354)
#   upload-report <sha>    -> a tar stream on stdin into
#                             /var/lib/ds-platform/e2e-reports/<sha>/ (stage box only)
#   observe <name>         -> one named read-only observation of the stage `main`
#                             slot (stage box only; Issue #3119), its parameters as
#                             one JSON object on stdin
#
#   the data-prod verbs     -> served on the data box only (Issue #3313; spec §5
#                             «Data-prod verbs.»), the forced command of the hop key
#                             from ds-api-prod: see DATA_VERBS below
#
# observe runs only the observations OBSERVE_PY below defines (its OBSERVATIONS
# table, pinned equal to the case arm by the tests): never SQL or shell from the
# client. Every parameter is checked against its own pattern box-side and reaches
# psql as a psql variable quoted by psql (`:'name'`), never spliced into the SQL
# text. The SQL runs against the `main` slot database only, inside `BEGIN READ
# ONLY` with a statement timeout, and the result is checked to come from that
# database in a read-only transaction before it is printed. The output is only
# what the stage e2e suite parses about its own test-owned rows (a count, a
# fingerprinted snapshot, the configured academy host, the password policy); the
# stage env, the IdP token and psql's diagnostics never leave the box.
# Its prod counterpart is the data verb read-observe and its PROD_OBSERVATIONS
# (#3647): aggregates only, a separate table, reached by ds-read-entrypoint only.
#
# <env> and <sha> are checked with the regexes of ds-release (ENV_RE / SHA_RE below
# are a copy; tools/deploy/ds-deploy-entrypoint.test.mjs pins them equal). Anything
# else exits 2 and is logged at auth.warning; accepted commands log at auth.info.
# The client sees status lines only (spec §4, public logs).
#
# Installed as /usr/local/bin/ds-deploy-entrypoint beside ds-release, by the same
# install step and under the same rule (every prod run; on ds-stage-1 only the stage
# `main` converge of a SHA contained in `main`, #3125).
#
# Exit codes: 0 ok · 1 the command failed · 2 rejected (usage, an unknown
# observation, bad parameters) · 3 refused (the box cannot serve it: no release
# driver, not the stage box, an unsafe archive).
set -euo pipefail
# The bracket ranges of the checks below must not follow a client-chosen collation
# (sshd's AcceptEnv passes LC_*).
export LC_ALL=C

# Test hooks: a root prefix and the DS_ENTRYPOINT_* cap overrides below. The
# installed entrypoint never reads them, whatever sshd's AcceptEnv /
# PermitUserEnvironment (pinned `no` by the hardening drop-in) let through.
ROOT=
if [[ ${BASH_SOURCE[0]} != /usr/local/bin/ds-deploy-entrypoint ]]; then
  ROOT=${DS_ENTRYPOINT_ROOT:-}
fi
override() { [[ -n $ROOT ]] && printf '%s' "${!1:-$2}" || printf '%s' "$2"; }
DS_RELEASE=$ROOT/usr/local/bin/ds-release
RELEASE_DRIVER=$ROOT/usr/local/lib/ds-platform/release-driver
BOX_ROLE_FILE=$ROOT/etc/ds-platform/box-role
REPORTS_PARENT=$ROOT/var/lib/ds-platform
REPORTS_ROOT=$REPORTS_PARENT/e2e-reports
REPORT_RETENTION_DAYS=14
STAGE_ENV_FILE=$ROOT/etc/ds-platform/stage.env
IDP_PAT_FILE=$ROOT/etc/ds-platform/idp-bootstrap-pat.txt
MAX_OBSERVE_PARAMS_BYTES=4096
# Test hook only: where the password-policy observation sends its IdP request,
# after the configured IdP origin has passed its check. Empty on the box.
OBSERVE_IDP_ORIGIN=$(override DS_ENTRYPOINT_IDP_ORIGIN '')
# Upload caps. A Playwright report of our suite, traces included, is tens of MB; the
# caps sit an order of magnitude above it, and well inside the stage disk, so a
# CI key can neither fill the disk with one stream nor unpack a tar bomb. The
# DS_ENTRYPOINT_* overrides are honoured only under a test root prefix.
MAX_REPORT_BYTES=$(override DS_ENTRYPOINT_MAX_REPORT_BYTES $((512 * 1024 * 1024)))             # 512 MiB stream
MAX_REPORT_UNPACKED_BYTES=$(override DS_ENTRYPOINT_MAX_UNPACKED_BYTES $((2 * 1024 * 1024 * 1024))) # 2 GiB unpacked
MAX_REPORT_ENTRIES=$(override DS_ENTRYPOINT_MAX_REPORT_ENTRIES 20000)                          # archive members
REPORT_FREE_MARGIN_BYTES=$(override DS_ENTRYPOINT_FREE_MARGIN_BYTES $((1024 * 1024 * 1024)))   # left free after unpacking
[[ $MAX_REPORT_BYTES =~ ^[0-9]+$ && $MAX_REPORT_UNPACKED_BYTES =~ ^[0-9]+$ &&
  $MAX_REPORT_ENTRIES =~ ^[0-9]+$ && $REPORT_FREE_MARGIN_BYTES =~ ^[0-9]+$ ]] ||
  { echo "ds-deploy-entrypoint: bad cap override" >&2; exit 2; }

ENV_RE='^(prod|stage-main|stage-pr-[1-9][0-9]*)$'
SHA_RE='^[0-9a-f]{40}$'
# The whole request, before it is split: words of the characters the verbs, envs and
# SHAs use, joined by single spaces. A shell metacharacter, a tab, a newline, a
# doubled, leading or trailing space is rejected outright.
COMMAND_RE='^[a-z0-9-]+( [a-z0-9-]+)*$'
COMMAND_MAX=200

TAG=ds-deploy-entrypoint
request=${SSH_ORIGINAL_COMMAND-}

# Printable, length-capped copy of the request for the log line.
sanitised() { printf '%s' "$request" | LC_ALL=C tr -c '[:alnum:] ._/=-' '?' | head -c 120; }

reject() {
  logger -t "$TAG" -p auth.warning "rejected: $(sanitised)" || true
  printf '%s: rejected: %s\n' "$TAG" "$1" >&2
  exit 2
}
refuse() {
  printf '%s: %s\n' "$TAG" "$1" >&2
  exit 3
}
accepted() { logger -t "$TAG" -p auth.info "accepted: $(sanitised)" || true; }

[[ -n $request ]] || reject "no command (this key runs only the allowlisted deploy commands)"
[[ ${#request} -le $COMMAND_MAX && $request =~ $COMMAND_RE ]] ||
  reject "unexpected characters in the command"

IFS=' ' read -r -a words <<<"$request"
verb=${words[0]-}

check_env() { [[ $1 =~ $ENV_RE ]] || reject "bad env (want prod, stage-main or stage-pr-<N>)"; }
check_sha() { [[ $1 =~ $SHA_RE ]] || reject "bad sha (want the full 40-hex commit id)"; }

# Validates AND extracts in one python3 `tarfile` pass (python3 is on every box:
# ds-release needs it), never from a parsed `tar -tv` listing, whose columns shift
# with an owner name holding spaces. argv: archive dest max_unpacked max_entries
# min_free_margin. Exit 0 extracted · 2 over a cap · 3 unsafe or unreadable (the
# reason on stdout, nothing extracted).
read -r -d '' EXTRACT_PY <<'PY' || true
import os, shutil, sys, tarfile
archive, dest = sys.argv[1], sys.argv[2]
max_unpacked, max_entries, margin = (int(v) for v in sys.argv[3:6])

def stop(code, reason):
    print(reason)
    sys.exit(code)

root = os.path.realpath(dest)
members = []
total = 0
try:
    # "r:" = uncompressed only: gzip/bz2/xz are refused, so the stream cap also
    # bounds what is unpacked. Headers are read one at a time, so the entry cap
    # stops a header flood before it is all parsed.
    tar = tarfile.open(archive, mode="r:")
    for m in tar:
        if len(members) >= max_entries:
            stop(2, f"the report holds more than {max_entries} entries")
        if not (m.isreg() or m.isdir()):
            stop(3, "the report holds a link or special file")
        name = m.name
        if name.startswith("/") or ".." in name.split("/"):
            stop(3, "the report holds an absolute or .. path")
        target = os.path.realpath(os.path.join(root, name))
        if target != root and not target.startswith(root + os.sep):
            stop(3, "the report holds a path outside its directory")
        if m.isreg() and target == root:
            stop(3, "the report holds a file in place of its directory")
        total += m.size
        if total > max_unpacked:
            stop(2, f"the report unpacks to more than {max_unpacked} bytes")
        members.append(m)
except (tarfile.TarError, EOFError, OSError):
    stop(3, "the report is not a readable tar stream")
os.makedirs(os.path.dirname(root), exist_ok=True)
if shutil.disk_usage(os.path.dirname(root)).free < total + margin:
    stop(3, "not enough free space on the reports filesystem")
os.makedirs(root, mode=0o700, exist_ok=True)
# Owner and mode come from us, never from the archive.
for m in members:
    m.uid = m.gid = 0
    m.uname = m.gname = "root"
    m.mode = 0o700 if m.isdir() else 0o600
# A status line, never a traceback: the client's stderr is a public Actions log.
try:
    if hasattr(tarfile, "data_filter"):
        tar.extractall(root, members=members, filter="data")
    else:
        tar.extractall(root, members=members)
except Exception:
    stop(3, "the report could not be extracted")
PY

# The named read-only observations of `observe` (Issue #3119). argv: name env_file
# pat_file max_params_bytes idp_origin_override; stdin: the JSON parameters. Exit
# 0 = the observation on stdout · 2 = an unknown name or bad parameters · 3 = the
# box cannot serve it · 1 = the read failed. A failure prints one fixed short
# reason, never a diagnostic: the client's stderr is a public Actions log.
read -r -d '' OBSERVE_PY <<'PY' || true
import json, re, subprocess, sys, urllib.request

name, env_file, pat_file, max_params, idp_override = sys.argv[1:6]
CONTAINER = "stg-infra-postgres-1"
DATABASE = "ds_main"

def stop(code, reason):
    sys.stdout.write(reason + "\n")
    sys.exit(code)

UUID = "[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}"
def owned(prefix):
    return re.compile("(?:" + prefix + ")-" + UUID + "@example\\.test")
SUBJECT = re.compile("[1-9][0-9]{0,39}")
PHONE = re.compile("\\+1999[0-9]{8}")
DOMAIN = re.compile("[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+")

# Each check returns the psql variable's value, or None for a bad parameter.
def text(pattern):
    return lambda v: v if isinstance(v, str) and pattern.fullmatch(v) else None
def literal(expected):
    return lambda v: v if v == expected else None
def optional_uuid(v):
    if v is None:
        return ""
    return v if isinstance(v, str) and re.fullmatch(UUID, v) else None
def phone_array(v):
    if (isinstance(v, list) and 1 <= len(v) <= 2
            and all(isinstance(p, str) and PHONE.fullmatch(p) for p in v)
            and len(set(v)) == len(v)):
        return "{" + ",".join(v) + "}"
    return None

# name -> (parameter -> (psql variable, check), SELECT, output). A SELECT reads
# psql variables only (`:'var'`, quoted by psql). `envelope` prints {database,
# readOnly, rows}; `count` prints rows[0].count. One entry per stage read of
# packages/e2e/lib/{owned-auth-observation,owned-congress-observation,
# wrong-verification-observation,consent-refusal,password-policy}.ts.
OBSERVATIONS = {
    "academy-host": ({}, None, "host"),
    "password-policy": ({}, None, "policy"),
    "mirror-count": (
        {"email": ("email", text(owned("register-2704")))},
        "SELECT count(*)::int AS count FROM users WHERE email = :'email'",
        "count",
    ),
    "auth-consent": (
        {"email": ("email", text(owned("consent-2856"))),
         "subject": ("subject", text(SUBJECT)),
         "profileId": ("profile_id", optional_uuid)},
        "SELECT u.id AS profile_id, u.email = :'email' AS email_matches,"
        " u.zitadel_sub = :'subject' AS subject_matches, u.email_verified,"
        " u.phone IS NULL AS phone_absent, u.phone_verified,"
        " u.display_name IS NULL AS display_name_absent, c.id AS consent_id, c.purpose,"
        " c.version, c.captured_at::text AS captured_at, c.origin"
        " FROM users u JOIN consent_records c ON c.user_id = u.id"
        " WHERE u.email = :'email' AND u.zitadel_sub = :'subject'"
        " AND (NULLIF(:'profile_id', '') IS NULL OR u.id = NULLIF(:'profile_id', '')::uuid)"
        " ORDER BY c.id",
        "envelope",
    ),
    "phone-account-count": (
        {"phones": ("phones", phone_array)},
        "SELECT count(*)::text AS count FROM users WHERE phone = ANY(:'phones'::text[])",
        "envelope",
    ),
    "congress-snapshot": (
        {"email": ("email", text(owned("congress-registration-2927"))),
         "displayName": ("display_name", literal("Иванова Мария"))},
        """SELECT u.id AS "userId", u.zitadel_sub AS subject,
  u.email_verified AS "emailVerified", u.display_name = :'display_name' AS "displayNameMatches",
  md5((to_jsonb(u) - 'email_verified' - 'updated_at')::text) AS "profileFingerprint",
  (SELECT count(*)::int FROM registrations r WHERE r.user_id = u.id) AS "registrationCount",
  (SELECT bool_and(r.account_created_by_intake AND r.intake_origin = 'site') FROM registrations r WHERE r.user_id = u.id) AS "createdByIntake",
  (SELECT md5(string_agg((to_jsonb(r) - 'confirmation_mail_status' - 'confirmation_mail_at')::text, '' ORDER BY r.id)) FROM registrations r WHERE r.user_id = u.id) AS "registrationFingerprint",
  coalesce((SELECT jsonb_agg(jsonb_build_object('id', c.id, 'purpose', c.purpose,
    'version', c.version, 'capturedAt', c.captured_at::text, 'origin', c.origin) ORDER BY c.id)
    FROM consent_records c WHERE c.user_id = u.id), '[]'::jsonb) AS consents
  FROM users u WHERE u.email = :'email'""",
        "envelope",
    ),
    "wrong-verification": (
        {"email": ("email", text(owned("wrong-2928-(?:verified|unverified|unknown)")))},
        """SELECT
  (SELECT count(*)::int FROM users WHERE email = :'email') AS users,
  (SELECT coalesce(bool_and(email_verified), false) FROM users WHERE email = :'email') AS verified,
  (SELECT count(*)::int FROM consent_records c JOIN users u ON u.id = c.user_id WHERE u.email = :'email') AS consents,
  (SELECT md5(coalesce(jsonb_agg(to_jsonb(u) ORDER BY u.id)::text, '[]')) FROM users u WHERE u.email = :'email') AS user_digest,
  (SELECT md5(coalesce(jsonb_agg(to_jsonb(c) ORDER BY c.id)::text, '[]')) FROM consent_records c JOIN users u ON u.id = c.user_id WHERE u.email = :'email') AS consent_digest""",
        "envelope",
    ),
}

if name not in OBSERVATIONS:
    stop(2, "unknown observation")
schema, select, output = OBSERVATIONS[name]

raw = sys.stdin.buffer.read(int(max_params) + 1)
if len(raw) > int(max_params):
    stop(2, "the parameters exceed " + max_params + " bytes")
try:
    params = json.loads(raw.decode("utf-8")) if raw.strip() else {}
except ValueError:
    stop(2, "the parameters are not one JSON object")
if not isinstance(params, dict) or set(params) != set(schema):
    stop(2, "bad parameters for " + name)
variables = []
for key, (var, check) in schema.items():
    value = check(params[key])
    if value is None:
        stop(2, "bad parameters for " + name)
    variables += ["-v", var + "=" + value]

def stage_env():
    env = {}
    try:
        with open(env_file, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except (OSError, ValueError):
        stop(3, "the stage env is not readable")
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export "):].strip()
        key, eq, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if not eq or not re.fullmatch("[A-Za-z_][A-Za-z0-9_]*", key):
            continue
        if len(value) >= 2 and value[0] in "\"'" and value[-1] == value[0]:
            value = value[1:-1]
        env[key] = value
    domain = env.get("STAGE_BASE_DOMAIN", "")
    if not DOMAIN.fullmatch(domain):
        stop(3, "the stage env names no base domain")
    return env, domain

def emit(value):
    sys.stdout.write(json.dumps(value, separators=(",", ":")) + "\n")
    sys.exit(0)

if output == "host":
    emit({"academy": "academy-main." + stage_env()[1]})

if output == "policy":
    env, domain = stage_env()
    # The resolution of tools/staging/slot.mjs resolveIdpBaseUrl.
    base = env.get("IDP_BASE_URL", "").strip().rstrip("/")
    if not base and env.get("IDP_EXTERNAL_DOMAIN", "").strip():
        secure = env.get("IDP_EXTERNAL_SECURE", "").strip().lower() in ("true", "1")
        port = env.get("IDP_EXTERNAL_PORT", "").strip()
        suffix = ":" + port if port and port != ("443" if secure else "80") else ""
        base = ("https" if secure else "http") + "://" + env["IDP_EXTERNAL_DOMAIN"].strip() + suffix
    if base != "https://id." + domain:
        stop(3, "the stage IdP origin is not https://id.<base domain>")
    try:
        with open(pat_file, encoding="utf-8") as f:
            pat = f.read().strip()
    except (OSError, ValueError):
        stop(3, "the IdP token is not readable")
    request = urllib.request.Request(
        (idp_override or base) + "/admin/v1/policies/password/complexity",
        headers={"Authorization": "Bearer " + pat, "Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            policy = json.loads(response.read(65536).decode("utf-8")).get("policy")
    except Exception:
        stop(1, "the IdP read failed")
    if not isinstance(policy, dict):
        stop(1, "the IdP read failed")
    keys = ("minLength", "hasUppercase", "hasLowercase", "hasNumber", "hasSymbol")
    emit({"policy": {k: policy[k] for k in keys if k in policy}})

sql = (
    "BEGIN READ ONLY;\n"
    "SET LOCAL statement_timeout = '5s';\n"
    "SET LOCAL timezone = 'UTC';\n"
    "SELECT json_build_object('database', current_database(), 'readOnly',"
    " current_setting('transaction_read_only') = 'on', 'rows', CASE WHEN current_database() = '"
    + DATABASE + "' AND current_setting('transaction_read_only') = 'on' THEN"
    " (SELECT coalesce(json_agg(row_to_json(binding)), '[]'::json) FROM (\n"
    + select + "\n) binding) ELSE NULL END);\n"
    "ROLLBACK;\n"
)
try:
    done = subprocess.run(
        ["docker", "exec", "-i", "-e", "PGCLIENTENCODING=UTF8", CONTAINER, "psql", "-X", "-qAt",
         "-U", "ds", "-d", DATABASE, "-v", "ON_ERROR_STOP=1", *variables, "-f", "-"],
        input=sql.encode("utf-8"), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=20,
    )
except (OSError, subprocess.TimeoutExpired):
    stop(1, "the observation read failed")
if done.returncode != 0:
    stop(1, "the observation read failed")
try:
    envelope = json.loads(done.stdout.decode("utf-8"))
except ValueError:
    stop(1, "the observation read failed")
if (not isinstance(envelope, dict) or set(envelope) != {"database", "readOnly", "rows"}
        or envelope["database"] != DATABASE or envelope["readOnly"] is not True
        or not isinstance(envelope["rows"], list)):
    stop(1, "the observation did not read the main slot read-only")
if output == "count":
    rows = envelope["rows"]
    count = rows[0].get("count") if len(rows) == 1 and isinstance(rows[0], dict) else None
    if type(count) is not int or count < 0:
        stop(1, "the observation read failed")
    sys.stdout.write(str(count) + "\n")
    sys.exit(0)
emit(envelope)
PY

# observe: one named observation of the stage `main` slot (Issue #3119). The
# parameters (one JSON object, at most MAX_OBSERVE_PARAMS_BYTES) reach OBSERVE_PY on
# stdin; only its stdout or its one fixed reason reaches the client.
observe() {
  local name=$1 role out rc
  role=$(sudo cat "$BOX_ROLE_FILE" 2>/dev/null || true)
  [[ $role == stage ]] || refuse "observe is served by the stage box only"
  rc=0
  out=$(head -c "$((MAX_OBSERVE_PARAMS_BYTES + 1))" |
    sudo python3 -I -X utf8 -c "$OBSERVE_PY" "$name" "$STAGE_ENV_FILE" "$IDP_PAT_FILE" \
      "$MAX_OBSERVE_PARAMS_BYTES" "$OBSERVE_IDP_ORIGIN") || rc=$?
  case $rc in
    0) printf '%s\n' "$out" ;;
    2) reject "${out:-bad observation parameters}" ;;
    3) refuse "${out:-the box cannot serve this observation}" ;;
    *)
      printf '%s: %s\n' "$TAG" "${out:-the observation failed}" >&2
      exit 1
      ;;
  esac
}

upload_report() {
  local sha=$1 role dest size reason rc
  role=$(sudo cat "$BOX_ROLE_FILE" 2>/dev/null || true)
  [[ $role == stage ]] || refuse "upload-report is served by the stage box only"

  # The stream lands root-only beside the reports (same filesystem, never /tmp), and
  # at most one byte past the cap is read, so a stream cannot fill the disk.
  sudo install -d -m 0700 -o root -g root "$REPORTS_ROOT"
  archive=$(sudo mktemp -p "$REPORTS_PARENT" .e2e-report-upload.XXXXXX) # global: the EXIT trap outlives this function
  trap 'sudo rm -f -- "${archive:-}"' EXIT
  head -c "$((MAX_REPORT_BYTES + 1))" | sudo tee -- "$archive" >/dev/null
  size=$(sudo stat -c %s -- "$archive")
  ((size <= MAX_REPORT_BYTES)) || reject "the report stream exceeds $MAX_REPORT_BYTES bytes"

  dest=$REPORTS_ROOT/$sha
  sudo rm -rf -- "$dest"
  rc=0
  reason=$(sudo python3 -I -c "$EXTRACT_PY" "$archive" "$dest" \
    "$MAX_REPORT_UNPACKED_BYTES" "$MAX_REPORT_ENTRIES" "$REPORT_FREE_MARGIN_BYTES") || rc=$?
  if ((rc != 0)); then
    sudo rm -rf -- "$dest"
    ((rc == 2)) && reject "$reason"
    refuse "${reason:-the report could not be extracted}"
  fi
  # Retention: the next upload removes reports older than the window. python sets
  # each member's mtime from the archive, so the dir itself is touched to now.
  sudo touch -- "$dest"
  sudo find "$REPORTS_ROOT" -mindepth 1 -maxdepth 1 -type d -mtime "+$REPORT_RETENTION_DAYS" \
    -exec rm -rf -- {} +
  printf '%s: report %s stored\n' "$TAG" "$sha"
}

# status: ds-release's one JSON line with the release driver's unit added as
# `driver` (#2985): {"release", "unitAlive", "driver": {"unit", "active", "rc",
# "previousSha", "failure"}} — `previousSha` (#3157) is the SHA prod ran before <sha>,
# the release-notes basis, or null; `failure` (#3439) is null or the {"phase",
# "reason"} note of a failed unit run, and may be absent (an older driver; the no-driver
# fallback below), which reads as none. Without an installed driver there is no driver
# unit: `absent`.
release_status() {
  local env=$1 sha=$2 line driver
  line=$(sudo "$DS_RELEASE" status "$env" "$sha")
  [[ $line == '{"release":'*'}' ]] || { printf '%s\n' "$line"; exit 1; }
  if [[ -x $RELEASE_DRIVER ]]; then
    driver=$("$RELEASE_DRIVER" unit-state "$env" "$sha")
  else
    driver=$(printf '{"unit":"ds-%s-%s-driver","active":"absent","rc":null,"previousSha":null}' "$env" "${sha:0:12}")
  fi
  [[ $driver == '{"unit":'*'}' ]] || refuse "the release driver reported no unit state"
  printf '%s,"driver":%s}\n' "${line%\}}" "$driver"
}

# --- data-prod verbs (Issue #3313; spec §5 «Data-prod verbs.») ---------------------
# The hop key from ds-api-prod reaches these on the box whose role is `data` only.
# Every script is fixed here or in an installed root-owned file; a payload is one
# JSON object checked field by field by DATA_PY below, or the tree archive.
# infra/deploy/bin/harden-ssh.sh --role data refuses an installed entrypoint without
# this line; tools/deploy/lib/data-prod.mjs and the tests pin the list.
DATA_VERBS='capabilities postgres-probe postgres-checkpoint ship install data-env data-up backup backup-info rollback-floor finish check supersede converge read-schema read-observe rehearse rehearsal-status recovery-bundle recovery-check recovery-put recovery-latest'
DATA_LIVE_TREE=$ROOT/home/deploy/ds-platform
DATA_COMPOSE=$DATA_LIVE_TREE/infra/deploy/compose/data-prod
DATA_STATE_FILE=$ROOT/home/deploy/ds-platform-postgres-state.json
# GlitchTip's secrets (#3395): root 0600, outside the shipped tree, so every ship keeps
# it; data-prod/glitchtip/compose.yml reads it as its env_file.
GLITCHTIP_ENV=$ROOT/etc/ds-platform/glitchtip.env
POSTGRES_PROBE=$ROOT/usr/local/lib/ds-platform/postgres-artifact-probe.py
HARDEN_SSH=$ROOT/usr/local/lib/ds-platform/harden-ssh.sh
# #3662: the key custody's box side and the custodians of the shipped tree.
DS_RECOVERY=$ROOT/usr/local/lib/ds-platform/ds-recovery
[[ -z $ROOT ]] || export DS_RECOVERY_ROOT=$ROOT
RECOVERY_CUSTODIANS=$DATA_LIVE_TREE/infra/deploy/recovery/custodians.txt
RECOVERY_STAMP_RE='^[0-9]{8}t[0-9]{6}z$'
# Box entrypoint = its path in the shipped tree; tools/deploy/lib/remote.mjs
# DATA_BOX_ENTRYPOINTS, pinned equal by the tests. ds-read-entrypoint is served by
# ds-api-prod only (spec §5 «Prod read verbs.»), so this box does not install it.
DATA_INSTALL=(
  /usr/local/bin/ds-release=infra/deploy/bin/ds-release
  /usr/local/bin/ds-deploy-entrypoint=infra/deploy/bin/ds-deploy-entrypoint
  /usr/local/lib/ds-platform/release-driver=infra/deploy/bin/release-driver
  /usr/local/lib/ds-platform/postgres-artifact-probe.py=tools/deploy/postgres-artifact-probe.py
  /usr/local/lib/ds-platform/harden-ssh.sh=infra/deploy/bin/harden-ssh.sh
  /usr/local/lib/ds-platform/ds-recovery=infra/deploy/bin/ds-recovery
  /usr/local/lib/ds-platform/rehearse-migration.py=infra/deploy/bin/rehearse-migration.py
  /usr/local/lib/ds-platform/rehearse-cleanup=infra/deploy/bin/rehearse-cleanup
  /etc/tmpfiles.d/ds-rehearsal.conf=infra/deploy/tmpfiles.d/ds-rehearsal.conf
)
MAX_DATA_PAYLOAD_BYTES=65536
MAX_SHIP_BYTES=$(override DS_ENTRYPOINT_MAX_SHIP_BYTES $((256 * 1024 * 1024)))                      # 256 MiB gzip stream
MAX_SHIP_UNPACKED_BYTES=$(override DS_ENTRYPOINT_MAX_SHIP_UNPACKED_BYTES $((2 * 1024 * 1024 * 1024))) # 2 GiB unpacked
MAX_SHIP_ENTRIES=$(override DS_ENTRYPOINT_MAX_SHIP_ENTRIES 100000)
[[ $MAX_SHIP_BYTES =~ ^[0-9]+$ && $MAX_SHIP_UNPACKED_BYTES =~ ^[0-9]+$ && $MAX_SHIP_ENTRIES =~ ^[0-9]+$ ]] ||
  { echo "ds-deploy-entrypoint: bad cap override" >&2; exit 2; }
ROLLBACK_UNIT_RE='^ds-prod-[0-9a-f]{12}-rollback$'

# argv: action, then the action's paths; stdin: the payload. Exit 0 done (the
# result on stdout) · 2 a bad payload · 3 unsafe or unreadable (one fixed reason on
# stdout, nothing written).
read -r -d '' DATA_PY <<'PY' || true
import base64, ipaddress, json, os, re, shutil, sys, tarfile, tempfile

action = sys.argv[1]

def stop(code, reason):
    sys.stdout.write(reason + "\n")
    sys.exit(code)

IMAGE_ID = re.compile("sha256:[0-9a-f]{64}")
IMAGE_REF = re.compile("[a-z0-9][a-z0-9./:_-]{1,254}")
HEX64 = re.compile("[0-9a-f]{64}")
SYSTEM_ID = re.compile("[0-9]{15,20}")
ABS_PATH = re.compile("(/[A-Za-z0-9_.-]+)+")
REL_PATH = re.compile("[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*")
ENV_NAME = re.compile("[A-Za-z_][A-Za-z0-9_]{0,127}")
ROLES = ("postgres", "pgbackrest")

def payload(keys, optional=()):
    raw = sys.stdin.buffer.read(65537)
    if len(raw) > 65536:
        stop(2, "the payload exceeds 65536 bytes")
    try:
        value = json.loads(raw.decode("utf-8"))
    except ValueError:
        stop(2, "the payload is not one JSON object")
    if not isinstance(value, dict) or not set(keys) <= set(value) <= set(keys) | set(optional):
        stop(2, "bad payload for " + action)
    return value

def check(ok):
    if not ok:
        stop(2, "bad payload for " + action)

def images(value, pattern):
    check(isinstance(value, dict) and set(value) == set(ROLES)
          and all(isinstance(value[r], str) and pattern.fullmatch(value[r]) for r in ROLES))
    return {r: value[r] for r in ROLES}

def scalar(v):
    return v is None or isinstance(v, (bool, int, float)) or (
        isinstance(v, str) and len(v) <= 4096 and v.isprintable())

def write(path, text):
    # Whole or not at all: a temp file beside it (0600), then one rename.
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".ds-entrypoint.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    except OSError:
        os.unlink(tmp)
        stop(3, "the file could not be written")

if action == "postgres-probe":
    # Only the fields the probe reads reach it, each checked; anything else is refused.
    req = payload(("target", "preferRecordedImages", "paths"), ("sourceHash",))
    t = req["target"]
    check(isinstance(t, dict))
    for key in ("mount", "sidecarMount"):
        check(isinstance(t.get(key), dict) and isinstance(t[key].get("target"), str)
              and ABS_PATH.fullmatch(t[key]["target"]) is not None)
    env = t.get("environment")
    check(isinstance(env, dict) and set(env) == set(ROLES) and all(
        isinstance(env[r], dict) and len(env[r]) <= 64
        and all(isinstance(k, str) and ENV_NAME.fullmatch(k) and scalar(v) for k, v in env[r].items())
        for r in ROLES))
    paths = req["paths"]
    check(isinstance(paths, list) and len(paths) <= 256 and all(
        isinstance(p, str) and REL_PATH.fullmatch(p) and ".." not in p.split("/") for p in paths))
    check(isinstance(req["preferRecordedImages"], bool))
    check("sourceHash" not in req or (isinstance(req["sourceHash"], str) and HEX64.fullmatch(req["sourceHash"])))
    clean = {
        "target": {"mount": {"target": t["mount"]["target"]},
                   "sidecarMount": {"target": t["sidecarMount"]["target"]},
                   "images": images(t.get("images"), IMAGE_REF),
                   "environment": {r: env[r] for r in ROLES}},
        "preferRecordedImages": req["preferRecordedImages"],
        "paths": paths,
    }
    if "sourceHash" in req:
        clean["sourceHash"] = req["sourceHash"]
    sys.stdout.write(base64.b64encode(json.dumps(clean).encode()).decode() + "\n")
    sys.exit(0)

if action == "postgres-checkpoint":
    state_file = sys.argv[2]
    # #3419: hashVersion 2 marks a v2 source hash; absent = a v1 record (postgres-guard.mjs).
    rec = payload(("schema", "sourceHash", "systemId", "images"), ("hashVersion",))
    check(type(rec["schema"]) is int and rec["schema"] == 1)
    check("hashVersion" not in rec or (type(rec["hashVersion"]) is int and rec["hashVersion"] == 2))
    check(isinstance(rec["sourceHash"], str) and HEX64.fullmatch(rec["sourceHash"]) is not None)
    check(isinstance(rec["systemId"], str) and SYSTEM_ID.fullmatch(rec["systemId"]) is not None)
    state = {"schema": 1, **({"hashVersion": 2} if "hashVersion" in rec else {}),
             "sourceHash": rec["sourceHash"], "systemId": rec["systemId"],
             "images": images(rec["images"], IMAGE_ID)}
    write(state_file, json.dumps(state, separators=(",", ":")) + "\n")
    # #3466: the box answers the record it wrote — the release journal's only view of it.
    sys.stdout.write("PostgreSQL checkpoint written\nrecord: "
                     + ("hashVersion 2" if state.get("hashVersion") == 2 else "v1 (no hashVersion)") + "\n")
    sys.exit(0)

if action == "data-env":
    compose = sys.argv[2]
    req = payload(("vpcIp", "images"))
    try:
        check(isinstance(req["vpcIp"], str) and str(ipaddress.IPv4Address(req["vpcIp"])) == req["vpcIp"])
    except ValueError:
        check(False)
    ids = images(req["images"], IMAGE_ID)
    if not os.path.isdir(compose):
        stop(3, "the data-prod compose directory is missing (ship first)")
    write(os.path.join(compose, ".env"), "VPC_IP=" + req["vpcIp"] + "\n")
    write(os.path.join(compose, ".postgres-artifacts.json"),
          json.dumps({"services": {r: {"image": ids[r]} for r in ROLES}}) + "\n")
    sys.stdout.write("data-prod compose env written\n")
    sys.exit(0)

if action == "ship":
    # argv: archive dest max_unpacked max_entries. The tree's one top directory is
    # stripped; the members are checked like an upload-report, except that a symlink
    # that resolves inside the tree is kept (the tree carries one).
    archive, dest = sys.argv[2], sys.argv[3]
    max_unpacked, max_entries = int(sys.argv[4]), int(sys.argv[5])
    members, total = [], 0
    try:
        tar = tarfile.open(archive, mode="r:gz")
        for m in tar:
            if len(members) >= max_entries:
                stop(2, f"the tree holds more than {max_entries} entries")
            parts = m.name.split("/")
            if m.name.startswith("/") or ".." in parts:
                stop(3, "the tree holds an absolute or .. path")
            rest = [p for p in parts[1:] if p not in ("", ".")]
            if not rest:
                continue
            if m.issym():
                link = os.path.normpath(os.path.join(*rest[:-1], m.linkname)) if len(rest) > 1 else os.path.normpath(m.linkname)
                if m.linkname.startswith("/") or link == ".." or link.startswith("../"):
                    stop(3, "the tree holds a link outside it")
            elif not (m.isreg() or m.isdir()):
                stop(3, "the tree holds a hard link or special file")
            m.name = "/".join(rest)
            total += m.size
            if total > max_unpacked:
                stop(2, f"the tree unpacks to more than {max_unpacked} bytes")
            members.append(m)
    except (tarfile.TarError, EOFError, OSError):
        stop(3, "the tree is not a readable gzip tar stream")
    # Owner from us, never from the archive; nobody but root may write the tree.
    for m in members:
        m.uid = m.gid = 0
        m.uname = m.gname = "root"
        m.mode &= 0o755
    try:
        os.makedirs(dest, mode=0o755)
        if hasattr(tarfile, "data_filter"):
            tar.extractall(dest, members=members, filter="data")
        else:
            tar.extractall(dest, members=members)
    except Exception:
        shutil.rmtree(dest, ignore_errors=True)
        stop(3, "the tree could not be extracted")
    sys.exit(0)

stop(2, "unknown data action")
PY

require_data_box() {
  local role
  role=$(sudo cat "$BOX_ROLE_FILE" 2>/dev/null || true)
  [[ $role == data ]] || refuse "$verb is served by the data box only"
}

# One DATA_PY action with the client's stdin capped; its stdout is the result.
data_py() {
  local out rc=0
  out=$(head -c "$((MAX_DATA_PAYLOAD_BYTES + 1))" | sudo python3 -I -X utf8 -c "$DATA_PY" "$@") || rc=$?
  case $rc in
    0) printf '%s\n' "$out" ;;
    2) reject "${out:-bad payload}" ;;
    *) refuse "${out:-the payload could not be applied}" ;;
  esac
}

ship_tree() {
  local sha=$1 parent size reason rc
  parent=$(dirname "$DATA_LIVE_TREE")
  # Beside the live tree (one filesystem: the swap is a rename), never /tmp.
  ship_work=$(sudo mktemp -d -p "$parent" .ds-platform.ship.XXXXXX) # global: the EXIT trap outlives this function
  trap 'sudo rm -rf -- "${ship_work:-}"' EXIT
  head -c "$((MAX_SHIP_BYTES + 1))" | sudo tee -- "$ship_work/tree.tar.gz" >/dev/null
  size=$(sudo stat -c %s -- "$ship_work/tree.tar.gz")
  ((size <= MAX_SHIP_BYTES)) || reject "the tree stream exceeds $MAX_SHIP_BYTES bytes"
  rc=0
  reason=$(sudo python3 -I -X utf8 -c "$DATA_PY" ship "$ship_work/tree.tar.gz" "$ship_work/stage" \
    "$MAX_SHIP_UNPACKED_BYTES" "$MAX_SHIP_ENTRIES") || rc=$?
  if ((rc != 0)); then
    ((rc == 2)) && reject "$reason"
    refuse "${reason:-the tree could not be extracted}"
  fi
  if sudo test -e "$DATA_LIVE_TREE"; then sudo mv -- "$DATA_LIVE_TREE" "$ship_work/previous"; fi
  if ! sudo mv -- "$ship_work/stage" "$DATA_LIVE_TREE"; then
    if ! sudo mv -- "$ship_work/previous" "$DATA_LIVE_TREE"; then
      printf '%s: EMERGENCY: the previous tree remains at %s\n' "$TAG" "$ship_work/previous" >&2
      ship_work= # the previous tree stays for the operator
    fi
    refuse "the tree could not be swapped in"
  fi
  printf '%s: tree %s shipped\n' "$TAG" "$sha"
}

install_entrypoints() {
  local sha=$1 pair mode
  for pair in "${DATA_INSTALL[@]}"; do
    sudo test -f "$DATA_LIVE_TREE/${pair#*=}" || refuse "the shipped tree has no ${pair#*=} (ship first)"
  done
  sudo install -d -m 0755 -o root -g root "$ROOT/usr/local/lib/ds-platform" "$ROOT/etc/tmpfiles.d"
  # `install` replaces each file by a new inode, so this running script keeps its own.
  # A program 0755; a configuration file under /etc (the tmpfiles.d entry) 0644.
  for pair in "${DATA_INSTALL[@]}"; do
    mode=0755
    [[ ${pair%%=*} == /etc/* ]] && mode=0644
    sudo install -m "$mode" -o root -g root -- "$DATA_LIVE_TREE/${pair#*=}" "$ROOT${pair%%=*}"
  done
  printf '%s: box entrypoints of %s installed\n' "$TAG" "$sha"
}

# #3395: one `log bound:` line per container of both data-prod compose projects
# (ds-data-prod + ds-glitchtip): its name and json-log bound, never its env. Printed
# by postgres-checkpoint, the verb that closes the release's data-prod-up phase on
# every run — the durable `up` unit's own output stays in its journal. Evidence only:
# it lists by the compose project label (no compose file, no .env — the pre-ship
# checkpoint runs on whatever tree is live) and never fails the verb; any error is
# one `log bounds: unavailable — <reason>` line.
DATA_PROJECTS='ds-data-prod ds-glitchtip'
data_log_bounds() {
  local project ids='' out
  for project in $DATA_PROJECTS; do
    if ! out=$(sudo docker ps -aq --filter "label=com.docker.compose.project=$project" 2>&1); then
      bounds_unavailable "$out"; return 0
    fi
    ids+="$out"$'\n'
  done
  [[ -n ${ids//[[:space:]]/} ]] || { bounds_unavailable "no data-prod containers"; return 0; }
  # shellcheck disable=SC2086 # one id per word
  if ! out=$(sudo docker inspect --format \
    '{{.Name}} log={{.HostConfig.LogConfig.Type}} max-size={{index .HostConfig.LogConfig.Config "max-size"}} max-file={{index .HostConfig.LogConfig.Config "max-file"}}' \
    $ids 2>&1); then
    bounds_unavailable "$out"; return 0
  fi
  printf '%s\n' "$out" | sed 's/^/log bound: /'
}
# The first line of the error, printable and capped.
bounds_unavailable() {
  local reason=${1%%$'\n'*}
  reason=${reason//[^[:print:]]/}
  printf 'log bounds: unavailable — %s\n' "${reason:0:200}"
}

# The durable step units of data-prod: the step script is fixed here; ds-release
# copies it root-only and runs it in ds-prod-<sha12>-<step>.
data_step() {
  local step=$1 sha=$2 retry=$3 script
  case $step in
    up)
      # #3395: GlitchTip is raised from the shipped tree with the persistence plane,
      # so a changed glitchtip/compose.yml reaches its containers every release. Its
      # secrets file is checked before the unit starts, so a box without it refuses
      # before any `up`; the file is named, its contents never read here.
      sudo test -f "$GLITCHTIP_ENV" && sudo test -r "$GLITCHTIP_ENV" ||
        refuse "$GLITCHTIP_ENV is absent or unreadable; GlitchTip cannot start without it (deploy README → GlitchTip)"
      # The `.env` data-env wrote supplies VPC_IP (a hand-made glitchtip/.env does not
      # survive a ship). 300 s covers web's whole health window: start_period 90 s +
      # 5 retries x 30 s interval, after valkey turns healthy — a version bump migrates
      # before the port opens.
      script="cd '$DATA_COMPOSE'
docker compose -f compose.yml -f .postgres-artifacts.json up -d --no-build --pull never --wait --wait-timeout 120 postgres pgbackrest
docker compose up -d --no-deps redis
docker compose -f glitchtip/compose.yml --env-file .env up -d --no-build --pull missing --wait --wait-timeout 300"
      ;;
    backup)
      script="cd '$DATA_COMPOSE'
docker compose exec -T pgbackrest /usr/local/bin/backup.sh incr"
      ;;
  esac
  step_file=$(sudo mktemp) # global: the EXIT trap outlives this function
  trap 'sudo rm -f -- "${step_file:-}"' EXIT
  printf '%s\n' "$script" | sudo tee -- "$step_file" >/dev/null
  sudo "$DS_RELEASE" release ${retry:+--retry-failed} prod "$sha" "$step" "$step_file"
}

# check | supersede [<rollback unit>]
release_lock_verb() {
  local name=$1 unit=${2-}
  if [[ -n $unit ]]; then
    sudo "$DS_RELEASE" "$name" --except "$unit" prod
  else
    sudo "$DS_RELEASE" "$name" prod
  fi
}

data_verb() {
  local n=${#words[@]}
  case "$verb" in
    capabilities | postgres-probe | postgres-checkpoint | data-env | backup-info | rollback-floor | read-schema |       recovery-bundle | recovery-check)
      ((n == 1)) || reject "usage: $verb" ;;
    recovery-put)
      [[ $n == 4 && ${words[1]} == api-prod && ${words[2]} =~ $RECOVERY_STAMP_RE && ${words[3]} =~ ^(bundle|manifest)$ ]] ||
        reject "usage: recovery-put api-prod <yyyymmddthhmmssz> bundle|manifest" ;;
    recovery-latest)
      [[ $n == 2 && ${words[1]} == api-prod ]] || reject "usage: recovery-latest api-prod" ;;
    read-observe)
      [[ $n == 2 && ${words[1]} =~ ^[a-z][a-z0-9-]{0,39}$ ]] || reject "usage: read-observe <name>" ;;
    ship | install | converge | rehearse | rehearsal-status)
      ((n == 2)) || reject "usage: $verb <sha>"
      check_sha "${words[1]}" ;;
    data-up | backup)
      ((n == 2)) || [[ $n == 3 && ${words[2]} == retry-failed ]] || reject "usage: $verb <sha> [retry-failed]"
      check_sha "${words[1]}" ;;
    finish)
      [[ $n == 3 && ${words[2]} =~ ^(succeeded|failed)$ ]] || reject "usage: finish <sha> succeeded|failed"
      check_sha "${words[1]}" ;;
    check | supersede)
      ((n == 1)) || [[ $n == 2 && ${words[1]} =~ $ROLLBACK_UNIT_RE ]] ||
        reject "usage: $verb [ds-prod-<sha12>-rollback]" ;;
  esac
  accepted
  require_data_box
  case "$verb" in
    capabilities)
      printf '{"role":"data","verbs":["%s"]}\n' "${DATA_VERBS// /\",\"}" ;;
    postgres-probe)
      local request
      request=$(data_py postgres-probe)
      sudo test -f "$POSTGRES_PROBE" || refuse "the PostgreSQL probe is not installed"
      # The probe reads the live tree and the checkpoint under deploy's home.
      exec sudo env HOME="$ROOT/home/deploy" python3 -I "$POSTGRES_PROBE" "$request" </dev/null ;;
    postgres-checkpoint)
      data_py postgres-checkpoint "$DATA_STATE_FILE"
      data_log_bounds </dev/null ;;
    data-env) data_py data-env "$DATA_COMPOSE" ;;
    ship) ship_tree "${words[1]}" ;;
    install) install_entrypoints "${words[1]}"; exit 0 ;;
    converge)
      # The release's converge of this box (#3320; spec §5 «Data-prod verbs.»), every
      # release: the box entrypoints of the shipped <sha> tree go in place first, so
      # the harden-ssh.sh it runs is this release's, root-owned; it is idempotent and
      # prints `nothing to change` once the box is converged. Its exit is the verb's.
      install_entrypoints "${words[1]}"
      # #3662: age for the key custody; never fatal here (the recovery verbs refuse).
      sudo "$DS_RECOVERY" install-age </dev/null || true
      exec sudo "$HARDEN_SSH" --role data --from-release </dev/null ;;
    data-up) data_step up "${words[1]}" "${words[2]-}" </dev/null ;;
    backup) data_step backup "${words[1]}" "${words[2]-}" </dev/null ;;
    backup-info)
      cd "$DATA_COMPOSE"
      sudo docker compose exec -T pgbackrest gosu postgres pgbackrest --stanza=ds info </dev/null | sed -n '1,20p' ;;
    rollback-floor)
      # The 0036 floor read of tools/deploy/rollback-floor.mjs. ON_ERROR_STOP: a
      # failed read is an exit, never empty output that reads like an answer.
      cd "$DATA_COMPOSE"
      sudo docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -qAt -U ds -d ds_prod -c \
        "SELECT CASE WHEN to_regclass('public.event_speakers') IS NULL THEN 'ABSENT' ELSE 'PRESENT' END" </dev/null ;;
    finish) exec sudo "$DS_RELEASE" finish prod "${words[1]}" "${words[2]}" </dev/null ;;
    check | supersede) release_lock_verb "$verb" "${words[1]-}" </dev/null ;;
    read-schema) read_schema </dev/null ;;
    read-observe) read_observe "${words[1]}" ;;
    rehearse) rehearse "${words[1]}" ;;
    rehearsal-status) rehearsal_status "${words[1]}" </dev/null ;;
    recovery-bundle) recovery_bundle </dev/null ;;
    recovery-check) recovery_check </dev/null ;;
    recovery-put) recovery_put "${words[2]}" "${words[3]}" ;;
    recovery-latest) recovery_latest </dev/null ;;
  esac
}

# --- the key custody (Issue #3662; spec §5 «Prod read verbs.») ----------------------
# Reached by ds-read-entrypoint's recovery-bundle / recovery-check over the hop.
# ds-data-prod bundles its own *.env and keeps every box's ciphertext and manifest in
# the pgBackRest bucket under recovery-bundle/<box>/; stdout carries status lines only
# (recovery-latest: the manifest, which holds keyed fingerprints and no value).
recovery_work() {
  [[ -x $DS_RECOVERY ]] || refuse "ds-recovery is not installed (the next release installs it)"
  recovery_dir=$(mktemp -d) # global: the EXIT trap outlives this function; root-only
  trap 'rm -rf -- "${recovery_dir:-}"' EXIT
}
recovery_bundle() {
  local stamp members
  recovery_work
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  members=$("$DS_RECOVERY" bundle data-prod "$RECOVERY_CUSTODIANS" "$recovery_dir" "$stamp")
  "$DS_RECOVERY" upload data-prod "$stamp" bundle "$recovery_dir/bundle.tar.age"
  "$DS_RECOVERY" upload data-prod "$stamp" manifest "$recovery_dir/manifest.json"
  printf 'data-prod STORED %s members %s
' "$stamp" "$members"
}
recovery_check() {
  local found
  recovery_work
  "$DS_RECOVERY" custodians "$RECOVERY_CUSTODIANS"
  found=$("$DS_RECOVERY" latest data-prod "$recovery_dir/latest.json")
  if [[ $found != FOUND ]]; then
    echo "data-prod MISSING"
    exit 1
  fi
  "$DS_RECOVERY" check data-prod "$RECOVERY_CUSTODIANS" "$recovery_dir/latest.json"
}
# recovery-put api-prod <stamp> bundle|manifest; stdin: the file, at most 1 MiB.
recovery_put() {
  local stamp=${1^^} kind=$2
  recovery_work
  head -c 1048577 >"$recovery_dir/$kind"
  "$DS_RECOVERY" upload api-prod "$stamp" "$kind" "$recovery_dir/$kind" </dev/null
}
recovery_latest() {
  local found
  recovery_work
  found=$("$DS_RECOVERY" latest api-prod "$recovery_dir/latest.json")
  if [[ $found == FOUND ]]; then cat -- "$recovery_dir/latest.json"; else echo MISSING; fi
}

# --- the prod read path (Issue #3646; spec §5 «Prod read verbs.») -------------------
# The fixed failure reasons of a read (exit 1); a reason from the data box outside
# this list reaches the client as `the read failed`.
READ_REASONS=(
  'a release step is running'
  'a rehearsal is running'
  'the read-only transaction check failed'
  'the read timed out'
  'insufficient headroom (disk)'
  'insufficient headroom (memory)'
  'copy behind prod'
  'archive check failed'
  'the read failed'
)
read_fail() {
  printf '%s: %s\n' "$TAG" "$1" >&2
  exit 1
}

# read-schema (data box): the plaintext schema answer of `schema`, which
# ds-read-entrypoint on ds-api-prod encrypts. argv: the data-prod compose dir. Exit 0 = the answer on
# stdout · 1 = one fixed reason of READ_REASONS on stdout · 3 = not servable. The
# catalogue SQL reads catalog relations only — no row data, no COMMENT text — and
# the dump text never leaves this script, only its sha256.
read -r -d '' READ_SCHEMA_PY <<'PY' || true
import hashlib, json, os, subprocess, sys, time
compose = sys.argv[1]
DATABASE = "ds_prod"

def stop(code, reason):
    sys.stdout.write(reason + "\n")
    sys.exit(code)

# Non-system schemas: not pg_catalog, information_schema, pg_toast*, pg_temp_*.
NS = ("n.nspname NOT IN ('pg_catalog', 'information_schema')"
      " AND left(n.nspname, 8) <> 'pg_toast' AND left(n.nspname, 8) <> 'pg_temp_'")
TABLES = """(SELECT coalesce(json_agg(t ORDER BY t."schema", t."name"), '[]'::json) FROM (
  SELECT n.nspname AS "schema", c.relname AS "name",
    (SELECT coalesce(json_agg(json_build_object(
        'name', a.attname,
        'type', format_type(a.atttypid, a.atttypmod),
        'notNull', a.attnotnull,
        'default', CASE WHEN a.attgenerated = '' THEN pg_get_expr(d.adbin, d.adrelid) END,
        'identity', CASE a.attidentity WHEN 'a' THEN 'always' WHEN 'd' THEN 'by default' END,
        'generated', CASE WHEN a.attgenerated <> '' THEN pg_get_expr(d.adbin, d.adrelid) END)
        ORDER BY a.attnum), '[]'::json)
      FROM pg_attribute a LEFT JOIN pg_attrdef d ON d.adrelid = a.attrelid AND d.adnum = a.attnum
      WHERE a.attrelid = c.oid AND a.attnum > 0 AND NOT a.attisdropped) AS "columns",
    (SELECT coalesce(json_agg(json_build_object(
        'name', i.relname, 'definition', pg_get_indexdef(x.indexrelid)) ORDER BY i.relname), '[]'::json)
      FROM pg_index x JOIN pg_class i ON i.oid = x.indexrelid
      WHERE x.indrelid = c.oid) AS "indexes",
    (SELECT coalesce(json_agg(json_build_object(
        'name', k.conname,
        'kind', CASE k.contype WHEN 'p' THEN 'primary key' WHEN 'f' THEN 'foreign key'
          WHEN 'u' THEN 'unique' WHEN 'c' THEN 'check' WHEN 'x' THEN 'exclusion'
          WHEN 'n' THEN 'not null' WHEN 't' THEN 'trigger' ELSE k.contype::text END,
        'definition', pg_get_constraintdef(k.oid)) ORDER BY k.conname), '[]'::json)
      FROM pg_constraint k WHERE k.conrelid = c.oid) AS "constraints",
    (SELECT pn.nspname || '.' || p.relname
      FROM pg_inherits h JOIN pg_class p ON p.oid = h.inhparent
        JOIN pg_namespace pn ON pn.oid = p.relnamespace
      WHERE h.inhrelid = c.oid AND c.relispartition) AS "partitionOf"
  FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
  WHERE c.relkind IN ('r', 'p') AND """ + NS + """
) t)"""
ENUMS = """(SELECT coalesce(json_agg(json_build_object(
    'schema', n.nspname, 'name', y.typname,
    'values', (SELECT coalesce(json_agg(e.enumlabel ORDER BY e.enumsortorder), '[]'::json)
               FROM pg_enum e WHERE e.enumtypid = y.oid))
    ORDER BY n.nspname, y.typname), '[]'::json)
  FROM pg_type y JOIN pg_namespace n ON n.oid = y.typnamespace
  WHERE y.typtype = 'e' AND """ + NS + ")"
SEQUENCES = """(SELECT coalesce(json_agg(json_build_object('schema', n.nspname, 'name', c.relname)
    ORDER BY n.nspname, c.relname), '[]'::json)
  FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
  WHERE c.relkind = 'S' AND """ + NS + ")"
MIGRATIONS = """(SELECT coalesce(json_agg(json_build_object(
    'id', m.id, 'hash', m.hash, 'created_at', m.created_at) ORDER BY m.id), '[]'::json)
  FROM drizzle.__drizzle_migrations m)"""
# The answer is built only inside a read-only transaction on ds_prod; the check
# travels with it and is verified before the answer is used.
SQL = (
    "BEGIN READ ONLY;\n"
    "SET LOCAL statement_timeout = '30s';\n"
    "SET LOCAL lock_timeout = '2s';\n"
    "SELECT json_build_object('database', current_database(), 'readOnly',"
    " current_setting('transaction_read_only') = 'on', 'answer', CASE WHEN current_database() = '"
    + DATABASE + "' AND current_setting('transaction_read_only') = 'on' THEN json_build_object(\n"
    "'serverVersion', current_setting('server_version'),\n"
    "'migrations', " + MIGRATIONS + ",\n"
    "'catalogue', json_build_object('tables', " + TABLES + ",\n'enums', " + ENUMS
    + ",\n'sequences', " + SEQUENCES + ")) END);\n"
    "ROLLBACK;\n"
)
TIMED_OUT = ("statement timeout", "lock timeout", "could not obtain lock")

def run(argv, stdin, timeout):
    try:
        done = subprocess.run(argv, cwd=compose, input=stdin, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, timeout=timeout)
    except subprocess.TimeoutExpired:
        stop(1, "the read timed out")
    except OSError:
        stop(1, "the read failed")
    if done.returncode != 0:
        text = done.stderr.decode("utf-8", "replace")
        # 124: the in-container `timeout` bound pg_dump (it resets statement_timeout).
        timed_out = done.returncode == 124 or any(m in text for m in TIMED_OUT)
        stop(1, "the read timed out" if timed_out else "the read failed")
    return done.stdout

if not os.path.isdir(compose):
    stop(3, "the data-prod compose directory is missing")
taken = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
out = run(["docker", "compose", "exec", "-T", "-e", "PGCLIENTENCODING=UTF8", "postgres", "psql", "-X",
           "-qAt", "-v", "ON_ERROR_STOP=1", "-U", "ds", "-d", DATABASE, "-f", "-"],
          SQL.encode("utf-8"), 60)
try:
    envelope = json.loads(out.decode("utf-8"))
except ValueError:
    stop(1, "the read failed")
if (not isinstance(envelope, dict) or envelope.get("database") != DATABASE
        or envelope.get("readOnly") is not True or not isinstance(envelope.get("answer"), dict)):
    stop(1, "the read-only transaction check failed")
answer = envelope["answer"]
catalogue = answer.get("catalogue")
if (not isinstance(answer.get("serverVersion"), str) or not isinstance(answer.get("migrations"), list)
        or not isinstance(catalogue, dict)
        or not all(isinstance(catalogue.get(k), list) for k in ("tables", "enums", "sequences"))):
    stop(1, "the read failed")
# pg_dump resets statement_timeout and lock_timeout itself, so `timeout 100` inside the
# container bounds the dump process (and its ACCESS SHARE locks); 120 s bounds the client.
dump = run(["docker", "compose", "exec", "-T", "-e",
            "PGOPTIONS=-c default_transaction_read_only=on -c statement_timeout=30s", "postgres",
            "timeout", "100", "pg_dump", "--schema-only", "--no-comments", "--no-owner", "--no-privileges",
            "--lock-wait-timeout=2s", "-U", "ds", DATABASE], b"", 120)
if not dump:
    stop(1, "the read failed")
sys.stdout.write(json.dumps({
    "verb": "schema",
    "database": DATABASE,
    "takenAt": taken,
    "serverVersion": answer["serverVersion"],
    "migrations": answer["migrations"],
    "dumpSha256": hashlib.sha256(dump).hexdigest(),
    "catalogue": {k: catalogue[k] for k in ("tables", "enums", "sequences")},
}, separators=(",", ":")) + "\n")
PY

read_schema() {
  local out rc=0
  out=$(sudo python3 -I -X utf8 -c "$READ_SCHEMA_PY" "$DATA_COMPOSE") || rc=$?
  case $rc in
    0) printf '%s\n' "$out" ;;
    3) refuse "${out:-the schema read cannot be served}" ;;
    *) read_fail "$(read_reason "$out")" ;;
  esac
}

# read-observe <name> (data box; Issue #3647; spec §5 «Prod read verbs.» → `observe
# <name>`): one named aggregate read from PROD_OBSERVATIONS, the prod catalogue — never
# the stage OBSERVATIONS of OBSERVE_PY. argv: the data-prod compose dir, the name, the
# parameter cap; stdin: the parameters, one JSON object, checked field by field here
# again. Exit 0 = the plaintext answer on stdout (ds-read-entrypoint encrypts it) ·
# 1 = one fixed reason of READ_REASONS · 2 = an unknown name or bad parameters (one
# fixed reason) · 3 = not servable. The catalogue grows only by a reviewed PR;
# tools/deploy/ds-deploy-entrypoint.test.mjs runs every entry against a fixture
# database. Importable: the entry point runs only as `python3 -c`.
read -r -d '' READ_OBSERVE_PY <<'PY' || true
import datetime, json, os, re, subprocess, sys, time

DATABASE = "ds_prod"
# A bucket, a count or a distinct count below MIN_BUCKET is never reported as itself.
MIN_BUCKET = 10
SMALL = "<10"
SUPPRESSED = "suppressed"

def stop(code, reason):
    sys.stdout.write(reason + "\n")
    sys.exit(code)

# Value patterns: enumerations, dates or ids of non-person objects only — never an
# email, a phone, a name or a person's id (a filter on one makes any count a
# membership oracle for one person; the test fails a pattern that admits either).
UUID = re.compile("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
DATE = re.compile("20[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])")

# A parameter: ("value", psql variable, pattern) reaches the SQL as :'var', or
# ("identifier", psql variable, names) — one of the entry's own enumerated names —
# as :"var". Neither is ever spliced into the SQL text.
def value(var, pattern):
    return ("value", var, pattern)
def identifier(var, *names):
    return ("identifier", var, names)

# name -> {params, sql, result}. `result` is {column: "count" | "distinct"} for one
# row, or "bucket" for rows {bucket, count}; every value an integer count.
PROD_OBSERVATIONS = {
    # How many rows a migration on one of these tables touches.
    "table-rows": {
        "params": {"table": identifier("table", "users", "registrations", "consent_records", "events")},
        "sql": 'SELECT count(*)::int AS "rows" FROM :"table"',
        "result": {"rows": "count"},
    },
    # The live registrations of one event since a date, and the doctors behind them.
    "event-registrations": {
        "params": {"eventId": value("event_id", UUID), "since": value("since", DATE)},
        "sql": "SELECT count(*)::int AS registrations, count(DISTINCT user_id)::int AS doctors"
               " FROM registrations WHERE event_id = :'event_id'::uuid"
               " AND registered_at >= :'since'::date AND deleted_at IS NULL",
        "result": {"registrations": "count", "doctors": "distinct"},
    },
    # The confirmation-mail outcome of one event's live registrations (`none`: no mail
    # recorded yet).
    "registrations-by-mail-status": {
        "params": {"eventId": value("event_id", UUID)},
        "sql": "SELECT coalesce(confirmation_mail_status::text, 'none') AS bucket, count(*)::int AS count"
               " FROM registrations WHERE event_id = :'event_id'::uuid AND deleted_at IS NULL GROUP BY 1",
        "result": "bucket",
    },
}

def checked(param, v):
    """The psql `-v` argument of one parameter value, or None for a bad value."""
    kind, var, allowed = param
    if not isinstance(v, str):
        return None
    if kind == "identifier":
        ok = v in allowed
    else:
        ok = allowed.fullmatch(v) is not None
        if ok and allowed is DATE:
            try:
                datetime.date.fromisoformat(v)
            except ValueError:
                ok = False
    return var + "=" + v if ok else None

def is_count(v):
    return type(v) is int and v >= 0

def small(n):
    return SMALL if n < MIN_BUCKET else n

def shape(result, rows):
    """The reported result of an entry's rows, or None when they are not its declared
    aggregates. Buckets under MIN_BUCKET fold into one `suppressed` bucket."""
    if not isinstance(rows, list):
        return None
    if result == "bucket":
        kept, folded, any_folded = [], 0, False
        for row in rows:
            if (not isinstance(row, dict) or set(row) != {"bucket", "count"}
                    or not isinstance(row["bucket"], str) or row["bucket"] == SUPPRESSED
                    or not is_count(row["count"])):
                return None
            if row["count"] < MIN_BUCKET:
                folded += row["count"]
                any_folded = True
            else:
                kept.append({"bucket": row["bucket"], "count": row["count"]})
        kept.sort(key=lambda b: b["bucket"])
        if any_folded:
            kept.append({"bucket": SUPPRESSED, "count": small(folded)})
        return {"buckets": kept}
    if len(rows) != 1 or not isinstance(rows[0], dict) or set(rows[0]) != set(result):
        return None
    if not all(is_count(rows[0][k]) for k in result):
        return None
    return {k: small(rows[0][k]) for k in result}

def envelope_sql(select):
    # The rows are built only inside a read-only transaction on ds_prod; the check
    # travels with them and is verified before they are used.
    return (
        "BEGIN READ ONLY;\n"
        "SET LOCAL statement_timeout = '5s';\n"
        "SET LOCAL lock_timeout = '2s';\n"
        "SET LOCAL timezone = 'UTC';\n"
        "SELECT json_build_object('database', current_database(), 'readOnly',"
        " current_setting('transaction_read_only') = 'on', 'rows', CASE WHEN current_database() = '"
        + DATABASE + "' AND current_setting('transaction_read_only') = 'on' THEN"
        " (SELECT coalesce(json_agg(row_to_json(observed)), '[]'::json) FROM (\n"
        + select + "\n) observed) END);\n"
        "ROLLBACK;\n"
    )

TIMED_OUT = ("statement timeout", "lock timeout", "could not obtain lock")

def main(compose, name, max_params):
    if name not in PROD_OBSERVATIONS:
        stop(2, "unknown observation")
    entry = PROD_OBSERVATIONS[name]
    raw = sys.stdin.buffer.read(max_params + 1)
    if len(raw) > max_params:
        stop(2, "the parameters exceed " + str(max_params) + " bytes")
    try:
        params = json.loads(raw.decode("utf-8")) if raw.strip() else {}
    except ValueError:
        stop(2, "the parameters are not one JSON object")
    if not isinstance(params, dict):
        stop(2, "the parameters are not one JSON object")
    if set(params) != set(entry["params"]):
        stop(2, "bad parameters for " + name)
    variables = []
    for key, param in entry["params"].items():
        arg = checked(param, params[key])
        if arg is None:
            stop(2, "bad parameters for " + name)
        variables += ["-v", arg]
    if not os.path.isdir(compose):
        stop(3, "the data-prod compose directory is missing")
    taken = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    try:
        done = subprocess.run(
            ["docker", "compose", "exec", "-T", "-e", "PGCLIENTENCODING=UTF8", "postgres", "psql", "-X",
             "-qAt", "-v", "ON_ERROR_STOP=1", *variables, "-U", "ds", "-d", DATABASE, "-f", "-"],
            cwd=compose, input=envelope_sql(entry["sql"]).encode("utf-8"),
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30)
    except subprocess.TimeoutExpired:
        stop(1, "the read timed out")
    except OSError:
        stop(1, "the read failed")
    if done.returncode != 0:
        text = done.stderr.decode("utf-8", "replace")
        stop(1, "the read timed out" if any(m in text for m in TIMED_OUT) else "the read failed")
    try:
        envelope = json.loads(done.stdout.decode("utf-8"))
    except ValueError:
        stop(1, "the read failed")
    if (not isinstance(envelope, dict) or envelope.get("database") != DATABASE
            or envelope.get("readOnly") is not True or not isinstance(envelope.get("rows"), list)):
        stop(1, "the read-only transaction check failed")
    result = shape(entry["result"], envelope["rows"])
    if result is None:
        stop(1, "the read failed")
    sys.stdout.write(json.dumps({"verb": "observe", "name": name, "takenAt": taken, "result": result},
                                separators=(",", ":")) + "\n")

if __name__ == "__main__":
    main(sys.argv[1], sys.argv[2], int(sys.argv[3]))
PY

read_observe() {
  local name=$1 out rc=0
  out=$(head -c "$((MAX_OBSERVE_PARAMS_BYTES + 1))" |
    sudo python3 -I -X utf8 -c "$READ_OBSERVE_PY" "$DATA_COMPOSE" "$name" "$MAX_OBSERVE_PARAMS_BYTES") || rc=$?
  case $rc in
    0) printf '%s\n' "$out" ;;
    2) reject "${out:-bad observation parameters}" ;;
    3) refuse "${out:-the observation cannot be served}" ;;
    *) read_fail "$(read_reason "$out")" ;;
  esac
}

# --- the migration rehearsal (Issue #3648; spec §5 «Migration rehearsal.») ----------
# The harness is the root-owned installed rehearse-migration.py (DATA_INSTALL); these
# verbs only bound the archive, take the lock and map its exit. `rehearse <sha>`
# (stdin: the migration archive ds-read-entrypoint built from the codeload tree of a
# SHA contained in `main`) answers started / running / no pending migrations;
# `rehearsal-status <sha>` reads no database and always answers.
REHEARSE_PY=$ROOT/usr/local/lib/ds-platform/rehearse-migration.py
REHEARSE_CLEANUP=$ROOT/usr/local/lib/ds-platform/rehearse-cleanup
REHEARSAL_LOCK_DIR=$ROOT/run/ds-platform
REHEARSAL_LOCK=$REHEARSAL_LOCK_DIR/ds-rehearsal.lock
MAX_REHEARSE_BYTES=$((16 * 1024 * 1024))
# The busy exit of `flock -n -E`, distinct from every exit of the harness.
REHEARSAL_BUSY=75
[[ -z $ROOT ]] || export DS_REHEARSE_ROOT=$ROOT

rehearse_installed() {
  sudo test -f "$REHEARSE_PY" && sudo test -x "$REHEARSE_CLEANUP" ||
    refuse "the migration rehearsal is not installed (the next release installs it)"
}

# The harness's exit: 0 the answer · 1 a fixed reason · 2 a bad archive · 3 not servable.
rehearse_result() {
  local rc=$1 out=$2
  case $rc in
    0) printf '%s\n' "$out" ;;
    "$REHEARSAL_BUSY") read_fail "a rehearsal is running" ;;
    2) reject "${out:-bad migration archive}" ;;
    3) refuse "${out:-the rehearsal cannot be served}" ;;
    *) read_fail "$(read_reason "$out")" ;;
  esac
}

rehearse() {
  local sha=$1 size out rc=0
  rehearse_installed
  rehearse_work=$(sudo mktemp -d) # global: the EXIT trap outlives this function; root-only (0700)
  trap 'sudo rm -rf -- "${rehearse_work:-}"' EXIT
  head -c "$((MAX_REHEARSE_BYTES + 1))" | sudo tee -- "$rehearse_work/drizzle.tar.gz" >/dev/null
  size=$(sudo stat -c %s -- "$rehearse_work/drizzle.tar.gz")
  ((size <= MAX_REHEARSE_BYTES)) || reject "the migration archive exceeds $MAX_REHEARSE_BYTES bytes"
  sudo install -d -m 0755 -o root -g root "$REHEARSAL_LOCK_DIR"
  # One rehearsal at a time; the unit takes the same lock for its whole run.
  out=$(sudo flock -n -E "$REHEARSAL_BUSY" "$REHEARSAL_LOCK" \
    python3 -I "$REHEARSE_PY" start "$sha" "$rehearse_work/drizzle.tar.gz" </dev/null) || rc=$?
  rehearse_result "$rc" "$out"
}

rehearsal_status() {
  local out rc=0
  rehearse_installed
  out=$(sudo python3 -I "$REHEARSE_PY" status "$1") || rc=$?
  rehearse_result "$rc" "$out"
}

# One of READ_REASONS, else `the read failed`.
read_reason() {
  local reason
  for reason in "${READ_REASONS[@]}"; do
    [[ $1 == "$reason" ]] && { printf '%s' "$reason"; return 0; }
  done
  printf 'the read failed'
}

case "$verb" in
  status)
    [[ ${#words[@]} -eq 3 ]] || reject "usage: status <env> <sha>"
    check_env "${words[1]}"
    check_sha "${words[2]}"
    accepted
    release_status "${words[1]}" "${words[2]}"
    ;;
  release)
    [[ ${#words[@]} -eq 3 ]] || reject "usage: release <env> <sha>"
    check_env "${words[1]}"
    check_sha "${words[2]}"
    accepted
    [[ -x $RELEASE_DRIVER ]] ||
      refuse "release driver not installed (lands with #2985 stage / #2986 prod)"
    exec "$RELEASE_DRIVER" "${words[1]}" "${words[2]}"
    ;;
  rollback | rollback-status)
    [[ ${#words[@]} -eq 3 && ${words[1]} == prod ]] || reject "usage: $verb prod <sha>"
    check_sha "${words[2]}"
    accepted
    role=$(sudo cat "$BOX_ROLE_FILE" 2>/dev/null || true)
    [[ $role == prod ]] || refuse "$verb is served by the prod box only"
    if [[ ! -x $RELEASE_DRIVER ]]; then
      [[ $verb == rollback ]] && refuse "release driver not installed: no box-side rollback on this box"
      # No driver, no rollback unit: nothing was ever rolled back from here.
      printf '{"rollback":null,"driver":{"unit":"ds-prod-%s-rollback","active":"absent","rc":null,"previousSha":null}}\n' \
        "${words[2]:0:12}"
      exit 0
    fi
    exec "$RELEASE_DRIVER" "$verb" prod "${words[2]}"
    ;;
  redeploy)
    [[ ${#words[@]} -eq 3 && ${words[1]} == prod ]] || reject "usage: redeploy prod <sha>"
    check_sha "${words[2]}"
    accepted
    role=$(sudo cat "$BOX_ROLE_FILE" 2>/dev/null || true)
    [[ $role == prod ]] || refuse "redeploy is served by the prod box only"
    [[ -x $RELEASE_DRIVER ]] || refuse "release driver not installed: no box-side redeploy on this box"
    exec "$RELEASE_DRIVER" redeploy prod "${words[2]}"
    ;;
  upload-report)
    [[ ${#words[@]} -eq 2 ]] || reject "usage: upload-report <sha>"
    check_sha "${words[1]}"
    accepted
    upload_report "${words[1]}"
    ;;
  observe)
    [[ ${#words[@]} -eq 2 ]] || reject "usage: observe <name>"
    case "${words[1]}" in
      academy-host | password-policy | mirror-count | auth-consent | phone-account-count | \
        congress-snapshot | wrong-verification) ;;
      *) reject "unknown observation" ;;
    esac
    accepted
    observe "${words[1]}"
    ;;
  capabilities | postgres-probe | postgres-checkpoint | ship | install | data-env | data-up | backup | \
    backup-info | rollback-floor | finish | check | supersede | converge | read-schema | read-observe | rehearse | rehearsal-status | recovery-bundle | recovery-check | recovery-put | recovery-latest)
    data_verb
    ;;
  *)
    reject "unknown command (allowed: status, release, rollback, rollback-status, redeploy, upload-report, observe; on the data box also: ${DATA_VERBS// /, })"
    ;;
esac
