#!/usr/bin/env bash
# ds-read-entrypoint — the forced command of the prod read key on ds-api-prod (Issue
# #3646; tech spec apps/docs/content/specs/tech/2026-10-16-release-pipeline-off-workstation-en.md
# §4 «The read key on ds-api-prod», «Least privilege: the read key», §5 «Prod read verbs.»).
#
# The read key in deploy's authorized_keys carries
#   command="sudo -n /usr/local/bin/ds-read-entrypoint",restrict
# and deploy's sudo right for it is this file with no arguments, keeping
# SSH_ORIGINAL_COMMAND through sudo's env reset (/etc/sudoers.d/90-ds-deploy).
#
# It is its own binary, never ds-deploy-entrypoint with an argument: an older
# ds-deploy-entrypoint, put back by an install of a pre-#3646 tree, ignores its
# arguments and would serve the full deploy verb set to the read key. Old trees never
# write this path, and this file never execs or sources ds-deploy-entrypoint; the only
# box programs it runs are `ds-release check prod` (fixed words) and, over the hop key,
# the data entrypoint's `check`, `read-schema`, `read-observe`, `rehearse`, `rehearse-restore`,
# `rehearsal-status` and the
# recovery verbs (an older data entrypoint rejects them: fail-closed), and ds-recovery
# (#3662).
#
# It serves READ_VERBS below on the prod box only and rejects every other verb with
# exit 2. `schema`, `observe`, `rehearse`, `rehearse-restore` and `rehearsal-status` leave as CMS ciphertext to the recipient certificate installed
# with the tooling tree (READ_RECIPIENT), never plaintext: the client's stdout is a
# public Actions artifact. `capabilities` answers its verb list; `recovery-bundle` and
# `recovery-check` (#3662) answer status lines only (RECOVERY_LINE_RE): no value, no
# fingerprint, no ciphertext — the bundle's ciphertext goes to the pgBackRest bucket.
# `rehearse` / `rehearse-restore` / `rehearsal-status` (#3648) add one plaintext line on
# stderr, the state word (REHEARSAL_STATE_RE) prod-observe.yml prints; everything else
# stays encrypted. `rehearse-restore <sha>` takes the input of `rehearse <sha>` and
# restores prod onto the throw-away copy with no migration applied: the restore path
# and its measured headroom, on demand, with nothing pending.
#
# Installed as /usr/local/bin/ds-read-entrypoint beside ds-release and
# ds-deploy-entrypoint, by the same install step (tools/deploy/lib/remote.mjs).
#
# Exit codes: 0 ok · 1 the read failed (one fixed reason of READ_REASONS) · 2 rejected
# (usage, an unknown verb) · 3 refused (not the prod box, no recipient certificate,
# ds-data-prod does not serve the verb yet).
set -euo pipefail
export LC_ALL=C

# Test hooks: a root prefix and the DS_ENTRYPOINT_* overrides below. The installed
# entrypoint never reads them.
ROOT=
if [[ ${BASH_SOURCE[0]} != /usr/local/bin/ds-read-entrypoint ]]; then
  ROOT=${DS_ENTRYPOINT_ROOT:-}
fi
override() { [[ -n $ROOT ]] && printf '%s' "${!1:-$2}" || printf '%s' "$2"; }
DS_RELEASE=$ROOT/usr/local/bin/ds-release
BOX_ROLE_FILE=$ROOT/etc/ds-platform/box-role

COMMAND_RE='^[a-z0-9-]+( [a-z0-9-]+)*$'
COMMAND_MAX=200

TAG=ds-read-entrypoint
# The tag of the data entrypoint's status lines on the hop's stderr.
DATA_TAG=ds-deploy-entrypoint
request=${SSH_ORIGINAL_COMMAND-}

sanitised() { printf '%s' "$request" | LC_ALL=C tr -c '[:alnum:] ._/=-' '?' | head -c 120; }
reject() {
  logger -t "$TAG" -p auth.warning "rejected: $(sanitised)" || true
  printf '%s: rejected: %s\n' "$TAG" "$1" >&2
  exit 2
}
refuse() {
  printf '%s: %s\n' "$TAG" "$1" >&2
  exit 3
}
accepted() { logger -t "$TAG" -p auth.info "accepted: $(sanitised)" || true; }

# The verbs it serves (spec §8 (g): S1 serves `capabilities` and `schema`; #3662 adds
# the key custody); prod-observe.yml / recovery-custody.yml refuse a verb
# `capabilities` does not name.
READ_VERBS='capabilities schema observe rehearse rehearse-restore rehearsal-status recovery-bundle recovery-check'
# #3647: `observe <name>` — the name of a PROD_OBSERVATIONS entry (the data entrypoint's
# catalogue checks it and every parameter again), the parameters one JSON object of at
# most MAX_OBSERVE_PARAMS_BYTES on stdin. The data box's rejections of a name or a
# parameter (exit 2) reach the client as the same exit with their fixed reason.
OBSERVE_NAME_RE='^[a-z][a-z0-9-]{0,39}$'
MAX_OBSERVE_PARAMS_BYTES=4096
OBSERVE_REJECT_RE='^(unknown observation|bad parameters for [a-z][a-z0-9-]{0,39}|the parameters exceed 4096 bytes|the parameters are not one JSON object)$'
SHA_RE='^[0-9a-f]{40}$'
# The fixed failure reasons of a read (exit 1), the same list as the data
# entrypoint's; a reason from the data box outside it reaches the client as
# `the read failed`.
READ_REASONS=(
  'a release step is running'
  'a rehearsal is running'
  'the read-only transaction check failed'
  'the read timed out'
  'insufficient headroom (disk)'
  'insufficient headroom (memory)'
  'copy behind prod'
  'copy exited before promotion'
  'copy did not promote in time'
  'archive check failed'
  'the read failed'
)
# The recipient certificate, installed with the tooling tree (tools/deploy/lib/remote.mjs
# INSTALLED_TREE_DIR) from the committed infra/deploy/keys/prod-read-recipient.pem.
READ_RECIPIENT=$ROOT/usr/local/lib/ds-platform/tree/infra/deploy/keys/prod-read-recipient.pem
# The hop to ds-data-prod, as the release driver takes it (tools/deploy/lib/remote.mjs
# DATA_PROD_HOP_KEY / DATA_PROD_HOP_KNOWN_HOSTS, tools/deploy/prod.mjs VPC_IP).
DATA_PROD_HOP_KEY=$ROOT/home/deploy/.ssh/data-prod-hop
DATA_PROD_HOP_KNOWN_HOSTS=$ROOT/home/deploy/.ssh/known_hosts
DATA_PROD_ADDRESS=$(override DS_ENTRYPOINT_DATA_PROD_ADDRESS 192.168.0.10)
READ_HOP_TIMEOUT=$(override DS_ENTRYPOINT_READ_HOP_TIMEOUT 180)
# #3662: the key custody's box side and the custodians of the installed tree.
DS_RECOVERY=$ROOT/usr/local/lib/ds-platform/ds-recovery
[[ -z $ROOT ]] || export DS_RECOVERY_ROOT=$ROOT
RECOVERY_CUSTODIANS=$ROOT/usr/local/lib/ds-platform/tree/infra/deploy/recovery/custodians.txt
# The status lines a recovery verb may print; any other line from a box is dropped.
RECOVERY_LINE_RE='^(api-prod|data-prod) (MATCH|MISSING|STORED [0-9]{8}T[0-9]{6}Z members [0-9]{1,3}|STALE [0-9]{1,5}d|MISMATCH [A-Za-z0-9_.:-]{1,80})$'
# A ds-recovery refusal or failure: its own fixed text, bounded.
RECOVERY_REASON_RE='^ds-recovery: [A-Za-z0-9 #().,:/_-]{1,200}$'
# #3648: the rehearsal's input — the SHA's tree from codeload, as the -driver unit
# downloads it, once GitHub says the SHA is contained in `main`.
CODELOAD=$(override DS_ENTRYPOINT_CODELOAD https://codeload.github.com/doctor-school/ds-platform/tar.gz)
GITHUB_API=$(override DS_ENTRYPOINT_GITHUB_API https://api.github.com/repos/doctor-school/ds-platform)
MAX_REHEARSE_BYTES=$((16 * 1024 * 1024))
# The state words of the rehearsal answers, the one plaintext a rehearsal prints.
REHEARSAL_STATE_RE='^(started|running|no pending migrations|succeeded|failed|absent)$'

read_fail() {
  printf '%s: %s\n' "$TAG" "$1" >&2
  exit 1
}

# One of READ_REASONS, else `the read failed`.
read_reason() {
  local reason
  for reason in "${READ_REASONS[@]}"; do
    [[ $1 == "$reason" ]] && { printf '%s' "$reason"; return 0; }
  done
  printf 'the read failed'
}

# One data verb over the hop, stdin closed; its stdout and stderr are the caller's.
data_prod_hop() {
  timeout "$READ_HOP_TIMEOUT" ssh -n -i "$DATA_PROD_HOP_KEY" -o IdentitiesOnly=yes -o BatchMode=yes \
    -o StrictHostKeyChecking=yes -o "UserKnownHostsFile=$DATA_PROD_HOP_KNOWN_HOSTS" \
    -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
    "deploy@$DATA_PROD_ADDRESS" "$1"
}

# One data verb over the hop with the caller's stdin (recovery-put).
data_prod_hop_in() {
  timeout "$READ_HOP_TIMEOUT" ssh -i "$DATA_PROD_HOP_KEY" -o IdentitiesOnly=yes -o BatchMode=yes \
    -o StrictHostKeyChecking=yes -o "UserKnownHostsFile=$DATA_PROD_HOP_KNOWN_HOSTS" \
    -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
    "deploy@$DATA_PROD_ADDRESS" "$1"
}

# A read never runs beside a release step: `ds-release check prod` here (the migrate
# step, the -driver and -rollback units), then `check` on ds-data-prod (its up and
# backup units). ds-release refuses with 3 while a ds-prod-* unit runs.
read_release_check() {
  local rc=0
  [[ -x $DS_RELEASE ]] || refuse "ds-release is not installed"
  sudo "$DS_RELEASE" check prod >/dev/null 2>&1 </dev/null || rc=$?
  case $rc in 0) ;; 3) read_fail "a release step is running" ;; *) read_fail "the read failed" ;; esac
  data_prod_hop check >/dev/null 2>&1 || rc=$?
  case $rc in 0) ;; 3) read_fail "a release step is running" ;; 124) read_fail "the read timed out" ;; *) read_fail "the read failed" ;; esac
}

read_workdir() {
  [[ -n ${read_work:-} ]] && return 0
  read_work=$(mktemp -d) # global: the EXIT trap outlives this function; root-only (0700)
  trap 'rm -rf -- "${read_work:-}"' EXIT
}

# The verb's whole answer, encrypted to READ_RECIPIENT (CMS AuthEnvelopedData,
# AES-256-GCM, DER): only the ciphertext reaches stdout. argv: the data request, then
# optionally the file the hop sends as its stdin.
read_encrypted() {
  local data_request=$1 stdin_file=${2-} data_verb=${1%% *} rc=0 reason
  read_workdir
  if [[ -n $stdin_file ]]; then
    data_prod_hop_in "$data_request" <"$stdin_file" >"$read_work/answer.json" 2>"$read_work/stderr" || rc=$?
  else
    data_prod_hop "$data_request" >"$read_work/answer.json" 2>"$read_work/stderr" || rc=$?
  fi
  case $rc in
    0) ;;
    1)
      reason=$(sed -n "s/^$DATA_TAG: //p" "$read_work/stderr" | tail -n 1)
      read_fail "$(read_reason "$reason")"
      ;;
    2)
      reason=$(sed -n "s/^$DATA_TAG: rejected: //p" "$read_work/stderr" | tail -n 1)
      [[ $data_verb == read-observe && $reason =~ $OBSERVE_REJECT_RE ]] && reject "$reason"
      refuse "ds-data-prod does not serve $data_verb (the next release installs it)"
      ;;
    3) refuse "ds-data-prod does not serve $data_verb (the next release installs it)" ;;
    124) read_fail "the read timed out" ;;
    *) read_fail "the read failed" ;;
  esac
  [[ -s $read_work/answer.json ]] || read_fail "the read failed"
  [[ $data_verb != rehearse && $data_verb != rehearse-restore && $data_verb != rehearsal-status ]] ||
    rehearsal_state "$read_work/answer.json"
  openssl cms -encrypt -binary -aes-256-gcm -outform DER -in "$read_work/answer.json" \
    -out "$read_work/result.cms" "$READ_RECIPIENT" >/dev/null 2>&1 ||
    refuse "openssl cannot encrypt to the recipient certificate"
  cat -- "$read_work/result.cms"
}

# observe's parameters (#3647): at most MAX_OBSERVE_PARAMS_BYTES, one JSON object (empty
# reads as {}), into the root-only work dir; the data box checks every field.
observe_params() {
  local size
  read_workdir
  head -c "$((MAX_OBSERVE_PARAMS_BYTES + 1))" >"$read_work/params.json"
  size=$(stat -c %s -- "$read_work/params.json")
  ((size <= MAX_OBSERVE_PARAMS_BYTES)) || reject "the parameters exceed $MAX_OBSERVE_PARAMS_BYTES bytes"
  python3 -I -c 'import json,sys; raw=open(sys.argv[1],"rb").read(); sys.exit(0 if not raw.strip() or isinstance(json.loads(raw), dict) else 1)' \
    "$read_work/params.json" 2>/dev/null || reject "the parameters are not one JSON object"
}

# --- the migration rehearsal (Issue #3648; spec §5 «Migration rehearsal.») ----------
# The answer's state word, the one plaintext line (stderr) of a rehearsal verb; an
# answer without one of REHEARSAL_STATE_RE is a failed read.
rehearsal_state() {
  local state
  state=$(python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["state"] if isinstance(d,dict) and isinstance(d.get("state"),str) else "")' \
    "$1" 2>/dev/null) || state=
  [[ $state =~ $REHEARSAL_STATE_RE ]] || read_fail "the read failed"
  printf '%s: state %s\n' "$TAG" "$state" >&2
}

# Tree provenance, as the box-side rollback refusal checks it (release-driver
# compare_status): compare refs/heads/main...<sha> (the branch, never a tag named
# `main`) must be `behind` (an ancestor of main) or
# `identical`; anything else — `ahead`, `diverged`, a 404, a rate limit, a network
# error — is refused (fail closed): a rehearsal runs reviewed migration SQL only.
rehearse_on_main() {
  local body status
  body=$(curl -fsS --proto '=https' --max-time 30 -H 'Accept: application/vnd.github+json' \
    "$GITHUB_API/compare/refs/heads/main...$1" 2>/dev/null) ||
    reject "cannot confirm $1 is contained in main (GitHub compare unavailable)"
  status=$(printf '%s' "$body" |
    python3 -I -c 'import json,sys; d=json.load(sys.stdin); print(d.get("status","") if isinstance(d,dict) else "")' \
      2>/dev/null) || status=
  case $status in
    behind | identical) ;;
    *) reject "$1 is not contained in main (compare status: ${status:-unknown})" ;;
  esac
}

# The SHA's codeload tree, as root; only apps/api/drizzle/*.sql and
# meta/_journal.json go on, checked member by member like `ship` (no absolute or ..
# path, regular files only, at most MAX_REHEARSE_BYTES), repacked as drizzle/....
read -r -d '' REHEARSE_ARCHIVE_PY <<'PY' || true
import io, re, sys, tarfile
src, dest, cap = sys.argv[1], sys.argv[2], int(sys.argv[3])
SQL = re.compile(r"apps/api/drizzle/([A-Za-z0-9_]{1,128}\.sql)")
JOURNAL = "apps/api/drizzle/meta/_journal.json"
def stop(reason):
    sys.stdout.write(reason + "\n")
    sys.exit(1)
picked, total = [], 0
try:
    with tarfile.open(src, mode="r:gz") as tar:
        for m in tar:
            parts = m.name.split("/")
            if m.name.startswith("/") or ".." in parts:
                stop("the tree holds an absolute or .. path")
            rest = "/".join(p for p in parts[1:] if p not in ("", "."))
            sql = SQL.fullmatch(rest)
            if not (sql or rest == JOURNAL):
                continue
            if not m.isreg():
                stop("a migration member is not a regular file")
            total += m.size
            if total > cap:
                stop("the migrations exceed the archive cap")
            name = "drizzle/" + (sql.group(1) if sql else "meta/_journal.json")
            picked.append((name, tar.extractfile(m).read()))
except (tarfile.TarError, EOFError, OSError):
    stop("the tree is not a readable gzip tar stream")
if not any(n == "drizzle/meta/_journal.json" for n, _ in picked):
    stop("the tree has no migration journal")
with tarfile.open(dest, mode="w:gz") as out:
    for name, data in sorted(picked):
        info = tarfile.TarInfo(name)
        info.size, info.mode = len(data), 0o644
        out.addfile(info, io.BytesIO(data))
PY

rehearse_archive() {
  local sha=$1
  command -v curl >/dev/null || refuse "curl is not installed"
  read_workdir
  curl -fsSL --proto '=https' --retry 3 --max-time 300 --max-filesize $((1024 * 1024 * 1024)) \
    -o "$read_work/tree.tar.gz" "$CODELOAD/$sha" 2>/dev/null || read_fail "the read failed"
  python3 -I -X utf8 -c "$REHEARSE_ARCHIVE_PY" "$read_work/tree.tar.gz" "$read_work/drizzle.tar.gz" \
    "$MAX_REHEARSE_BYTES" >/dev/null 2>&1 || read_fail "the read failed"
  rm -f -- "$read_work/tree.tar.gz"
}

# --- the key custody (Issue #3662; spec §5 «Prod read verbs.») ----------------------
recovery_lines() { grep -E "$RECOVERY_LINE_RE" "$1" || true; }
# The last ds-recovery reason of a file, or the fallback.
recovery_reason() {
  local line
  line=$(grep -E "$RECOVERY_REASON_RE" "$1" | tail -n 1 || true)
  printf '%s' "${line:-$2}"
}
# The verdict of one hop: 0, or the status of a failed hop with its reason on stderr.
recovery_hop_status() { # <rc> <stderr file> <what>
  case $1 in
    0) return 0 ;;
    1) printf '%s: data-prod: %s\n' "$TAG" "$(recovery_reason "$2" "$3 failed")" >&2; return 1 ;;
    2) printf '%s: data-prod: ds-data-prod does not serve the recovery verbs (the next release installs them)\n' "$TAG" >&2; return 3 ;;
    3) printf '%s: data-prod: %s\n' "$TAG" "$(recovery_reason "$2" "$3 refused")" >&2; return 3 ;;
    124) printf '%s: data-prod: %s timed out\n' "$TAG" "$3" >&2; return 1 ;;
    *) printf '%s: data-prod: %s failed\n' "$TAG" "$3" >&2; return 1 ;;
  esac
}
# A local ds-recovery failure: its reason on stderr, its status kept.
recovery_local_status() { # <rc> <stderr file>
  (($1 == 0)) && return 0
  printf '%s: api-prod: %s\n' "$TAG" "$(recovery_reason "$2" "ds-recovery failed")" >&2
  (($1 == 3)) && return 3
  return 1
}

# api-prod: bundle here, store through ds-data-prod (the bucket's credentials live there).
recovery_bundle_api() {
  local w=$recovery_work/api stamp members rc=0
  mkdir -- "$w" # inside the root-only (0700) recovery_work
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  members=$("$DS_RECOVERY" bundle api-prod "$RECOVERY_CUSTODIANS" "$w" "$stamp" 2>"$w/err") || rc=$?
  recovery_local_status "$rc" "$w/err" || return $?
  data_prod_hop_in "recovery-put api-prod ${stamp,,} bundle" <"$w/bundle.tar.age" >/dev/null 2>"$w/err" || rc=$?
  recovery_hop_status "$rc" "$w/err" "storing the api-prod bundle" || return $?
  data_prod_hop_in "recovery-put api-prod ${stamp,,} manifest" <"$w/manifest.json" >/dev/null 2>"$w/err" || rc=$?
  recovery_hop_status "$rc" "$w/err" "storing the api-prod manifest" || return $?
  printf 'api-prod STORED %s members %s\n' "$stamp" "$members" | grep -E "$RECOVERY_LINE_RE"
}
recovery_bundle_data() {
  local w=$recovery_work/data rc=0
  mkdir -- "$w" # inside the root-only (0700) recovery_work
  data_prod_hop recovery-bundle >"$w/out" 2>"$w/err" || rc=$?
  recovery_lines "$w/out"
  recovery_hop_status "$rc" "$w/err" "the data-prod bundle"
}
recovery_check_api() {
  local w=$recovery_work/api rc=0
  mkdir -- "$w" # inside the root-only (0700) recovery_work
  "$DS_RECOVERY" custodians "$RECOVERY_CUSTODIANS" 2>"$w/err" || rc=$?
  recovery_local_status "$rc" "$w/err" || return $?
  data_prod_hop "recovery-latest api-prod" >"$w/latest.json" 2>"$w/err" || rc=$?
  recovery_hop_status "$rc" "$w/err" "reading the api-prod manifest" || return $?
  if [[ $(head -c 7 "$w/latest.json") == MISSING ]]; then
    echo "api-prod MISSING"
    return 1
  fi
  "$DS_RECOVERY" check api-prod "$RECOVERY_CUSTODIANS" "$w/latest.json" >"$w/out" 2>"$w/err" || rc=$?
  recovery_lines "$w/out"
  # 1 with status lines is a verdict (MISMATCH / STALE), not a failure of the check.
  if ((rc == 1)) && [[ -n $(recovery_lines "$w/out") ]]; then return 1; fi
  recovery_local_status "$rc" "$w/err"
}
recovery_check_data() {
  local w=$recovery_work/data rc=0
  mkdir -- "$w" # inside the root-only (0700) recovery_work
  data_prod_hop recovery-check >"$w/out" 2>"$w/err" || rc=$?
  recovery_lines "$w/out"
  if ((rc == 1)) && [[ -n $(recovery_lines "$w/out") ]]; then return 1; fi
  recovery_hop_status "$rc" "$w/err" "the data-prod check"
}
# Both boxes, always both: the verb's status is the worse of the two (3 > 1 > 0).
recovery_verb() {
  local api=0 data=0
  [[ -x $DS_RECOVERY ]] || refuse "ds-recovery is not installed (the next release installs it)"
  recovery_work=$(mktemp -d) # global: the EXIT trap outlives this function; root-only (0700)
  trap 'rm -rf -- "${recovery_work:-}"' EXIT
  "recovery_$1_api" || api=$?
  "recovery_$1_data" || data=$?
  ((api == 3 || data == 3)) && exit 3
  ((api == 0 && data == 0)) || exit 1
}

# sudo admits this file with no arguments only; anything else is not the read key.
(($# == 0)) || reject "unexpected arguments"
[[ -n $request ]] || reject "no command (this key runs only the read commands)"
[[ ${#request} -le $COMMAND_MAX && $request =~ $COMMAND_RE ]] ||
  reject "unexpected characters in the command"
IFS=' ' read -r -a words <<<"$request"
verb=${words[0]-}

case "$verb" in
  capabilities | schema | recovery-bundle | recovery-check) [[ ${#words[@]} -eq 1 ]] || reject "usage: $verb" ;;
  observe)
    [[ ${#words[@]} -eq 2 && ${words[1]} =~ $OBSERVE_NAME_RE ]] || reject "usage: observe <name>" ;;
  rehearse | rehearse-restore | rehearsal-status)
    [[ ${#words[@]} -eq 2 && ${words[1]} =~ $SHA_RE ]] || reject "usage: $verb <sha> (the full 40-hex commit id)" ;;
  *) reject "unknown read command (allowed: ${READ_VERBS// /, })" ;;
esac
accepted
role=$(sudo cat "$BOX_ROLE_FILE" 2>/dev/null || true)
[[ $role == prod ]] || refuse "the read commands are served by the prod box only"
case "$verb" in
  capabilities)
    printf '{"role":"prod","mode":"read","verbs":["%s"]}\n' "${READ_VERBS// /\",\"}" ;;
  schema)
    sudo test -f "$READ_RECIPIENT" || refuse "the read-result recipient certificate is not installed"
    read_release_check
    read_encrypted read-schema </dev/null ;;
  observe)
    sudo test -f "$READ_RECIPIENT" || refuse "the read-result recipient certificate is not installed"
    observe_params
    read_release_check
    read_encrypted "read-observe ${words[1]}" "$read_work/params.json" </dev/null ;;
  rehearse | rehearse-restore)
    sudo test -f "$READ_RECIPIENT" || refuse "the read-result recipient certificate is not installed"
    read_release_check
    rehearse_on_main "${words[1]}"
    rehearse_archive "${words[1]}"
    read_encrypted "$verb ${words[1]}" "$read_work/drizzle.tar.gz" </dev/null ;;
  rehearsal-status)
    # Reads no database: no release check; it always answers.
    sudo test -f "$READ_RECIPIENT" || refuse "the read-result recipient certificate is not installed"
    read_encrypted "rehearsal-status ${words[1]}" </dev/null ;;
  recovery-bundle | recovery-check)
    read_release_check
    recovery_verb "${verb#recovery-}" </dev/null ;;
esac
