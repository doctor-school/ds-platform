#!/usr/bin/env bash
# ds-read-entrypoint — the forced command of the prod read key on ds-api-prod (Issue
# #3646; tech spec apps/docs/content/specs/tech/2026-10-16-release-pipeline-off-workstation-en.md
# §4 «The read key on ds-api-prod», «Least privilege: the read key», §5 «Prod read verbs.»).
#
# The read key in deploy's authorized_keys carries
#   command="sudo -n /usr/local/bin/ds-read-entrypoint",restrict
# and deploy's sudo right for it is this file with no arguments, keeping
# SSH_ORIGINAL_COMMAND through sudo's env reset (/etc/sudoers.d/90-ds-deploy).
#
# It is its own binary, never ds-deploy-entrypoint with an argument: an older
# ds-deploy-entrypoint, put back by an install of a pre-#3646 tree, ignores its
# arguments and would serve the full deploy verb set to the read key. Old trees never
# write this path, and this file never execs or sources ds-deploy-entrypoint; the only
# box programs it runs are `ds-release check prod` (fixed words) and, over the hop key,
# the data entrypoint's `check`, `read-schema`, `read-observe`, `rehearse`, `rehearse-restore`,
# `rehearsal-status`, `read-host-state`, `read-secret-journal` (#4280) and the
# recovery verbs (an older data entrypoint rejects them: fail-closed), ds-recovery
# (#3662), for `release-journal` (#4067) `journalctl` on fixed unit names and, for
# `host-state` (#4144), the fixed probe commands of HOST_STATE_PY.
#
# It serves READ_VERBS below on the prod box only and rejects every other verb with
# exit 2. `schema`, `observe`, `rehearse`, `rehearse-restore`, `rehearsal-status`,
# `release-journal` and `host-state` leave as CMS ciphertext to the recipient certificate installed
# with the tooling tree (READ_RECIPIENT), never plaintext: the client's stdout is a
# public Actions artifact. `capabilities` answers its verb list; `recovery-bundle` and
# `recovery-check` (#3662) answer status lines only (RECOVERY_LINE_RE): no value, no
# fingerprint, no ciphertext — the bundle's ciphertext goes to the pgBackRest bucket.
# `rehearse` / `rehearse-restore` / `rehearsal-status` (#3648) add one plaintext line on
# stderr, the state word (REHEARSAL_STATE_RE) prod-observe.yml prints; everything else
# stays encrypted. `rehearse-restore <sha>` takes the input of `rehearse <sha>` and
# restores prod onto the throw-away copy with no migration applied: the restore path
# and its measured headroom, on demand, with nothing pending. `release-journal <sha>`
# (#4067) answers the bounded journal tail of the release's driver unit and of every
# step unit this box's status file records as not succeeded, of the SHA's api-secret
# and (over the hop) data-secret rotation units (#4280), with the failure note: a
# failed release or rotation is read without the break-glass key. `host-state` (#4144) answers
# both prod boxes' resolver, self-hostname, disk and uptime, and ds-data-prod's WAL
# archiver and pgBackRest version: a closed field list, without the break-glass key.
#
# Installed as /usr/local/bin/ds-read-entrypoint beside ds-release and
# ds-deploy-entrypoint, by the same install step (tools/deploy/lib/remote.mjs).
#
# Exit codes: 0 ok · 1 the read failed (one fixed reason of READ_REASONS) · 2 rejected
# (usage, an unknown verb) · 3 refused (not the prod box, no recipient certificate,
# ds-data-prod does not serve the verb yet).
set -euo pipefail
export LC_ALL=C

# Test hooks: a root prefix and the DS_ENTRYPOINT_* overrides below. The installed
# entrypoint never reads them.
ROOT=
if [[ ${BASH_SOURCE[0]} != /usr/local/bin/ds-read-entrypoint ]]; then
  ROOT=${DS_ENTRYPOINT_ROOT:-}
fi
override() { [[ -n $ROOT ]] && printf '%s' "${!1:-$2}" || printf '%s' "$2"; }
DS_RELEASE=$ROOT/usr/local/bin/ds-release
BOX_ROLE_FILE=$ROOT/etc/ds-platform/box-role

COMMAND_RE='^[a-z0-9-]+( [a-z0-9-]+)*$'
COMMAND_MAX=200

TAG=ds-read-entrypoint
# The tag of the data entrypoint's status lines on the hop's stderr.
DATA_TAG=ds-deploy-entrypoint
request=${SSH_ORIGINAL_COMMAND-}

sanitised() { printf '%s' "$request" | LC_ALL=C tr -c '[:alnum:] ._/=-' '?' | head -c 120; }
reject() {
  logger -t "$TAG" -p auth.warning "rejected: $(sanitised)" || true
  printf '%s: rejected: %s\n' "$TAG" "$1" >&2
  exit 2
}
refuse() {
  printf '%s: %s\n' "$TAG" "$1" >&2
  exit 3
}
accepted() { logger -t "$TAG" -p auth.info "accepted: $(sanitised)" || true; }

# The verbs it serves (spec §8 (g): S1 serves `capabilities` and `schema`; #3662 adds
# the key custody); prod-observe.yml / recovery-custody.yml refuse a verb
# `capabilities` does not name.
READ_VERBS='capabilities schema observe rehearse rehearse-restore rehearsal-status release-journal host-state recovery-bundle recovery-check'
# #3647: `observe <name>` — the name of a PROD_OBSERVATIONS entry (the data entrypoint's
# catalogue checks it and every parameter again), the parameters one JSON object of at
# most MAX_OBSERVE_PARAMS_BYTES on stdin. The data box's rejections of a name or a
# parameter (exit 2) reach the client as the same exit with their fixed reason.
OBSERVE_NAME_RE='^[a-z][a-z0-9-]{0,39}$'
MAX_OBSERVE_PARAMS_BYTES=4096
OBSERVE_REJECT_RE='^(unknown observation|bad parameters for [a-z][a-z0-9-]{0,39}|the parameters exceed 4096 bytes|the parameters are not one JSON object)$'
SHA_RE='^[0-9a-f]{40}$'
# The fixed failure reasons of a read (exit 1), the same list as the data
# entrypoint's; a reason from the data box outside it reaches the client as
# `the read failed`.
READ_REASONS=(
  'a release step is running'
  'a rehearsal is running'
  'the read-only transaction check failed'
  'the read timed out'
  'insufficient headroom (disk)'
  'insufficient headroom (memory)'
  'copy behind prod'
  'copy exited before promotion'
  'copy did not promote in time'
  'archive check failed'
  'the read failed'
)
# The recipient certificate, installed with the tooling tree (tools/deploy/lib/remote.mjs
# INSTALLED_TREE_DIR) from the committed infra/deploy/keys/prod-read-recipient.pem.
READ_RECIPIENT=$ROOT/usr/local/lib/ds-platform/tree/infra/deploy/keys/prod-read-recipient.pem
# The hop to ds-data-prod, as the release driver takes it (tools/deploy/lib/remote.mjs
# DATA_PROD_HOP_KEY / DATA_PROD_HOP_KNOWN_HOSTS, tools/deploy/prod.mjs VPC_IP).
DATA_PROD_HOP_KEY=$ROOT/home/deploy/.ssh/data-prod-hop
DATA_PROD_HOP_KNOWN_HOSTS=$ROOT/home/deploy/.ssh/known_hosts
DATA_PROD_ADDRESS=$(override DS_ENTRYPOINT_DATA_PROD_ADDRESS 192.168.0.10)
READ_HOP_TIMEOUT=$(override DS_ENTRYPOINT_READ_HOP_TIMEOUT 180)
# #3662: the key custody's box side and the custodians of the installed tree.
DS_RECOVERY=$ROOT/usr/local/lib/ds-platform/ds-recovery
[[ -z $ROOT ]] || export DS_RECOVERY_ROOT=$ROOT
RECOVERY_CUSTODIANS=$ROOT/usr/local/lib/ds-platform/tree/infra/deploy/recovery/custodians.txt
# The status lines a recovery verb may print; any other line from a box is dropped.
RECOVERY_LINE_RE='^(api-prod|data-prod) (MATCH|MISSING|STORED [0-9]{8}T[0-9]{6}Z members [0-9]{1,3}|STALE [0-9]{1,5}d|MISMATCH [A-Za-z0-9_.:-]{1,80})$'
# A ds-recovery refusal or failure: its own fixed text, bounded.
RECOVERY_REASON_RE='^ds-recovery: [A-Za-z0-9 #().,:/_-]{1,200}$'
# #3648: the rehearsal's input — the SHA's tree from codeload, as the -driver unit
# downloads it, once GitHub says the SHA is contained in `main`.
CODELOAD=$(override DS_ENTRYPOINT_CODELOAD https://codeload.github.com/doctor-school/ds-platform/tar.gz)
GITHUB_API=$(override DS_ENTRYPOINT_GITHUB_API https://api.github.com/repos/doctor-school/ds-platform)
MAX_REHEARSE_BYTES=$((16 * 1024 * 1024))
# The state words of the rehearsal answers, the one plaintext a rehearsal prints.
REHEARSAL_STATE_RE='^(started|running|no pending migrations|succeeded|failed|absent)$'
# #4067: a release's journal — this box's step status files (ds-release STATE_ROOT) and
# the driver's failure notes (release-driver MANIFEST_DIR); each unit's tail is bounded.
JOURNALCTL=$(override DS_ENTRYPOINT_JOURNALCTL journalctl)
RELEASE_STATUS_DIR=$ROOT/var/lib/ds-platform/release/prod
RELEASE_FAILURE_DIR=$ROOT/var/lib/ds-platform/release-driver
JOURNAL_LINES=400
JOURNAL_MAX_BYTES=$((256 * 1024))
JOURNAL_MAX_STEP_UNITS=8

read_fail() {
  printf '%s: %s\n' "$TAG" "$1" >&2
  exit 1
}

# One of READ_REASONS, else `the read failed`.
read_reason() {
  local reason
  for reason in "${READ_REASONS[@]}"; do
    [[ $1 == "$reason" ]] && { printf '%s' "$reason"; return 0; }
  done
  printf 'the read failed'
}

# One data verb over the hop, stdin closed; its stdout and stderr are the caller's.
data_prod_hop() {
  timeout "$READ_HOP_TIMEOUT" ssh -n -i "$DATA_PROD_HOP_KEY" -o IdentitiesOnly=yes -o BatchMode=yes \
    -o StrictHostKeyChecking=yes -o "UserKnownHostsFile=$DATA_PROD_HOP_KNOWN_HOSTS" \
    -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
    "deploy@$DATA_PROD_ADDRESS" "$1"
}

# One data verb over the hop with the caller's stdin (recovery-put).
data_prod_hop_in() {
  timeout "$READ_HOP_TIMEOUT" ssh -i "$DATA_PROD_HOP_KEY" -o IdentitiesOnly=yes -o BatchMode=yes \
    -o StrictHostKeyChecking=yes -o "UserKnownHostsFile=$DATA_PROD_HOP_KNOWN_HOSTS" \
    -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
    "deploy@$DATA_PROD_ADDRESS" "$1"
}

# A read never runs beside a release step: `ds-release check prod` here (the migrate
# step, the -driver and -rollback units), then `check` on ds-data-prod (its up and
# backup units). ds-release refuses with 3 while a ds-prod-* unit runs.
read_release_check() {
  local rc=0
  [[ -x $DS_RELEASE ]] || refuse "ds-release is not installed"
  sudo "$DS_RELEASE" check prod >/dev/null 2>&1 </dev/null || rc=$?
  case $rc in 0) ;; 3) read_fail "a release step is running" ;; *) read_fail "the read failed" ;; esac
  data_prod_hop check >/dev/null 2>&1 || rc=$?
  case $rc in 0) ;; 3) read_fail "a release step is running" ;; 124) read_fail "the read timed out" ;; *) read_fail "the read failed" ;; esac
}

read_workdir() {
  [[ -n ${read_work:-} ]] && return 0
  read_work=$(mktemp -d) # global: the EXIT trap outlives this function; root-only (0700)
  trap 'rm -rf -- "${read_work:-}"' EXIT
}

# The verb's whole answer, encrypted to READ_RECIPIENT (CMS AuthEnvelopedData,
# AES-256-GCM, DER): only the ciphertext reaches stdout. argv: the data request, then
# optionally the file the hop sends as its stdin.
read_encrypted() {
  local data_request=$1 stdin_file=${2-} data_verb=${1%% *} rc=0 reason
  read_workdir
  if [[ -n $stdin_file ]]; then
    data_prod_hop_in "$data_request" <"$stdin_file" >"$read_work/answer.json" 2>"$read_work/stderr" || rc=$?
  else
    data_prod_hop "$data_request" >"$read_work/answer.json" 2>"$read_work/stderr" || rc=$?
  fi
  case $rc in
    0) ;;
    1)
      reason=$(sed -n "s/^$DATA_TAG: //p" "$read_work/stderr" | tail -n 1)
      read_fail "$(read_reason "$reason")"
      ;;
    2)
      reason=$(sed -n "s/^$DATA_TAG: rejected: //p" "$read_work/stderr" | tail -n 1)
      [[ $data_verb == read-observe && $reason =~ $OBSERVE_REJECT_RE ]] && reject "$reason"
      refuse "ds-data-prod does not serve $data_verb (the next release installs it)"
      ;;
    3) refuse "ds-data-prod does not serve $data_verb (the next release installs it)" ;;
    124) read_fail "the read timed out" ;;
    *) read_fail "the read failed" ;;
  esac
  [[ -s $read_work/answer.json ]] || read_fail "the read failed"
  [[ $data_verb != rehearse && $data_verb != rehearse-restore && $data_verb != rehearsal-status ]] ||
    rehearsal_state "$read_work/answer.json"
  encrypt_answer
}

# The answer in read_work/answer.json, encrypted to READ_RECIPIENT: only the ciphertext
# reaches stdout.
encrypt_answer() {
  openssl cms -encrypt -binary -aes-256-gcm -outform DER -in "$read_work/answer.json" \
    -out "$read_work/result.cms" "$READ_RECIPIENT" >/dev/null 2>&1 ||
    refuse "openssl cannot encrypt to the recipient certificate"
  cat -- "$read_work/result.cms"
}

# observe's parameters (#3647): at most MAX_OBSERVE_PARAMS_BYTES, one JSON object (empty
# reads as {}), into the root-only work dir; the data box checks every field.
observe_params() {
  local size
  read_workdir
  head -c "$((MAX_OBSERVE_PARAMS_BYTES + 1))" >"$read_work/params.json"
  size=$(stat -c %s -- "$read_work/params.json")
  ((size <= MAX_OBSERVE_PARAMS_BYTES)) || reject "the parameters exceed $MAX_OBSERVE_PARAMS_BYTES bytes"
  python3 -I -c 'import json,sys; raw=open(sys.argv[1],"rb").read(); sys.exit(0 if not raw.strip() or isinstance(json.loads(raw), dict) else 1)' \
    "$read_work/params.json" 2>/dev/null || reject "the parameters are not one JSON object"
}

# --- the migration rehearsal (Issue #3648; spec §5 «Migration rehearsal.») ----------
# The answer's state word, the one plaintext line (stderr) of a rehearsal verb; an
# answer without one of REHEARSAL_STATE_RE is a failed read.
rehearsal_state() {
  local state
  state=$(python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["state"] if isinstance(d,dict) and isinstance(d.get("state"),str) else "")' \
    "$1" 2>/dev/null) || state=
  [[ $state =~ $REHEARSAL_STATE_RE ]] || read_fail "the read failed"
  printf '%s: state %s\n' "$TAG" "$state" >&2
}

# Tree provenance, as the box-side rollback refusal checks it (release-driver
# compare_status): compare refs/heads/main...<sha> (the branch, never a tag named
# `main`) must be `behind` (an ancestor of main) or
# `identical`; anything else — `ahead`, `diverged`, a 404, a rate limit, a network
# error — is refused (fail closed): a rehearsal runs reviewed migration SQL only.
rehearse_on_main() {
  local body status
  body=$(curl -fsS --proto '=https' --max-time 30 -H 'Accept: application/vnd.github+json' \
    "$GITHUB_API/compare/refs/heads/main...$1" 2>/dev/null) ||
    reject "cannot confirm $1 is contained in main (GitHub compare unavailable)"
  status=$(printf '%s' "$body" |
    python3 -I -c 'import json,sys; d=json.load(sys.stdin); print(d.get("status","") if isinstance(d,dict) else "")' \
      2>/dev/null) || status=
  case $status in
    behind | identical) ;;
    *) reject "$1 is not contained in main (compare status: ${status:-unknown})" ;;
  esac
}

# The SHA's codeload tree, as root; only apps/api/drizzle/*.sql and
# meta/_journal.json go on, checked member by member like `ship` (no absolute or ..
# path, regular files only, at most MAX_REHEARSE_BYTES), repacked as drizzle/....
read -r -d '' REHEARSE_ARCHIVE_PY <<'PY' || true
import io, re, sys, tarfile
src, dest, cap = sys.argv[1], sys.argv[2], int(sys.argv[3])
SQL = re.compile(r"apps/api/drizzle/([A-Za-z0-9_]{1,128}\.sql)")
JOURNAL = "apps/api/drizzle/meta/_journal.json"
def stop(reason):
    sys.stdout.write(reason + "\n")
    sys.exit(1)
picked, total = [], 0
try:
    with tarfile.open(src, mode="r:gz") as tar:
        for m in tar:
            parts = m.name.split("/")
            if m.name.startswith("/") or ".." in parts:
                stop("the tree holds an absolute or .. path")
            rest = "/".join(p for p in parts[1:] if p not in ("", "."))
            sql = SQL.fullmatch(rest)
            if not (sql or rest == JOURNAL):
                continue
            if not m.isreg():
                stop("a migration member is not a regular file")
            total += m.size
            if total > cap:
                stop("the migrations exceed the archive cap")
            name = "drizzle/" + (sql.group(1) if sql else "meta/_journal.json")
            picked.append((name, tar.extractfile(m).read()))
except (tarfile.TarError, EOFError, OSError):
    stop("the tree is not a readable gzip tar stream")
if not any(n == "drizzle/meta/_journal.json" for n, _ in picked):
    stop("the tree has no migration journal")
with tarfile.open(dest, mode="w:gz") as out:
    for name, data in sorted(picked):
        info = tarfile.TarInfo(name)
        info.size, info.mode = len(data), 0o644
        out.addfile(info, io.BytesIO(data))
PY

rehearse_archive() {
  local sha=$1
  command -v curl >/dev/null || refuse "curl is not installed"
  read_workdir
  curl -fsSL --proto '=https' --retry 3 --max-time 300 --max-filesize $((1024 * 1024 * 1024)) \
    -o "$read_work/tree.tar.gz" "$CODELOAD/$sha" 2>/dev/null || read_fail "the read failed"
  python3 -I -X utf8 -c "$REHEARSE_ARCHIVE_PY" "$read_work/tree.tar.gz" "$read_work/drizzle.tar.gz" \
    "$MAX_REHEARSE_BYTES" >/dev/null 2>&1 || read_fail "the read failed"
  rm -f -- "$read_work/tree.tar.gz"
}

# --- a release's journal (Issue #4067; spec §5 «Prod read verbs.») ------------------
# The step units of <sha12> this box's status file records with an exit code other than
# 0 (a failed step, or one that never ended), unit names checked, at most
# JOURNAL_MAX_STEP_UNITS; nothing for an absent or unreadable file.
read -r -d '' FAILED_STEP_UNITS_PY <<'PY' || true
import json, re, sys
sha12, cap = sys.argv[1], int(sys.argv[2])
unit_re = re.compile(r"ds-prod-%s-[a-z0-9-]{1,40}" % re.escape(sha12))
try:
    doc = json.load(sys.stdin)
    steps = doc.get("steps") if isinstance(doc, dict) else None
except (ValueError, UnicodeDecodeError):
    steps = None
seen = []
for item in steps if isinstance(steps, list) else []:
    unit = item.get("unit") if isinstance(item, dict) else None
    if isinstance(unit, str) and unit_re.fullmatch(unit) and item.get("rc") != 0 and unit not in seen:
        seen.append(unit)
print("\n".join(seen[-cap:]))
PY

# The last <max> bytes of stdin (argv: max), read in chunks so memory stays bounded. Not
# `tail -c`: uutils coreutils' tail (the default on Ubuntu 26.04) keeps whole pipe reads
# and answers past the bound when the writer's output arrives in small writes.
read -r -d '' TAIL_BYTES_PY <<'PY' || true
import sys
limit, kept = int(sys.argv[1]), b""
while True:
    chunk = sys.stdin.buffer.read(65536)
    if not chunk:
        break
    kept = (kept + chunk)[-limit:]
sys.stdout.buffer.write(kept)
PY

# The answer (argv: sha, the work dir, the line and byte bounds, the units): each unit's
# tail, and the failure note as the driver recorded it (null when absent or not JSON).
# #4280: the secret units print fixed status lines and pgBackRest's own errors, never a
# value; a line that still reads as a NAME=value assignment is dropped all the same.
read -r -d '' RELEASE_JOURNAL_PY <<'PY' || true
import datetime, json, os, re, sys
sha, work, max_lines, max_bytes = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
SECRET_UNIT = re.compile(r"ds-prod-[0-9a-f]{12}-(data|api)-secret")
ASSIGNMENT = re.compile(r"(?<![A-Za-z0-9_-])[A-Z][A-Z0-9_]{2,}=")
units = []
for i, unit in enumerate(sys.argv[5:]):
    try:
        raw = open(os.path.join(work, "unit-%d.log" % i), "rb").read()
    except OSError:
        raw = b""
    cut = len(raw) >= max_bytes
    lines = raw.decode("utf-8", "replace").splitlines()
    if cut and lines:
        lines = lines[1:]  # the byte bound cut the first line
    cut = cut or len(lines) >= max_lines
    if SECRET_UNIT.fullmatch(unit):
        lines = [l for l in lines if not ASSIGNMENT.search(l)]
    units.append({"unit": unit, "lines": lines, "truncated": cut})
try:
    with open(os.path.join(work, "failure"), "rb") as f:
        failure = json.load(f)
except (OSError, ValueError, UnicodeDecodeError):
    failure = None
json.dump({
    "verb": "release-journal",
    "sha": sha,
    "takenAt": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "failure": failure,
    "units": units,
}, sys.stdout, separators=(",", ":"))
PY

release_journal() {
  local sha=$1 i=0 unit
  local -a units steps match
  read_workdir
  mapfile -t steps < <({ sudo cat "$RELEASE_STATUS_DIR/$sha.json" 2>/dev/null || true; } |
    python3 -I -c "$FAILED_STEP_UNITS_PY" "${sha:0:12}" "$JOURNAL_MAX_STEP_UNITS" 2>/dev/null || true)
  units=("ds-prod-${sha:0:12}-driver")
  for unit in "${steps[@]}"; do
    if [[ -n $unit ]]; then units+=("$unit"); fi
  done
  for unit in "${units[@]}"; do
    # #4124: the driver unit is read by its own identifier — the driver's output and its
    # children's — so the audit lines of its sudo calls never fill the 400-line window.
    match=()
    if [[ $unit == "${units[0]}" ]]; then match=(-t release-driver); fi
    { sudo "$JOURNALCTL" -u "$unit" "${match[@]}" -n "$JOURNAL_LINES" -o short-iso -q --no-pager </dev/null 2>/dev/null || true; } |
      python3 -I -c "$TAIL_BYTES_PY" "$JOURNAL_MAX_BYTES" >"$read_work/unit-$i.log"
    i=$((i + 1))
  done
  # #4280: the SHA's secret rotation units — api-secret on this box, data-secret on
  # ds-data-prod over the hop (a data box that predates read-secret-journal answers none).
  units+=("ds-prod-${sha:0:12}-api-secret")
  { sudo "$JOURNALCTL" -u "${units[-1]}" -n "$JOURNAL_LINES" -o short-iso -q --no-pager </dev/null 2>/dev/null || true; } |
    python3 -I -c "$TAIL_BYTES_PY" "$JOURNAL_MAX_BYTES" >"$read_work/unit-$i.log"
  i=$((i + 1))
  units+=("ds-prod-${sha:0:12}-data-secret")
  { data_prod_hop "read-secret-journal $sha" 2>/dev/null || true; } |
    python3 -I -c "$TAIL_BYTES_PY" "$JOURNAL_MAX_BYTES" >"$read_work/unit-$i.log"
  { sudo cat "$RELEASE_FAILURE_DIR/$sha.failure" 2>/dev/null || true; } | head -c 4096 >"$read_work/failure"
  python3 -I -X utf8 -c "$RELEASE_JOURNAL_PY" "$sha" "$read_work" "$JOURNAL_LINES" "$JOURNAL_MAX_BYTES" \
    "${units[@]}" >"$read_work/answer.json" 2>/dev/null || read_fail "the read failed"
  [[ -s $read_work/answer.json ]] || read_fail "the read failed"
  encrypt_answer
}

# --- the host state (Issue #4144; spec §5 «Prod read verbs.») -----------------------
# HOST_STATE_PY is one probe for both prod boxes: ds-deploy-entrypoint carries the same
# text for ds-data-prod's half, the data verb `read-host-state` (pinned equal by the
# tests). argv: role (api|data), the root prefix, the data compose dir (unused here).
read -r -d '' HOST_STATE_PY <<'PY' || true
import datetime, ipaddress, json, os, re, shutil, subprocess, sys
role, root, compose = sys.argv[1], sys.argv[2], sys.argv[3]
FILES = {"uptime": "/proc/uptime", "resolv": "/etc/resolv.conf", "hosts": "/etc/hosts"}
PROBE_NAME = "s3.twcstorage.ru"
PG_VOLUME = "ds-data-prod_pgdata"
HOST_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9.-]{0,252}")
ISO_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z")
WAL_RE = re.compile(r"[0-9A-F]{8}(\.history|[0-9A-F]{16}(\.partial|\.[0-9A-F]{8}\.backup)?)")
VERSION_RE = re.compile(r"pgBackRest [0-9][0-9A-Za-z.-]{0,31}")
UTC = "AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"'"
ARCHIVER_SQL = (
    "SELECT archived_count, failed_count, "
    "coalesce(to_char(last_archived_time %s), ''), coalesce(to_char(last_failed_time %s), ''), "
    "coalesce(last_failed_wal, '') FROM pg_stat_archiver" % (UTC, UTC)
)

def err(reason):
    return {"error": reason}

def text(name, limit=1 << 20):
    with open(root + FILES[name], "rb") as f:
        return f.read(limit).decode("utf-8", "replace")

def run(argv, timeout, cwd=None):
    try:
        p = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, timeout=timeout, cwd=cwd)
    except (OSError, subprocess.SubprocessError):
        return None
    return p.stdout[:65536].decode("utf-8", "replace") if p.returncode == 0 else None

def ips(tokens):
    out = []
    for token in tokens:
        try:
            ip = str(ipaddress.ip_address(token.split("#")[0]))
        except ValueError:
            continue
        if ip not in out:
            out.append(ip)
    return out[:16]

def uptime():
    try:
        return {"seconds": int(float(text("uptime").split()[0]))}
    except (OSError, ValueError, IndexError):
        return err("uptime unreadable")

def resolver():
    try:
        ns = ips(w[1] for w in (l.split() for l in text("resolv").splitlines()) if len(w) >= 2 and w[0] == "nameserver")
    except OSError:
        ns = err("resolv.conf unreadable")
    up = None
    if shutil.which("resolvectl"):
        out = run(["resolvectl", "dns"], 5)
        up = err("resolvectl failed") if out is None else ips(out.split())
    resolves = run(["getent", "hosts", PROBE_NAME], 5) is not None
    return {"nameservers": ns, "upstream": up, "probeName": PROBE_NAME, "probeResolves": resolves}

def self_hostname():
    name = (run(["hostname"], 5) or "").strip()
    if not HOST_RE.fullmatch(name):
        return err("hostname unusable")
    try:
        lines = text("hosts").splitlines()
        in_hosts = any(name in l.split("#", 1)[0].split()[1:] for l in lines)
    except OSError:
        in_hosts = err("/etc/hosts unreadable")
    return {"hostname": name, "getentResolves": run(["getent", "hosts", name], 5) is not None, "inEtcHosts": in_hosts}

def volume(path):
    try:
        st = os.statvfs(path)
        mount = os.path.realpath(path)
        while not os.path.ismount(mount):
            mount = os.path.dirname(mount)
    except OSError:
        return err("statvfs failed")
    return {
        "mount": mount,
        "bytesTotal": st.f_blocks * st.f_frsize,
        "bytesUsed": (st.f_blocks - st.f_bfree) * st.f_frsize,
        "bytesFree": st.f_bavail * st.f_frsize,
        "inodesTotal": st.f_files,
        "inodesUsed": st.f_files - st.f_ffree,
        "inodesFree": st.f_favail,
    }

def disk():
    out = {"root": volume(root + "/")}
    if role == "data":
        path = (run(["docker", "volume", "inspect", "--format", "{{.Mountpoint}}", PG_VOLUME], 30) or "").strip()
        out["postgresData"] = volume(path) if path.startswith("/") and "\n" not in path else err("postgres volume not found")
    return out

def archiver():
    out = run(["docker", "compose", "exec", "-T", "postgres", "psql", "-v", "ON_ERROR_STOP=1", "-qAt",
               "-U", "ds", "-d", "ds_prod", "-c", ARCHIVER_SQL], 30, compose)
    f = (out or "").strip().split("|")
    if out is None or len(f) != 5 or not (f[0].isdigit() and f[1].isdigit()):
        return err("pg_stat_archiver read failed")
    when = lambda v: v if ISO_RE.fullmatch(v) else None
    return {
        "archivedCount": int(f[0]),
        "failedCount": int(f[1]),
        "lastArchivedTime": when(f[2]),
        "lastFailedTime": when(f[3]),
        "lastFailedWal": f[4] if WAL_RE.fullmatch(f[4]) else None,
    }

def pgbackrest():
    lines = (run(["docker", "compose", "exec", "-T", "postgres", "pgbackrest", "version"], 30, compose) or "").strip().splitlines()
    return {"version": lines[0]} if lines and VERSION_RE.fullmatch(lines[0]) else err("pgbackrest version failed")

# #4280: each offsite repo's endpoint (argv[4:], "<n>=<endpoint>" as the data verb read
# them): one anonymous HTTPS request by curl, -q so no curlrc and no credential goes
# along, capped at 8 s; its TCP and TLS phase times classify a failure.
ENDPOINT_RE = re.compile(r"(?:https://)?([A-Za-z0-9][A-Za-z0-9.-]{0,252}(?::[0-9]{1,5})?)/?")
CURL_W = "%{http_code} %{time_connect} %{time_appconnect}"

def reach(host):
    try:
        p = subprocess.run(["curl", "-q", "-s", "-o", "/dev/null", "--max-time", "8", "--proto", "=https",
                            "-w", CURL_W, "https://%s/" % host], stdin=subprocess.DEVNULL,
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=12)
    except subprocess.TimeoutExpired:
        return "timeout", None
    f = p.stdout[:256].decode("ascii", "replace").split()
    num = lambda i: float(f[i]) if len(f) > i and re.fullmatch(r"[0-9]+(\.[0-9]+)?", f[i]) else 0.0
    code = int(num(0))
    http = code if 100 <= code <= 599 else None
    if p.returncode == 6:
        return "dns-fail", None
    if num(2) > 0:
        return "reachable", http
    if p.returncode == 28:
        return "timeout", None
    return ("tls-fail" if num(1) > 0 else "tcp-refused"), None

def offsite():
    out = []
    for arg in sys.argv[4:]:
        n, _, endpoint = arg.partition("=")
        m = ENDPOINT_RE.fullmatch(endpoint)
        if n in ("2", "3") and m:
            state, http = reach(m.group(1))
            out.append({"repo": int(n), "host": m.group(1), "state": state, "http": http})
    return out

def safe(probe):
    try:
        return probe()
    except Exception:
        return err("probe failed")

answer = {
    "role": role,
    "takenAt": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "uptime": safe(uptime),
    "resolver": safe(resolver),
    "selfHostname": safe(self_hostname),
    "disk": safe(disk),
}
if role == "data":
    answer["archiver"] = safe(archiver)
    answer["pgbackrest"] = safe(pgbackrest)
    answer["offsite"] = safe(offsite)
json.dump(answer, sys.stdout, separators=(",", ":"))
PY

# The answer (argv: the work dir, the hop's exit code): ds-api-prod's half from
# api.json, ds-data-prod's from data.json. Each half is held to the closed field list
# (prod-read.mjs HOST_STATE_FIELDS) with every value to its own pattern and every error
# to the probe's fixed set; a half that is not passes as one fixed reason, so nothing
# but the listed fields leaves.
read -r -d '' HOST_STATE_JOIN_PY <<'PY' || true
import datetime, json, os, re, sys
work, rc = sys.argv[1], int(sys.argv[2])
NOT_SERVED = "ds-data-prod does not serve read-host-state (the next release installs it)"
HOP_REASONS = {2: NOT_SERVED, 3: NOT_SERVED, 124: "the read timed out", 255: "ds-data-prod is unreachable"}
ERRORS = {
    "uptime unreadable", "resolv.conf unreadable", "resolvectl failed", "hostname unusable",
    "/etc/hosts unreadable", "statvfs failed", "postgres volume not found",
    "pg_stat_archiver read failed", "pgbackrest version failed", "probe failed",
}
def pattern(rx):
    rx = re.compile(rx)
    return lambda v: isinstance(v, str) and rx.fullmatch(v) is not None
nat = lambda v: isinstance(v, int) and not isinstance(v, bool) and v >= 0
flag = lambda v: isinstance(v, bool)
opt = lambda check: (lambda v: v is None or check(v))
ip = pattern(r"[0-9A-Fa-f:.]{2,45}")
ips = lambda v: isinstance(v, list) and len(v) <= 16 and all(ip(x) for x in v)
iso = pattern(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z")
VOLUME = {"mount": pattern(r"/[\x20-\x7e]{0,254}"), "bytesTotal": nat, "bytesUsed": nat, "bytesFree": nat,
          "inodesTotal": nat, "inodesUsed": nat, "inodesFree": nat}
BOX = {
    "uptime": {"seconds": nat},
    "resolver": {"nameservers": ips, "upstream": opt(ips), "probeName": lambda v: v == "s3.twcstorage.ru",
                 "probeResolves": flag},
    "selfHostname": {"hostname": pattern(r"[A-Za-z0-9][A-Za-z0-9.-]{0,252}"), "getentResolves": flag,
                     "inEtcHosts": flag},
}
SCHEMA = {
    "api": dict(BOX, disk={"root": VOLUME}),
    "data": dict(BOX, disk={"root": VOLUME, "postgresData": VOLUME},
                 archiver={"archivedCount": nat, "failedCount": nat, "lastArchivedTime": opt(iso),
                           "lastFailedTime": opt(iso), "lastFailedWal": opt(pattern(r"[0-9A-Za-z.]{8,64}"))},
                 pgbackrest={"version": pattern(r"pgBackRest [0-9][0-9A-Za-z.-]{0,31}")},
                 offsite=lambda v: isinstance(v, list) and len(v) <= 2 and all(isinstance(r, dict) and "error" not in r and ok(r, OFFSITE_REPO) for r in v)),
}
# #4280: one offsite repo's reachability (HOST_STATE_PY offsite()).
OFFSITE_REPO = {"repo": lambda v: v in (2, 3) and not isinstance(v, bool),
                "host": pattern(r"[A-Za-z0-9][A-Za-z0-9.-]{0,252}(:[0-9]{1,5})?"),
                "state": lambda v: v in ("reachable", "tcp-refused", "timeout", "dns-fail", "tls-fail"),
                "http": opt(lambda v: nat(v) and 100 <= v <= 599)}
def ok(value, spec):
    if isinstance(value, dict) and set(value) == {"error"} and value["error"] in ERRORS:
        return True
    if isinstance(spec, dict):
        return isinstance(value, dict) and set(value) == set(spec) and all(ok(value[k], spec[k]) for k in spec)
    return spec(value)
def half(role, name, fallback):
    try:
        with open(os.path.join(work, name), "rb") as f:
            doc = json.loads(f.read(65536))
    except (OSError, ValueError, UnicodeDecodeError):
        doc = None
    spec = SCHEMA[role]
    if (isinstance(doc, dict) and set(doc) == set(spec) | {"role", "takenAt"} and doc["role"] == role
            and iso(doc["takenAt"]) and all(ok(doc[k], spec[k]) for k in spec)):
        return doc
    return {"reachable": False, "reason": fallback}
data = (half("data", "data.json", "the data box answer is not a host-state answer") if rc == 0
        else {"reachable": False, "reason": HOP_REASONS.get(rc, "the read failed")})
json.dump({
    "verb": "host-state",
    "takenAt": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "api": half("api", "api.json", "the probe failed"),
    "data": data,
}, sys.stdout, separators=(",", ":"))
PY

# Both boxes' host state: ds-api-prod's half here, ds-data-prod's over the hop (a VPC
# address: it answers while the box resolver is down). No release check: it reads no
# app data, so it answers during a running or failed release.
host_state() {
  local rc=0
  read_workdir
  sudo python3 -I -X utf8 -c "$HOST_STATE_PY" api "$ROOT" "" >"$read_work/api.json" 2>/dev/null </dev/null || true
  data_prod_hop read-host-state >"$read_work/data.json" 2>/dev/null || rc=$?
  python3 -I -X utf8 -c "$HOST_STATE_JOIN_PY" "$read_work" "$rc" >"$read_work/answer.json" 2>/dev/null </dev/null ||
    read_fail "the read failed"
  [[ -s $read_work/answer.json ]] || read_fail "the read failed"
  encrypt_answer
}

# --- the key custody (Issue #3662; spec §5 «Prod read verbs.») ----------------------
recovery_lines() { grep -E "$RECOVERY_LINE_RE" "$1" || true; }
# The last ds-recovery reason of a file, or the fallback.
recovery_reason() {
  local line
  line=$(grep -E "$RECOVERY_REASON_RE" "$1" | tail -n 1 || true)
  printf '%s' "${line:-$2}"
}
# The verdict of one hop: 0, or the status of a failed hop with its reason on stderr.
recovery_hop_status() { # <rc> <stderr file> <what>
  case $1 in
    0) return 0 ;;
    1) printf '%s: data-prod: %s\n' "$TAG" "$(recovery_reason "$2" "$3 failed")" >&2; return 1 ;;
    2) printf '%s: data-prod: ds-data-prod does not serve the recovery verbs (the next release installs them)\n' "$TAG" >&2; return 3 ;;
    3) printf '%s: data-prod: %s\n' "$TAG" "$(recovery_reason "$2" "$3 refused")" >&2; return 3 ;;
    124) printf '%s: data-prod: %s timed out\n' "$TAG" "$3" >&2; return 1 ;;
    *) printf '%s: data-prod: %s failed\n' "$TAG" "$3" >&2; return 1 ;;
  esac
}
# A local ds-recovery failure: its reason on stderr, its status kept.
recovery_local_status() { # <rc> <stderr file>
  (($1 == 0)) && return 0
  printf '%s: api-prod: %s\n' "$TAG" "$(recovery_reason "$2" "ds-recovery failed")" >&2
  (($1 == 3)) && return 3
  return 1
}

# api-prod: bundle here, store through ds-data-prod (the bucket's credentials live there).
recovery_bundle_api() {
  local w=$recovery_work/api stamp members rc=0
  mkdir -- "$w" # inside the root-only (0700) recovery_work
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  members=$("$DS_RECOVERY" bundle api-prod "$RECOVERY_CUSTODIANS" "$w" "$stamp" 2>"$w/err") || rc=$?
  recovery_local_status "$rc" "$w/err" || return $?
  data_prod_hop_in "recovery-put api-prod ${stamp,,} bundle" <"$w/bundle.tar.age" >/dev/null 2>"$w/err" || rc=$?
  recovery_hop_status "$rc" "$w/err" "storing the api-prod bundle" || return $?
  data_prod_hop_in "recovery-put api-prod ${stamp,,} manifest" <"$w/manifest.json" >/dev/null 2>"$w/err" || rc=$?
  recovery_hop_status "$rc" "$w/err" "storing the api-prod manifest" || return $?
  printf 'api-prod STORED %s members %s\n' "$stamp" "$members" | grep -E "$RECOVERY_LINE_RE"
}
recovery_bundle_data() {
  local w=$recovery_work/data rc=0
  mkdir -- "$w" # inside the root-only (0700) recovery_work
  data_prod_hop recovery-bundle >"$w/out" 2>"$w/err" || rc=$?
  recovery_lines "$w/out"
  recovery_hop_status "$rc" "$w/err" "the data-prod bundle"
}
recovery_check_api() {
  local w=$recovery_work/api rc=0
  mkdir -- "$w" # inside the root-only (0700) recovery_work
  "$DS_RECOVERY" custodians "$RECOVERY_CUSTODIANS" 2>"$w/err" || rc=$?
  recovery_local_status "$rc" "$w/err" || return $?
  data_prod_hop "recovery-latest api-prod" >"$w/latest.json" 2>"$w/err" || rc=$?
  recovery_hop_status "$rc" "$w/err" "reading the api-prod manifest" || return $?
  if [[ $(head -c 7 "$w/latest.json") == MISSING ]]; then
    echo "api-prod MISSING"
    return 1
  fi
  "$DS_RECOVERY" check api-prod "$RECOVERY_CUSTODIANS" "$w/latest.json" >"$w/out" 2>"$w/err" || rc=$?
  recovery_lines "$w/out"
  # 1 with status lines is a verdict (MISMATCH / STALE), not a failure of the check.
  if ((rc == 1)) && [[ -n $(recovery_lines "$w/out") ]]; then return 1; fi
  recovery_local_status "$rc" "$w/err"
}
recovery_check_data() {
  local w=$recovery_work/data rc=0
  mkdir -- "$w" # inside the root-only (0700) recovery_work
  data_prod_hop recovery-check >"$w/out" 2>"$w/err" || rc=$?
  recovery_lines "$w/out"
  if ((rc == 1)) && [[ -n $(recovery_lines "$w/out") ]]; then return 1; fi
  recovery_hop_status "$rc" "$w/err" "the data-prod check"
}
# Both boxes, always both: the verb's status is the worse of the two (3 > 1 > 0).
recovery_verb() {
  local api=0 data=0
  [[ -x $DS_RECOVERY ]] || refuse "ds-recovery is not installed (the next release installs it)"
  recovery_work=$(mktemp -d) # global: the EXIT trap outlives this function; root-only (0700)
  trap 'rm -rf -- "${recovery_work:-}"' EXIT
  "recovery_$1_api" || api=$?
  "recovery_$1_data" || data=$?
  ((api == 3 || data == 3)) && exit 3
  ((api == 0 && data == 0)) || exit 1
}

# sudo admits this file with no arguments only; anything else is not the read key.
(($# == 0)) || reject "unexpected arguments"
[[ -n $request ]] || reject "no command (this key runs only the read commands)"
[[ ${#request} -le $COMMAND_MAX && $request =~ $COMMAND_RE ]] ||
  reject "unexpected characters in the command"
IFS=' ' read -r -a words <<<"$request"
verb=${words[0]-}

case "$verb" in
  capabilities | schema | host-state | recovery-bundle | recovery-check) [[ ${#words[@]} -eq 1 ]] || reject "usage: $verb" ;;
  observe)
    [[ ${#words[@]} -eq 2 && ${words[1]} =~ $OBSERVE_NAME_RE ]] || reject "usage: observe <name>" ;;
  rehearse | rehearse-restore | rehearsal-status | release-journal)
    [[ ${#words[@]} -eq 2 && ${words[1]} =~ $SHA_RE ]] || reject "usage: $verb <sha> (the full 40-hex commit id)" ;;
  *) reject "unknown read command (allowed: ${READ_VERBS// /, })" ;;
esac
accepted
role=$(sudo cat "$BOX_ROLE_FILE" 2>/dev/null || true)
[[ $role == prod ]] || refuse "the read commands are served by the prod box only"
case "$verb" in
  capabilities)
    printf '{"role":"prod","mode":"read","verbs":["%s"]}\n' "${READ_VERBS// /\",\"}" ;;
  schema)
    sudo test -f "$READ_RECIPIENT" || refuse "the read-result recipient certificate is not installed"
    read_release_check
    read_encrypted read-schema </dev/null ;;
  observe)
    sudo test -f "$READ_RECIPIENT" || refuse "the read-result recipient certificate is not installed"
    observe_params
    read_release_check
    read_encrypted "read-observe ${words[1]}" "$read_work/params.json" </dev/null ;;
  rehearse | rehearse-restore)
    sudo test -f "$READ_RECIPIENT" || refuse "the read-result recipient certificate is not installed"
    read_release_check
    rehearse_on_main "${words[1]}"
    rehearse_archive "${words[1]}"
    read_encrypted "$verb ${words[1]}" "$read_work/drizzle.tar.gz" </dev/null ;;
  rehearsal-status)
    # Reads no database: no release check; it always answers.
    sudo test -f "$READ_RECIPIENT" || refuse "the read-result recipient certificate is not installed"
    read_encrypted "rehearsal-status ${words[1]}" </dev/null ;;
  release-journal)
    # Reads no database: no release check; a running release's journal is read too.
    sudo test -f "$READ_RECIPIENT" || refuse "the read-result recipient certificate is not installed"
    release_journal "${words[1]}" </dev/null ;;
  host-state)
    # Reads no app data: no release check; it answers during a running or failed release.
    sudo test -f "$READ_RECIPIENT" || refuse "the read-result recipient certificate is not installed"
    host_state </dev/null ;;
  recovery-bundle | recovery-check)
    read_release_check
    recovery_verb "${verb#recovery-}" </dev/null ;;
esac
