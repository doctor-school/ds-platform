#!/usr/bin/env bash
# ds-release — durable box release steps (Issue #2982; tech spec
# apps/docs/content/specs/tech/2026-10-16-release-pipeline-off-workstation-en.md §5).
#
# Every long box step of a release (pull, backup, migrate, up, prune) runs in its
# own transient systemd unit, so the death of the caller — a killed ssh client, a
# cancelled runner, a sleeping workstation — never kills the step. The caller
# starts or attaches with `release`, then polls `status`; it never streams the
# step. The status file is the authority; the unit's journal keeps the full log.
#
#   ds-release release [--retry-failed] <env> <sha> <step> <script-file>
#   ds-release status  <env> <sha>
#   ds-release finish  <env> <sha> succeeded|failed
#   ds-release forget  <env>
#
# <env> is prod, stage-main or stage-pr-<N>. Installed as /usr/local/bin/ds-release
# from the shipped tree (infra/deploy/bin/ds-release) at the start of every
# operator run; run through sudo.
#
# Exit codes: 0 ok · 1 the step failed · 2 usage · 3 refused (lock, lease, live unit).
set -euo pipefail

STATE_ROOT=${DS_RELEASE_STATE_ROOT:-/var/lib/ds-platform/release}
LOCK_DIR=${DS_RELEASE_LOCK_DIR:-/run/lock}
SELF=${DS_RELEASE_SELF:-/usr/local/bin/ds-release}

ENV_RE='^(prod|stage-main|stage-pr-[1-9][0-9]*)$'
SHA_RE='^[0-9a-f]{40}$'
STEP_RE='^[a-z][a-z0-9-]{0,31}$'
USER_RE='^[a-z_][a-z0-9_-]*$'

say() { printf 'ds-release: %s\n' "$*"; }
usage() { printf 'ds-release: %s\n' "$*" >&2; exit 2; }
refuse() { printf 'ds-release: refused: %s\n' "$*" >&2; exit 3; }
fail() { printf 'ds-release: %s\n' "$*" >&2; exit 1; }

check_env() { [[ $1 =~ $ENV_RE ]] || usage "bad env: $1 (want prod, stage-main or stage-pr-<N>)"; }
check_sha() { [[ $1 =~ $SHA_RE ]] || usage "bad sha: $1 (want the full 40-hex commit id)"; }
check_step() { [[ $1 =~ $STEP_RE ]] || usage "bad step: $1"; }

unit_name() { printf 'ds-%s-%s-%s' "$1" "${2:0:12}" "$3"; }
env_dir() { printf '%s/%s' "$STATE_ROOT" "$1"; }

# The env lease: every mutating call holds the env lock for its whole (short)
# life. `status` only reads a file that is replaced atomically, so it takes none.
take_lock() {
  mkdir -p "$LOCK_DIR"
  exec 9>"$LOCK_DIR/ds-$1.lock"
  flock -n 9 || refuse "env $1 is busy: another ds-release call holds $LOCK_DIR/ds-$1.lock"
}

# Alive = the step's process still runs. With --remain-after-exit a finished
# unit stays `active (exited)`, so ActiveState alone cannot tell; a unit systemd
# no longer knows (a reboot) reads `inactive/dead`.
unit_alive() {
  local active sub
  active=$(systemctl show -p ActiveState --value "$1" 2>/dev/null || true)
  sub=$(systemctl show -p SubState --value "$1" 2>/dev/null || true)
  case "$active/$sub" in
    activating/* | deactivating/* | reloading/* | active/running) return 0 ;;
  esac
  return 1
}

# Stop/reset a unit — only when it is no longer running. Callers hold the lock.
reap_unit() {
  unit_alive "$1" && return 0
  systemctl stop "$1" >/dev/null 2>&1 || true
  systemctl reset-failed "$1" >/dev/null 2>&1 || true
}

# The finished units of one env, except those of the SHA `$2` (empty = all).
reap_env_units() {
  local env=$1 keep=$2 unit re="^ds-$1-[0-9a-f]{12}-[a-z][a-z0-9-]*\.service\$"
  while read -r unit _; do
    [[ $unit =~ $re ]] || continue
    [[ -n $keep && $unit == "ds-$env-$keep-"* ]] && continue
    reap_unit "$unit"
  done < <(systemctl list-units --all --plain --no-legend --type=service "ds-$env-*" 2>/dev/null || true)
}

# The status file (§5 shape) is read and written only here. Every write goes to
# `<file>.tmp`, is fsync'ed, renamed over the file and the directory fsync'ed, so a
# reader — or a box that loses power — sees either the previous or the next
# complete document, never a torn one.
js() {
  python3 - "$@" <<'PY'
import glob, json, os, sys, time

op, args = sys.argv[1], sys.argv[2:]

def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())

def load(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return None

def save(path, doc):
    doc["updatedAt"] = now()
    folder = os.path.dirname(path)
    os.makedirs(folder, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(doc, f, indent=2)
        f.write("\n")
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    if hasattr(os, "O_DIRECTORY"):  # POSIX: make the rename itself durable
        fd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)

def entry(doc, step):
    for item in reversed((doc or {}).get("steps", [])):
        if item["name"] == step:
            return item
    return None

def verdict(item):
    if item is None:
        return "absent"
    if item.get("endedAt") is None:
        return "running"
    return "succeeded" if item.get("rc") == 0 else "failed"

if op == "step-state":  # <file> <step>
    print(verdict(entry(load(args[0]), args[1])))
elif op == "running-step":  # <file> -> "<step> <unit>" of the step still marked running
    for item in (load(args[0]) or {}).get("steps", []):
        if item.get("endedAt") is None:
            print(item["name"], item["unit"])
            break
elif op == "lease":  # <dir> <sha> -> the sha of ANOTHER release still running in this env
    for path in sorted(glob.glob(os.path.join(args[0], "*.json"))):
        doc = load(path)
        if doc and doc.get("sha") != args[1] and doc.get("state") == "running":
            print(doc["sha"])
            break
elif op == "start-step":  # <file> <env> <sha> <step> <unit>
    path, env, sha, step, unit = args
    doc = load(path) or {
        "env": env, "sha": sha, "unit": unit, "state": "running", "step": step,
        "steps": [], "startedAt": now(), "updatedAt": now(), "error": None,
    }
    doc["steps"] = [item for item in doc["steps"] if item["name"] != step]
    doc["steps"].append({"name": step, "unit": unit, "startedAt": now(), "endedAt": None, "rc": None})
    doc.update(state="running", step=step, unit=unit, error=None)
    save(path, doc)
elif op == "end-step":  # <file> <step> <rc> [error]
    path, step, rc = args[:3]
    doc = load(path)
    item = entry(doc, step)
    if item is None:  # forgotten meanwhile: nothing to record against
        sys.exit(0)
    item["endedAt"] = now()
    item["rc"] = int(rc)
    if item["rc"] != 0:
        doc["state"] = "failed"
        doc["error"] = args[3] if len(args) > 3 else "step %s exited %s" % (step, rc)
    save(path, doc)
elif op == "finish":  # <file> succeeded|failed
    path, state = args
    doc = load(path)
    if state == "succeeded":
        bad = [item["name"] for item in doc["steps"] if verdict(item) != "succeeded"]
        if bad:
            sys.stderr.write("ds-release: refused: step(s) without a success verdict: %s\n" % ", ".join(bad))
            sys.exit(3)
        doc["error"] = None
    else:
        doc["error"] = doc.get("error") or "finished as failed by the operator"
    doc["state"] = state
    save(path, doc)
elif op == "show":  # <file> <unitAlive json> -> one line for the poller
    print(json.dumps({"release": load(args[0]), "unitAlive": json.loads(args[1])}, separators=(",", ":")))
else:
    sys.exit("ds-release: unknown js op " + op)
PY
}

caller_user() {
  local user=${SUDO_USER:-$(id -un)}
  [[ $user =~ $USER_RE ]] || usage "unusable caller user: $user"
  printf '%s' "$user"
}

# release: read the status file FIRST. A succeeded step returns its verdict and is
# never re-run (backup and migrate are never repeated); a running one is attached
# to by unit name; a failed one returns `failed` unless --retry-failed; an absent
# one starts.
cmd_release() {
  local retry=0
  if [[ ${1:-} == --retry-failed ]]; then retry=1; shift; fi
  [[ $# -eq 4 ]] || usage "usage: ds-release release [--retry-failed] <env> <sha> <step> <script-file>"
  local env=$1 sha=$2 step=$3 src=$4 dir file unit other state
  check_env "$env"; check_sha "$sha"; check_step "$step"
  take_lock "$env"
  dir=$(env_dir "$env"); file="$dir/$sha.json"; unit=$(unit_name "$env" "$sha" "$step")
  other=$(js lease "$dir" "$sha")
  [[ -z $other ]] || refuse "env $env is leased by release ${other:0:12}, which has not finished;" \
    "re-run that SHA to complete it, or close it: sudo ds-release finish $env $other failed"
  state=$(js step-state "$file" "$step")
  if [[ $state == running ]]; then
    if unit_alive "$unit"; then say "$unit running (attached)"; return 0; fi
    # Under the lock the unit cannot be mid-write: dead and still `running` means
    # it died without recording a verdict (killed, box rebooted).
    js end-step "$file" "$step" -1 "unit $unit ended without recording a verdict"
    state=failed
  fi
  case $state in
    succeeded) say "$unit succeeded (recorded verdict; not re-run)"; return 0 ;;
    failed)
      ((retry)) || fail "$unit failed (recorded verdict; not re-run)." \
        "Fix the cause, then re-run with --retry-failed. Log: sudo journalctl -u $unit"
      ;;
  esac
  start_unit "$env" "$sha" "$step" "$src" "$dir" "$file" "$unit"
}

start_unit() {
  local env=$1 sha=$2 step=$3 src=$4 dir=$5 file=$6 unit=$7 user
  [[ -r $src ]] || usage "script file not readable: $src"
  user=$(caller_user)
  reap_env_units "$env" "${sha:0:12}"
  reap_unit "$unit" # the same name, left behind by the failed run a retry replaces
  install -d -m 0755 "$STATE_ROOT" "$dir"
  install -m 0600 "$src" "$dir/$sha.$step.sh"
  js start-step "$file" "$env" "$sha" "$step" "$unit"
  if ! systemd-run --quiet --unit="$unit" --remain-after-exit -p KillMode=mixed \
    --description="ds-release $env ${sha:0:12} $step" \
    "$SELF" _exec "$env" "$sha" "$step" "$user"; then
    js end-step "$file" "$step" 125 "systemd-run could not start $unit"
    fail "systemd-run could not start $unit"
  fi
  say "$unit started"
}

# _exec: the unit's own process. Runs the step script as the calling operator
# user (the scripts are written for that user's $HOME and its `sudo docker`),
# then records the verdict under the env lock.
cmd_exec() {
  [[ $# -eq 4 ]] || usage "usage: ds-release _exec <env> <sha> <step> <user>"
  local env=$1 sha=$2 step=$3 user=$4 dir file script home rc
  check_env "$env"; check_sha "$sha"; check_step "$step"
  [[ $user =~ $USER_RE ]] || usage "unusable user: $user"
  dir=$(env_dir "$env"); file="$dir/$sha.json"; script="$dir/$sha.$step.sh"
  home=$(getent passwd "$user" | cut -d: -f6 || true)
  [[ -n $home ]] || home=/
  set +e
  if [[ $user == "$(id -un)" ]]; then
    (cd "$home" && HOME=$home bash --norc -euo pipefail -c "$(cat "$script")")
  else
    (cd "$home" && runuser -u "$user" -- env HOME="$home" USER="$user" LOGNAME="$user" \
      bash --norc -euo pipefail -c "$(cat "$script")")
  fi
  rc=$?
  set -e
  exec 9>"$LOCK_DIR/ds-$env.lock"
  flock -w 300 9 || say "env lock not taken within 300s; recording the verdict anyway"
  js end-step "$file" "$step" "$rc"
  exit "$rc"
}

# status: one JSON line — the status file (or null) plus whether the unit of the
# step still marked running is alive. Read-only; the poller prints one line of it.
cmd_status() {
  [[ $# -eq 2 ]] || usage "usage: ds-release status <env> <sha>"
  check_env "$1"; check_sha "$2"
  local file running alive=null
  file="$(env_dir "$1")/$2.json"
  running=$(js running-step "$file")
  if [[ -n $running ]]; then
    if unit_alive "${running#* }"; then alive=true; else alive=false; fi
  fi
  js show "$file" "$alive"
}

# A step marked running whose unit is gone is recorded as failed; one whose unit
# still runs refuses the caller.
settle_running() {
  local file=$1 running
  running=$(js running-step "$file")
  [[ -n $running ]] || return 0
  unit_alive "${running#* }" && refuse "${running#* } is still running"
  js end-step "$file" "${running%% *}" -1 "unit ${running#* } ended without recording a verdict"
}

# finish: close the release once every step and operator-side check is done
# (`succeeded`), or after an operator-side failure (`failed`). Only a finished
# release frees the env for another SHA.
cmd_finish() {
  [[ $# -eq 3 ]] || usage "usage: ds-release finish <env> <sha> succeeded|failed"
  check_env "$1"; check_sha "$2"
  [[ $3 == succeeded || $3 == failed ]] || usage "finish takes succeeded or failed, not $3"
  take_lock "$1"
  local file
  file="$(env_dir "$1")/$2.json"
  [[ -f $file ]] || { say "no release $1 ${2:0:12} recorded; nothing to finish"; return 0; }
  settle_running "$file"
  js finish "$file" "$3"
  say "release $1 ${2:0:12} finished: $3"
}

# forget: drop an env's release state once what it recorded no longer exists — a
# stage slot torn down, or `main` re-cloned. Refused while any step still runs.
cmd_forget() {
  [[ $# -eq 1 ]] || usage "usage: ds-release forget <env>"
  check_env "$1"
  take_lock "$1"
  local dir file
  dir=$(env_dir "$1")
  for file in "$dir"/*.json; do
    [[ -e $file ]] || continue
    settle_running "$file"
  done
  reap_env_units "$1" ""
  rm -rf -- "$dir"
  say "release state of $1 forgotten"
}

main() {
  local cmd=${1:-}
  [[ $# -gt 0 ]] && shift
  case $cmd in
    release) cmd_release "$@" ;;
    status) cmd_status "$@" ;;
    finish) cmd_finish "$@" ;;
    forget) cmd_forget "$@" ;;
    _exec) cmd_exec "$@" ;;
    *) usage "usage: ds-release release|status|finish|forget …" ;;
  esac
}

main "$@"
