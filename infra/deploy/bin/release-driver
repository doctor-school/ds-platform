#!/usr/bin/env bash
# release-driver — the box-side release driver (Issues #2985 stage, #3157 prod; tech
# spec apps/docs/content/specs/tech/2026-10-16-release-pipeline-off-workstation-en.md
# §3 items 2-3, §5 «Entrypoint», «Stage `main` release driver», «Prod release driver»,
# §8 steps (d)-(e)).
#
# The entrypoint's `release <env> <sha>` execs this file with the client's stdin. On
# the stage box it converges the `main` slot to <sha>, on ds-api-prod it releases <sha>
# to production — without an operator machine:
#
#   release-driver <env> <sha>        < images-<sha>.json
#       Validates the env against /etc/ds-platform/box-role and the manifest on
#       stdin; attaches to a running unit of <sha> before anything else is asked;
#       otherwise checks that <sha> is on main (GitHub compare) and that every
#       manifest digest is the one the registry serves for <image>:<sha>, asks
#       ds-release whether another SHA holds the env, saves the manifest root-only
#       and starts the transient unit
#       ds-<env>-<sha12>-driver, then returns: ONE status line on stdout,
#         ds-release-driver: started <unit> | attached <unit> | already-succeeded
#       exit 0. A refusal is one line on stderr and exit 3; usage exit 2.
#   release-driver redeploy prod <sha>       < images-<sha>.json   (#3354)
#       The release of the LIVE prod SHA run again (prod box only), so every
#       container is recreated with the box's current env files: the release's
#       own checks, lease and unit ds-prod-<sha12>-driver, plus <sha> == the live
#       prod SHA (a newer SHA is a release, an older one a rollback — the refusal
#       names the mode), and never `already-succeeded`: a finished run is reset and
#       started again, which ds-release's attempt semantics run as a fresh attempt
#       (its closed attempt is archived). Answers `started <unit>` / `attached <unit>`.
#   release-driver _redeploy prod <sha>   (the redeploy unit's own process)
#       As `_run prod <sha>`, with prod.mjs --local --redeploy (recreates every
#       container of the api compose).
#   release-driver unit-state <env> <sha>
#       One JSON object {"unit", "active", "rc", "previousSha", "failure"} — the
#       entrypoint's `status` adds it to the ds-release status line as `driver`.
#       `failure` (#3439) is null, or {"phase", "reason"}: the phase a failed run of the
#       unit stopped in and the one-line reason it gave, recorded by the unit itself.
#   release-driver record-previous <env> <sha> <previous-sha|none>
#       (called by the unit) Saves the SHA production ran before <sha> — the
#       release-notes basis `unit-state` reports as `previousSha`. The first SHA
#       recorded for <sha> is kept: a re-run after the swap reads <sha> itself.
#   release-driver _run <env> <sha>   (the unit's own process, as the deploy user)
#       Downloads the codeload tarball of exactly <sha>, extracts it and runs
#         stage-main: node <tree>/tools/staging/slot.mjs up main --ref <sha> --local --images-file -
#         prod:       node <tree>/tools/deploy/prod.mjs --local --images-file -
#       — the operator's converge / release, step for step, through the box-local
#       executor (prod: data-prod over the VPC hop, /home/deploy/.ssh/data-prod-hop).
#       `-` reads the inherited fd 0: the manifest is root-only and the unit runs as
#       deploy, so re-opening it as /dev/stdin (via /proc/self/fd/0) is EACCES.
#   release-driver rollback prod <sha>        < images-<sha>.json   (#2987)
#       The box-side app-only rollback (prod box only). Answers `attached <unit>`
#       while its unit runs, and `already-succeeded` when <sha> is already the live
#       prod SHA because its own finished rc-0 unit recorded `succeeded` (a re-run
#       after lost contact, #3219). Otherwise refuses unless the manifest is <sha>'s,
#       <sha> is on main, strictly behind the live prod SHA and the target of one of
#       the latest 3 release-* Releases, its digests are the registry's, a tooling
#       tree is recorded and no release step runs; then starts
#       ds-prod-<sha12>-rollback (its own record, kind `rollback`) and answers
#       `started <unit>`.
#   release-driver rollback-status prod <sha>
#       {"rollback": <record|null>, "driver": {"unit", "active", "rc", "previousSha"},
#        "live": <live prod SHA|null>}.
#   release-driver _rollback prod <sha>   (the rollback unit's process)
#       node <tooling tree>/tools/deploy/prod.mjs --local --rollback <sha> --images-file -
#
# The unit survives the client (systemd-run, KillMode=mixed, --remain-after-exit
# keeps its exit status for `unit-state`); its whole log stays in its journal and
# nothing of it reaches the client, whose stderr is a public Actions log (spec §4).
# PR slots stay operator-driven (spec §3 item 8); a prod hotfix (`--ref`) stays on the
# operator path (`pnpm deploy:prod`), and so does its break-glass `--rollback`.
#
# Installed as /usr/local/lib/ds-platform/release-driver beside ds-release and the
# entrypoint, by the same install step (tools/deploy/lib/remote.mjs BOX_ENTRYPOINTS).
set -euo pipefail
export LC_ALL=C

# The lock directory (#3297; spec §5 «Lock and lease»). A root caller — ds-release on
# every box, the prod release driver — locks in /run/ds-platform, root-owned 0755:
# never in the world-writable sticky /run/lock, where any uid can create the lock file
# first and fs.protected_regular then denies even root's O_CREAT open of it. A non-root
# caller (the stage driver, as deploy) cannot write there and locks in its own
# /run/lock/ds-platform-<user>. /run is tmpfs, so the directory is (re)created and
# checked on every call: it must be a real directory owned by the caller and writable
# by nobody else. This block is one definition in ds-release and the release driver
# (tools/deploy/release-driver.test.mjs).
default_lock_dir() {
  if [[ $EUID -eq 0 ]]; then printf '/run/ds-platform'; else printf '/run/lock/ds-platform-%s' "$(id -un)"; fi
}
# Prints why <dir> is no lock directory for this caller; nothing when it is one.
lock_dir_problem() {
  local dir=$1 uid owner mode
  [[ -e $dir || -L $dir ]] || mkdir -m 0755 -- "$dir" 2>/dev/null || true
  if [[ -L $dir ]]; then printf 'lock directory %s is a symlink' "$dir"; return 0; fi
  if [[ -e $dir && ! -d $dir ]]; then printf 'lock directory %s is not a directory' "$dir"; return 0; fi
  if [[ ! -d $dir ]]; then printf 'lock directory %s is missing and cannot be created' "$dir"; return 0; fi
  read -r uid owner mode < <(stat -c '%u %U %a' -- "$dir")
  if [[ $uid != "$EUID" ]]; then printf 'lock directory %s is owned by %s, not by the caller' "$dir" "$owner"; return 0; fi
  if (( 8#$mode & 8#022 )); then printf 'lock directory %s is group- or other-writable (mode %s)' "$dir" "$mode"; fi
  return 0
}
# The refusal for a lock path the caller cannot open, instead of bash's bare
# `Permission denied`.
lock_file_problem() {
  printf 'cannot open lock %s (owner %s)' "$1" "$(stat -c %U -- "$1" 2>/dev/null || printf unknown)"
}

SELF_PATH=/usr/local/lib/ds-platform/release-driver
# Test hooks: a root prefix and a few overrides, honoured only when this file runs
# from anywhere but its installed path.
ROOT=
if [[ ${BASH_SOURCE[0]} != "$SELF_PATH" ]]; then
  ROOT=${DS_DRIVER_ROOT:-}
fi
override() { [[ -n $ROOT ]] && printf '%s' "${!1:-$2}" || printf '%s' "$2"; }
SELF=$(override DS_DRIVER_SELF "$SELF_PATH")
DS_RELEASE=$ROOT/usr/local/bin/ds-release
NODE=$ROOT/usr/local/bin/node
BOX_ROLE_FILE=$ROOT/etc/ds-platform/box-role
MANIFEST_DIR=$ROOT/var/lib/ds-platform/release-driver
LOCK_DIR=$(override DS_DRIVER_LOCK_DIR "$(default_lock_dir)")
CODELOAD=$(override DS_DRIVER_CODELOAD https://codeload.github.com/doctor-school/ds-platform/tar.gz)
GITHUB_API=$(override DS_DRIVER_GITHUB_API https://api.github.com/repos/doctor-school/ds-platform)
REGISTRY_PULL_TOKEN=$ROOT/etc/ds-platform/registry-pull-token
MANIFEST_MAX_BYTES=65536
# #2987: the box-side rollback. The tooling tree a forward install recorded (one line
# `<sha> <path>`, tools/deploy/lib/remote.mjs INSTALLED_TREE_FILE), the rollback's own
# records and manifests, and how many of the latest `release-*` Releases a rollback
# may target (registry-retention.mjs RELEASES_KEPT keeps exactly their images).
INSTALLED_TREE_FILE=$ROOT/usr/local/lib/ds-platform/installed-tree
ROLLBACK_DIR=$MANIFEST_DIR/rollback
ROLLBACK_RELEASES=3
TREE_PATH_RE='^/[A-Za-z0-9._/-]+$'

# A copy of ds-release's (tools/deploy/release-driver.test.mjs pins them equal).
ENV_RE='^(prod|stage-main|stage-pr-[1-9][0-9]*)$'
SHA_RE='^[0-9a-f]{40}$'
USER_RE='^[a-z_][a-z0-9_-]*$'
# The recorded image set of tools/deploy/lib/registry.mjs (RECORDED_IMAGE_NAMES, the
# release namespace of its digest reference, RELEASE_MANIFEST_REFS) — pinned equal by
# the same test. slot.mjs validates the manifest again before it pulls anything.
IMAGE_NAMES='api api-migrate portal admin doctor login'
# LATER_IMAGE_NAMES = LATER_RECORDED_IMAGE_NAMES: keys a manifest recorded before them
# (a rollback target) lacks.
LATER_IMAGE_NAMES='login'
IMAGE_REGISTRY='ds-platform.registry.twcstorage.ru'
IMAGE_REF_RE='^ds-platform\.registry\.twcstorage\.ru/([a-z0-9][a-z0-9-]*)@sha256:[0-9a-f]{64}$'
MANIFEST_REF_RE='^(main|hotfix/[0-9]+-[a-z0-9-]+)$'

TAG=ds-release-driver
say() { printf '%s: %s\n' "$TAG" "$*"; }
usage() { printf '%s: %s\n' "$TAG" "$*" >&2; exit 2; }
refuse() { printf '%s: %s\n' "$TAG" "$*" >&2; exit 3; }
fail() { printf '%s: %s\n' "$TAG" "$*" >&2; exit 1; }

check_args() {
  [[ $# -eq 2 ]] || usage "usage: release-driver <env> <sha>"
  [[ $1 =~ $ENV_RE ]] || usage "bad env (want prod, stage-main or stage-pr-<N>)"
  [[ $2 =~ $SHA_RE ]] || usage "bad sha (want the full 40-hex commit id)"
}

unit_name() { printf 'ds-%s-%s-driver' "$1" "${2:0:12}"; }

# The driver's per-env lock on fd 8, held until the process exits.
take_driver_lock() {
  local problem lock=$LOCK_DIR/ds-release-driver-$1.lock
  problem=$(lock_dir_problem "$LOCK_DIR")
  [[ -z $problem ]] || refuse "refused: $problem"
  { exec 8>"$lock"; } 2>/dev/null || refuse "refused: $(lock_file_problem "$lock")"
  flock -n 8 || refuse "refused: another release-driver call for $1 is in progress"
}

# The unit's state as the interface reports it. `active` is the PROCESS, not systemd's
# ActiveState (a finished --remain-after-exit unit stays `active (exited)` there): a
# running process -> `active` (`activating` while starting); exited with ExecMainStatus
# 0 -> `inactive`, rc 0; exited non-zero, or systemd's `failed` -> `failed`, rc =
# ExecMainStatus; a unit systemd does not know (never started, reset) -> `absent`.
unit_state() {
  local unit=$1 key value load= active= sub= code= status=
  while IFS='=' read -r key value; do
    case $key in
      LoadState) load=$value ;;
      ActiveState) active=$value ;;
      SubState) sub=$value ;;
      ExecMainCode) code=$value ;;
      ExecMainStatus) status=$value ;;
    esac
  done < <(systemctl show --property=LoadState,ActiveState,SubState,ExecMainCode,ExecMainStatus \
    "$unit.service" 2>/dev/null || true)
  local state rc=null
  [[ $status =~ ^[0-9]+$ ]] || status=
  case $load/$active/$sub in
    loaded/activating/* | loaded/reloading/*) state=activating ;;
    loaded/active/running | loaded/deactivating/*) state=active ;;
    loaded/failed/*) state=failed rc=${status:-null} ;;
    loaded/active/exited | loaded/inactive/*)
      # The process ended. ExecMainCode 0 = it never ran (no driver run at all);
      # otherwise its ExecMainStatus is the verdict: 0 succeeded, anything else failed.
      if [[ -z $code || $code == 0 || -z $status ]]; then
        state=absent
      elif [[ $status == 0 ]]; then
        state=inactive rc=0
      else
        state=failed rc=$status
      fi
      ;;
    loaded/active/*) state=active ;;
    *) state=absent ;;
  esac
  printf '%s %s\n' "$state" "$rc"
}

# The recorded previous SHA of <sha>'s release as a JSON value: "<sha>" or null.
previous_sha() {
  local value
  value=$(sudo cat "$MANIFEST_DIR/$1.previous" 2>/dev/null | tr -d '[:space:]' || true)
  if [[ $value =~ $SHA_RE ]]; then printf '"%s"' "$value"; else printf 'null'; fi
}

# #3439: a failure note as the one JSON value `status` carries — {"phase", "reason"},
# the phase a strict id or null, the reason one control-free line of at most
# FAILURE_REASON_MAX characters — or null when the note is absent or unreadable. The
# note crosses into a public Actions log: prod.mjs's releaseFailureNote decides what
# it says (an allow-list of authored refusals); this bounds its shape.
FAILURE_REASON_MAX=160
read -r -d '' FAILURE_PY <<'PY' || true
import json, re, sys
limit = int(sys.argv[1])
try:
    doc = json.loads(sys.stdin.buffer.read().decode("utf-8", "replace"))
    phase, reason = doc.get("phase"), doc.get("reason")
    if not (isinstance(phase, str) and re.fullmatch(r"[a-z][a-z0-9-]{0,39}", phase)):
        phase = None
    if not isinstance(reason, str):
        reason = ""
    reason = " ".join(re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", reason).split())
    if len(reason) > limit:
        reason = reason[: limit - 1] + "…"
    if phase is None and not reason:
        raise ValueError("empty note")
    print(json.dumps({"phase": phase, "reason": reason or None}, separators=(",", ":")))
except Exception:
    print("null")
PY
failure_note() { python3 -I -c "$FAILURE_PY" "$FAILURE_REASON_MAX"; }

# The recorded failure note of <sha>'s unit run, as that JSON value.
recorded_failure() {
  { sudo cat "$MANIFEST_DIR/$1.failure" 2>/dev/null || true; } | failure_note
}

# (the unit) Records the JSON note <note> as <sha>'s failure, root-only beside its
# manifest; a note that normalises to nothing is not recorded.
record_failure() {
  local sha=$1 note
  note=$(printf '%s' "$2" | failure_note)
  [[ $note != null ]] || return 0
  sudo install -d -m 0700 -o root -g root "$MANIFEST_DIR"
  printf '%s\n' "$note" | sudo tee "$MANIFEST_DIR/$sha.failure" >/dev/null
  sudo chmod 0600 "$MANIFEST_DIR/$sha.failure"
}

cmd_unit_state() {
  check_args "$@"
  local unit state rc
  unit=$(unit_name "$1" "$2")
  read -r state rc < <(unit_state "$unit")
  printf '{"unit":"%s","active":"%s","rc":%s,"previousSha":%s,"failure":%s}\n' \
    "$unit" "$state" "$rc" "$(previous_sha "$2")" "$(recorded_failure "$2")"
}

cmd_record_previous() {
  [[ $# -eq 3 ]] || usage "usage: release-driver record-previous <env> <sha> <previous-sha|none>"
  check_args "$1" "$2"
  local sha=$2 previous=$3
  # A full SHA, as release-runner.mjs --previous-sha takes it from `status`.
  [[ $previous == none || $previous =~ $SHA_RE ]] || usage "bad previous sha (want a full 40-hex sha or none)"
  # A re-run of <sha> after its swap reads <sha> as the running image: the basis
  # recorded first is the one the release notes range from.
  [[ $(previous_sha "$sha") == null ]] || return 0
  [[ $previous == none ]] && return 0
  sudo install -d -m 0700 -o root -g root "$MANIFEST_DIR"
  printf '%s\n' "$previous" | sudo tee "$MANIFEST_DIR/$sha.previous" >/dev/null
  sudo chmod 0600 "$MANIFEST_DIR/$sha.previous"
}

# The manifest on stdin, checked before anything is started. Prints the reason of a
# refusal on stdout, nothing when it is a manifest of <sha>'s release images.
# The image set must hold every required name; an image beyond IMAGE_NAMES is
# accepted (#3254): a newer tree adds images, and this driver is installed from the
# tree a release ships — refusing them would dead-end every release past the addition.
# Every image, known or not, keeps the same check: a strict name, a sha256 digest
# reference of its own name in the release namespace, and (check_registry_digests)
# the digest the registry serves for <name>:<sha>. The image set itself is judged by
# the shipped tree's slot.mjs / prod.mjs, which pull exactly what they know.
read -r -d '' VALIDATE_PY <<'PY' || true
import json, re, sys
path, sha, names, later, ref_re, image_re = sys.argv[1:7]
NAME_RE = r"[a-z0-9][a-z0-9-]*"
names = names.split()
later = later.split()

def stop(reason):
    print(reason)
    sys.exit(0)

try:
    with open(path, encoding="utf-8") as f:
        doc = json.load(f)
except (OSError, ValueError):
    stop("the manifest is not JSON")
if not isinstance(doc, dict) or sorted(doc) != ["images", "ref", "sha"]:
    stop("the manifest is not {sha, ref, images}")
if doc["sha"] != sha:
    stop("the manifest records another commit")
if not isinstance(doc["ref"], str) or not re.fullmatch(ref_re, doc["ref"]):
    stop("the manifest ref is not main or hotfix/<N>-<slug>")
images = doc["images"]
if not isinstance(images, dict):
    stop("the manifest images are not an object")
if not all(re.fullmatch(NAME_RE, name) for name in images):
    stop("the manifest image names are not all image names")
missing = [name for name in names if name not in later and name not in images]
if missing:
    stop("the manifest images lack " + ", ".join(missing))
for name in sorted(images):
    m = re.fullmatch(image_re, images[name]) if isinstance(images[name], str) else None
    if not m or m.group(1) != name:
        stop("the manifest image " + name + " is not a sha256 digest reference of " + name)
PY

# Tree provenance. GitHub serves a fork-network commit through this repository's own
# codeload URL, so a SHA alone does not say whose code the unit would run. The box asks
# GitHub — public API, no token, no client data — whether <sha> is on `main`: the
# compare main...<sha> must be `behind` (an ancestor of main) or `identical`. Anything
# else — `ahead`, `diverged`, 404, a rate limit, a network error — refuses (fail closed).
# compare <base>...<head>'s `status`; exit 1 when GitHub cannot answer.
compare_status() {
  local body
  body=$(curl -fsS --proto '=https' --max-time 30 -H 'Accept: application/vnd.github+json' \
    "$GITHUB_API/compare/$1...$2" 2>/dev/null) || return 1
  printf '%s' "$body" |
    python3 -I -c 'import json,sys; d=json.load(sys.stdin); print(d.get("status","") if isinstance(d,dict) else "")' \
      2>/dev/null || true
}

check_on_main() {
  local sha=$1 status
  if ! status=$(compare_status main "$sha"); then
    refuse "refused: cannot confirm $sha is on main (GitHub compare unavailable)"
  fi
  case $status in
    behind | identical) ;;
    *) refuse "refused: $sha is not on main (compare status: ${status:-unknown})" ;;
  esac
}

# Prod only (#3157): a release moves production forward. A SHA that does not descend
# from the one production runs is a downgrade — a rollback, which goes through
# `deploy-prod.yml` with `mode: rollback` and its migration floor, never through a release.
# The live SHA is the running api container's image tag `ds-api:<sha>`, the same read
# as prod.mjs's previous-SHA step; compare <live>...<sha> must be `ahead` or
# `identical` (a re-run). An unknown live SHA (no running api: a fresh box) refuses —
# that release stays on the workstation path.
LIVE_IMAGE_RE='^ds-api:([0-9a-f]{7,40})$'
live_prod_sha() {
  local image
  image=$(sudo docker inspect ds-api-prod-api-1 --format '{{.Config.Image}}' 2>/dev/null |
    tr -d '[:space:]' || true)
  if [[ $image =~ $LIVE_IMAGE_RE ]]; then printf '%s' "${BASH_REMATCH[1]}"; fi
}

check_descends_from_live() {
  local sha=$1 live status
  live=$(live_prod_sha)
  [[ -n $live ]] ||
    refuse "refused: the live prod SHA is unknown (no running ds-api-prod-api-1) — release it from the workstation path"
  status=$(compare_status "$live" "$sha") || status=
  case $status in
    ahead | identical) ;;
    *) refuse "refused: $sha does not descend from the live prod SHA ${live:0:12} — a downgrade is a rollback (deploy-prod.yml with mode: rollback)" ;;
  esac
}

# The manifest's image names, the known ones in IMAGE_NAMES order and then any newer
# ones (#3254), one line, each already a VALIDATE_PY-checked name.
read -r -d '' NAMES_PY <<'PY' || true
import json, sys
path, names = sys.argv[1], sys.argv[2].split()
images = json.load(open(path, encoding="utf-8"))["images"]
print(" ".join([n for n in names if n in images] + sorted(set(images) - set(names))))
PY

# Manifest provenance. Every recorded digest must be the one the registry serves for
# <registry>/<image>:<sha> in the release namespace (no `pr/`): only the build
# Environment holds the push token for it, so a manifest cannot name another image.
# The box's own pull credential logs in inside root's shell — the token is never in an
# argv — under a docker config dir of its own (mktemp -d: root-only, removed on exit),
# so this login and its logout never touch root's shared docker login that concurrent
# pull units (slot.mjs's pull steps) rely on between their own login and pull.
read -r -d '' REGISTRY_SH <<'SH' || true
reg=$1 token=$2 tag=$3
shift 3
DOCKER_CONFIG=$(mktemp -d) || exit 7
export DOCKER_CONFIG
trap 'docker logout "$reg" >/dev/null 2>&1; rm -rf -- "$DOCKER_CONFIG"' EXIT
docker login "$reg" -u ds-platform --password-stdin <"$token" >/dev/null 2>&1 || exit 7
for name; do
  printf '%s ' "$name"
  docker manifest inspect --verbose "$reg/$name:$tag" 2>/dev/null | tr -d '\n'
  echo
done
SH

read -r -d '' DIGESTS_PY <<'PY' || true
import json, sys
path, served = sys.argv[1:3]
images = json.load(open(path, encoding="utf-8"))["images"]
seen = {}
for line in served.splitlines():
    name, _, text = line.partition(" ")
    seen[name] = text
for name in sorted(images):
    want = images[name].split("@", 1)[1]
    try:
        doc = json.loads(seen.get(name) or "null")
        got = doc["Descriptor"]["digest"] if isinstance(doc, dict) else None
    except (ValueError, KeyError, TypeError):
        got = None
    if got is None:
        print("the registry serves no single-manifest " + name + " tag of this commit")
        break
    if got != want:
        print("the manifest digest of " + name + " is not the one the registry serves for this commit")
        break
PY

check_registry_digests() {
  local sha=$1 manifest=$2 names served reason
  names=$(python3 -I -c "$NAMES_PY" "$manifest" "$IMAGE_NAMES")
  # shellcheck disable=SC2086 # names is a word list of checked image names
  if ! served=$(sudo sh -c "$REGISTRY_SH" sh "$IMAGE_REGISTRY" "$REGISTRY_PULL_TOKEN" "$sha" $names 2>/dev/null); then
    refuse "refused: cannot read the registry with the box's pull credential"
  fi
  reason=$(python3 -I -c "$DIGESTS_PY" "$manifest" "$served")
  [[ -z $reason ]] || refuse "refused: $reason"
}

box_role() { sudo cat "$BOX_ROLE_FILE" 2>/dev/null | tr -d '[:space:]' || true; }

check_role() {
  local env=$1 role
  role=$(box_role)
  case $role in
    stage)
      [[ $env == stage-main ]] && return 0
      [[ $env == stage-pr-* ]] && refuse "refused: PR slots stay operator-driven (ds-slot up $env)"
      refuse "refused: the stage box serves stage-main, not $env"
      ;;
    prod)
      [[ $env == prod ]] && return 0
      refuse "refused: the prod box serves prod, not $env"
      ;;
    *) refuse "refused: this box has no known role" ;;
  esac
}

# The manifest on stdin into <file>, refused (exit 3) unless it is <sha>'s release
# manifest — the same check for a release and a rollback.
read_manifest() {
  local sha=$1 manifest=$2 reason
  head -c "$((MANIFEST_MAX_BYTES + 1))" >"$manifest"
  (($(stat -c %s "$manifest") <= MANIFEST_MAX_BYTES)) || refuse "refused: the manifest exceeds $MANIFEST_MAX_BYTES bytes"
  reason=$(python3 -I -c "$VALIDATE_PY" "$manifest" "$sha" "$IMAGE_NAMES" "$LATER_IMAGE_NAMES" "$MANIFEST_REF_RE" "$IMAGE_REF_RE")
  [[ -z $reason ]] || refuse "refused: bad manifest: $reason"
}

# #3354: a redeploy re-runs the live SHA only. <sha> must be exactly the running api's
# SHA; anything else is refused naming the mode it is (compare <live>...<sha>).
# [<live>]: a live SHA the caller has just read (empty: unknown), checked as read.
check_is_live() {
  local sha=$1 live=${2-} status
  (($# >= 2)) || live=$(live_prod_sha)
  [[ -n $live ]] ||
    refuse "refused: the live prod SHA is unknown (no running ds-api-prod-api-1) — there is no release to redeploy"
  [[ $live != "$sha" ]] || return 0
  status=$(compare_status "$live" "$sha") || status=
  case $status in
    ahead) refuse "refused: $sha is not the live prod SHA ${live:0:12} — a newer SHA is a release (deploy-prod.yml with mode: release)" ;;
    behind) refuse "refused: $sha is not the live prod SHA ${live:0:12} — an older SHA is a rollback (deploy-prod.yml with mode: rollback)" ;;
    *) refuse "refused: $sha is not the live prod SHA ${live:0:12} — a redeploy re-runs the live SHA only" ;;
  esac
}

cmd_release() { release_unit release "$@"; }

cmd_redeploy() {
  check_args "$@"
  [[ $1 == prod ]] || refuse "refused: a redeploy serves prod only, not $1"
  release_unit redeploy "$@"
}

# <mode> release | redeploy: one path, so a redeploy is the release machinery itself.
release_unit() {
  local mode=$1
  shift
  check_args "$@"
  local env=$1 sha=$2 unit manifest reason state rc out user record
  check_role "$env"
  unit=$(unit_name "$env" "$sha")

  work=$(mktemp -d) # global: the EXIT trap outlives this function
  trap 'rm -rf -- "${work:-}"' EXIT
  manifest=$work/images.json
  read_manifest "$sha" "$manifest"
  # A running converge of this SHA was itself started only after both provenance
  # checks passed: attaching to it needs neither, so a GitHub rate limit or a registry
  # outage never fails a converge that is already running. Re-checked under the lock.
  read -r state rc < <(unit_state "$unit")
  if [[ $state == active || $state == activating ]]; then
    say "attached $unit"
    return 0
  fi
  command -v curl >/dev/null || fail "curl is not installed"
  check_on_main "$sha"
  if [[ $mode == redeploy ]]; then
    check_is_live "$sha"
  elif [[ $env == prod ]]; then
    check_descends_from_live "$sha"
  fi
  check_registry_digests "$sha" "$manifest"

  # One driver call per env at a time: two triggers of one SHA must not both start it.
  take_driver_lock "$env"

  read -r state rc < <(unit_state "$unit")
  if [[ $state == active || $state == activating ]]; then
    say "attached $unit"
    return 0
  fi

  # #3354: the live SHA again, under the lock (a local read): a break-glass rollback
  # that ended since the check above must not be undone by this redeploy.
  if [[ $mode == redeploy ]]; then
    check_is_live "$sha" "$(live_prod_sha)"
  fi

  # #2987: a rollback of this very SHA is not a release step the lease sees (its unit
  # has this SHA's prefix); a release waits for it like for any other running unit.
  # Refused before the lease, the reset and the manifest save: a refusal after the
  # lease would hold prod for a release that never started.
  if [[ $env == prod ]]; then
    local rb_state rb_rc
    read -r rb_state rb_rc < <(unit_state "$(rollback_unit_name "$sha")")
    [[ $rb_state != active && $rb_state != activating ]] ||
      refuse "refused: $(rollback_unit_name "$sha") is still running; wait for it to end"
  fi

  # Another SHA's open release or running unit holds the env (ds-release's lease).
  if ! out=$(sudo "$DS_RELEASE" lease "$env" "$sha" 2>&1); then
    refuse "refused: ${out##*refused: }"
  fi

  if [[ $state == inactive || $state == failed ]]; then
    record=$(sudo "$DS_RELEASE" status "$env" "$sha" 2>/dev/null |
      python3 -I -c 'import json,sys; r=json.load(sys.stdin).get("release") or {}; print(r.get("state",""))' ||
      true)
    # A redeploy exists to run a succeeded release again (#3354).
    if [[ $mode == release && $rc == 0 && $record == succeeded ]]; then
      say "already-succeeded"
      return 0
    fi
    # A finished run of this SHA is started again; ds-release's attempt semantics
    # decide what it re-runs (an open attempt keeps its succeeded steps, a closed one
    # starts afresh).
    sudo systemctl stop "$unit.service" >/dev/null 2>&1 || true
    sudo systemctl reset-failed "$unit.service" >/dev/null 2>&1 || true
  fi

  local process=_run label=
  [[ $mode != redeploy ]] || process=_redeploy label="redeploy "
  user=$(id -un)
  [[ $user =~ $USER_RE ]] || usage "unusable caller user"
  sudo install -d -m 0700 -o root -g root "$MANIFEST_DIR"
  # Only this SHA's manifest is kept: systemd opened every other unit's stdin when it
  # started, and a restart of another SHA saves that SHA's manifest again. Another
  # SHA's recorded previous SHA and failure note go with it: only a leased release asks
  # for its own.
  sudo find "$MANIFEST_DIR" -maxdepth 1 -type f \
    \( -name '*.json' ! -name "$sha.json" -o -name '*.previous' ! -name "$sha.previous" \
    -o -name '*.failure' ! -name "$sha.failure" \) -delete
  sudo install -m 0600 -o root -g root "$manifest" "$MANIFEST_DIR/$sha.json"
  # systemd opens the root-only manifest as the unit's stdin before it drops to the
  # deploy user; the journal takes the unit's output.
  if ! sudo systemd-run --quiet --unit="$unit" --remain-after-exit -p KillMode=mixed \
    --uid="$user" -p StandardInput="file:$MANIFEST_DIR/$sha.json" \
    -p StandardOutput=journal -p StandardError=journal \
    --description="ds-release-driver ${label}$env ${sha:0:12}" \
    "$SELF" "$process" "$env" "$sha" >/dev/null 2>&1; then
    fail "systemd-run could not start $unit"
  fi
  say "started $unit"
}

# --- #2987: the box-side prod rollback (spec §5 «Prod rollback») -------------------
#
# A separate path of the prod driver: its own unit ds-prod-<sha12>-rollback and its
# own record ($ROLLBACK_DIR/<sha>.json, kind `rollback`) — never the release record of
# the SHA, never a `finish`. It takes no lease; ds-release's `check`, with exactly its
# own unit excluded, refuses it while any release step runs.

rollback_unit_name() { printf 'ds-prod-%s-rollback' "${1:0:12}"; }

check_rollback_role() {
  [[ $1 == prod ]] || refuse "refused: a rollback serves prod only, not $1"
  [[ $(box_role) == prod ]] || refuse "refused: the rollback is served by the prod box only"
}

# The target must be a strict ancestor of the live SHA (compare <live>...<sha> =
# `behind`), the mirror of check_descends_from_live: a rollback never moves
# production forward. Sets LIVE.
check_behind_live() {
  local sha=$1 status
  LIVE=$(live_prod_sha)
  [[ -n $LIVE ]] || refuse "refused: the live prod SHA is unknown (no running ds-api-prod-api-1)"
  status=$(compare_status "$LIVE" "$sha") || status=
  [[ $status == behind ]] ||
    refuse "refused: $sha is not behind the live prod SHA ${LIVE:0:12} (compare status: ${status:-unknown}) — a rollback never moves production forward"
}

# The SHA is the target of one of the latest ROLLBACK_RELEASES `release-YYYY.MM.DD-N`
# Releases (ordered by date and sequence, as registry-retention.mjs orders them;
# drafts are not releases). Prints yes, no or unreadable.
read -r -d '' RECENT_PY <<'PY' || true
import json, re, sys
sha, keep = sys.argv[1], int(sys.argv[2])
try:
    doc = json.load(sys.stdin)
except ValueError:
    doc = None
if not isinstance(doc, list):
    print("unreadable")
    sys.exit(0)
tag_re = re.compile(r"^release-(\d{4})\.(\d{2})\.(\d{2})-([1-9]\d*)$")
releases = []
for r in doc:
    if not isinstance(r, dict) or r.get("draft"):
        continue
    m = tag_re.match(str(r.get("tag_name", "")))
    if m:
        releases.append((tuple(int(g) for g in m.groups()), str(r.get("target_commitish", ""))))
releases.sort(reverse=True)
print("yes" if sha in [target for _, target in releases[:keep]] else "no")
PY

check_recent_release() {
  local sha=$1 body verdict
  body=$(curl -fsS --proto '=https' --max-time 30 -H 'Accept: application/vnd.github+json' \
    "$GITHUB_API/releases?per_page=100" 2>/dev/null) ||
    refuse "refused: cannot list the GitHub Releases (GitHub unavailable)"
  verdict=$(printf '%s' "$body" | python3 -I -c "$RECENT_PY" "$sha" "$ROLLBACK_RELEASES")
  case $verdict in
    yes) ;;
    no) refuse "refused: $sha is not the target of one of the latest $ROLLBACK_RELEASES release-* Releases" ;;
    *) refuse "refused: cannot read the GitHub Releases" ;;
  esac
}

# The tooling tree: the box-absolute path the newest forward install recorded, when
# it holds prod.mjs; nothing otherwise.
installed_tree() {
  local line sha path
  line=$(sudo cat "$INSTALLED_TREE_FILE" 2>/dev/null || true)
  read -r sha path _ <<<"$line"
  [[ $sha =~ $SHA_RE && $path =~ $TREE_PATH_RE && $path != *..* ]] || return 0
  [[ -f $ROOT$path/tools/deploy/prod.mjs ]] || return 0
  printf '%s' "$ROOT$path"
}

# The rollback record, written root-only and atomically: `running` (a fresh attempt,
# with the live SHA it rolls off as `from`) or the unit's verdict.
read -r -d '' ROLLBACK_RECORD_PY <<'PY' || true
import json, os, sys, tempfile, time
path, sha, unit, state, origin = sys.argv[1:6]
now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
doc = None
if state != "running":
    try:
        with open(path, encoding="utf-8") as f:
            doc = json.load(f)
    except (OSError, ValueError):
        doc = None
if state == "running" or not isinstance(doc, dict) or doc.get("sha") != sha:
    doc = {"kind": "rollback", "env": "prod", "sha": sha, "unit": unit,
           "from": origin or None, "startedAt": now, "endedAt": None}
doc["state"] = state
if state != "running":
    doc["endedAt"] = now
directory = os.path.dirname(path)
fd, tmp = tempfile.mkstemp(dir=directory, prefix=".rollback.")
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(doc, f, sort_keys=True)
    f.write("\n")
    f.flush()
    os.fsync(f.fileno())
os.chmod(tmp, 0o600)
os.replace(tmp, path)
dfd = os.open(directory, os.O_RDONLY)
os.fsync(dfd)
os.close(dfd)
PY

write_rollback_record() {
  local sha=$1 state=$2 origin=${3:-}
  sudo install -d -m 0700 -o root -g root "$MANIFEST_DIR" "$ROLLBACK_DIR"
  sudo python3 -I -c "$ROLLBACK_RECORD_PY" "$ROLLBACK_DIR/$sha.json" "$sha" \
    "$(rollback_unit_name "$sha")" "$state" "$origin"
}

# The `state` of the SHA's rollback record; nothing when it is absent or unreadable.
rollback_record_state() {
  sudo cat "$ROLLBACK_DIR/$1.json" 2>/dev/null |
    python3 -I -c 'import json,sys
try: r = json.load(sys.stdin)
except ValueError: r = None
print(r.get("state", "") if isinstance(r, dict) and r.get("sha") == sys.argv[1] else "")' "$1" ||
    true
}

cmd_rollback() {
  check_args "$@"
  local env=$1 sha=$2 unit manifest state rc out user
  check_rollback_role "$env"
  unit=$(rollback_unit_name "$sha")

  work=$(mktemp -d) # global: the EXIT trap outlives this function
  trap 'rm -rf -- "${work:-}"' EXIT
  manifest=$work/images.json
  read_manifest "$sha" "$manifest"
  read -r state rc < <(unit_state "$unit")
  if [[ $state == active || $state == activating ]]; then
    say "attached $unit"
    return 0
  fi
  # A re-run after the runner lost contact (#3219): the target is live because this
  # SHA's own rollback finished rc 0 and recorded `succeeded` — answered from the box
  # without the lock, the record or the unit, as release_unit answers a release.
  if [[ ($state == inactive || $state == failed) && $rc == 0 ]] &&
    [[ $(live_prod_sha) == "$sha" && $(rollback_record_state "$sha") == succeeded ]]; then
    say "already-succeeded"
    return 0
  fi
  command -v curl >/dev/null || fail "curl is not installed"
  check_on_main "$sha"
  check_behind_live "$sha"
  check_recent_release "$sha"
  check_registry_digests "$sha" "$manifest"
  [[ -n $(installed_tree) ]] ||
    refuse "refused: no tooling tree is recorded in $INSTALLED_TREE_FILE (a forward release installs it) — roll back with pnpm deploy:prod --rollback"

  # The release driver's own lock: a release and a rollback call never interleave.
  take_driver_lock "$env"
  read -r state rc < <(unit_state "$unit")
  if [[ $state == active || $state == activating ]]; then
    say "attached $unit"
    return 0
  fi
  # Refused while any release step runs (this unit is not running yet).
  if ! out=$(sudo "$DS_RELEASE" check --except "$unit" "$env" 2>&1); then
    refuse "refused: ${out##*refused: }"
  fi
  if [[ $state == inactive || $state == failed ]]; then
    sudo systemctl stop "$unit.service" >/dev/null 2>&1 || true
    sudo systemctl reset-failed "$unit.service" >/dev/null 2>&1 || true
  fi

  user=$(id -un)
  [[ $user =~ $USER_RE ]] || usage "unusable caller user"
  sudo install -d -m 0700 -o root -g root "$MANIFEST_DIR" "$ROLLBACK_DIR"
  sudo find "$ROLLBACK_DIR" -maxdepth 1 -type f -name '*.images.json' ! -name "$sha.images.json" -delete
  sudo install -m 0600 -o root -g root "$manifest" "$ROLLBACK_DIR/$sha.images.json"
  write_rollback_record "$sha" running "$LIVE"
  if ! sudo systemd-run --quiet --unit="$unit" --remain-after-exit -p KillMode=mixed \
    --uid="$user" -p StandardInput="file:$ROLLBACK_DIR/$sha.images.json" \
    -p StandardOutput=journal -p StandardError=journal \
    --description="ds-release-driver rollback ${sha:0:12}" \
    "$SELF" _rollback "$env" "$sha" >/dev/null 2>&1; then
    write_rollback_record "$sha" failed
    fail "systemd-run could not start $unit"
  fi
  say "started $unit"
}

# rollback-status: {"rollback": <record or null>, "driver": {"unit", "active", "rc",
# "previousSha": null}, "live": <live prod SHA or null>} — the `driver` object of a
# release's `status`, for the -rollback unit; `live` lets the runner recover a
# success whose start and re-run calls were both lost (#3219).
read -r -d '' ROLLBACK_STATUS_PY <<'PY' || true
import json, sys
text, unit, active, rc, live = sys.argv[1:6]
record = None
if text.strip():
    try:
        record = json.loads(text)
    except ValueError:
        print("corrupt")
        sys.exit(0)
driver = {"unit": unit, "active": active, "rc": None if rc == "null" else int(rc), "previousSha": None}
print(json.dumps({"rollback": record, "driver": driver, "live": live or None}, sort_keys=False, separators=(",", ":")))
PY

cmd_rollback_status() {
  check_args "$@"
  local env=$1 sha=$2 unit state rc text line
  check_rollback_role "$env"
  unit=$(rollback_unit_name "$sha")
  read -r state rc < <(unit_state "$unit")
  text=$(sudo cat "$ROLLBACK_DIR/$sha.json" 2>/dev/null || true)
  line=$(python3 -I -c "$ROLLBACK_STATUS_PY" "$text" "$unit" "$state" "$rc" "$(live_prod_sha)")
  [[ $line != corrupt ]] || fail "corrupt rollback record of ${sha:0:12}"
  printf '%s\n' "$line"
}

# The rollback unit's process: prod.mjs --local --rollback from the TOOLING tree (the
# newest forward install's), never from the target's own older tree, which has no
# rollback path; prod.mjs fetches the target tree itself to read its files.
cmd_run_rollback() {
  check_args "$@"
  local env=$1 sha=$2 tooling rc
  [[ $env == prod ]] || usage "the rollback runs prod only"
  [[ -x $NODE ]] || fail "node is not installed at $NODE (infra/deploy/bin/install-node.sh)"
  tooling=$(installed_tree)
  if [[ -z $tooling ]]; then
    write_rollback_record "$sha" failed
    fail "no tooling tree is recorded in $INSTALLED_TREE_FILE"
  fi
  set +e
  "$NODE" "$tooling/tools/deploy/prod.mjs" --local --rollback "$sha" --images-file -
  rc=$?
  set -e
  if ((rc == 0)); then write_rollback_record "$sha" succeeded; else write_rollback_record "$sha" failed; fi
  exit "$rc"
}

# The unit's process: the operator converge / release, run on the box from the SHA's
# own tree.
cmd_run() { run_unit release "$@"; }

cmd_run_redeploy() {
  check_args "$@"
  [[ $1 == prod ]] || usage "the redeploy runs prod only"
  run_unit redeploy "$@"
}

run_unit() {
  local mode=$1
  shift
  check_args "$@"
  local env=$1 sha=$2
  local -a command
  case $env/$mode in
    stage-main/release) command=(tools/staging/slot.mjs up main --ref "$sha" --local --images-file -) ;;
    prod/release) command=(tools/deploy/prod.mjs --local --images-file -) ;;
    prod/redeploy) command=(tools/deploy/prod.mjs --local --redeploy --images-file -) ;;
    *) usage "the driver runs stage-main and prod only" ;;
  esac
  # #3439: this attempt's failure note replaces any earlier one before any refusal of
  # this attempt, so `status` never reports an earlier attempt's phase for it. A failed
  # run's note names its phase and reason: prod.mjs's die() writes it to
  # DS_RELEASE_FAILURE_FILE.
  sudo rm -f -- "$MANIFEST_DIR/$sha.failure"
  command -v curl >/dev/null || fail "curl is not installed"
  [[ -x $NODE ]] || fail "node is not installed at $NODE (infra/deploy/bin/install-node.sh)"
  work=$(mktemp -d "${HOME:-/tmp}/ds-release-driver.XXXXXX") # global, for the EXIT trap
  trap 'rm -rf -- "${work:-}"' EXIT
  mkdir "$work/tree"
  echo "downloading $CODELOAD/$sha"
  if ! curl -fsSL --proto '=https' --retry 3 --max-time 600 -o "$work/tree.tar.gz" "$CODELOAD/$sha" ||
    ! tar xzf "$work/tree.tar.gz" --strip-components=1 -C "$work/tree"; then
    record_failure "$sha" '{"phase":"download","reason":"the codeload tree could not be downloaded or extracted"}'
    fail "the codeload tree of ${sha:0:12} could not be downloaded or extracted"
  fi
  set +e
  DS_RELEASE_FAILURE_FILE=$work/failure "$NODE" "$work/tree/${command[0]}" "${command[@]:1}"
  local rc=$?
  set -e
  if ((rc != 0)); then
    if [[ -s $work/failure ]]; then
      record_failure "$sha" "$(head -c 4096 -- "$work/failure")"
    else
      record_failure "$sha" "{\"phase\":null,\"reason\":\"exited $rc without a failure note\"}"
    fi
  fi
  exit "$rc"
}

main() {
  case ${1:-} in
    unit-state) shift; cmd_unit_state "$@" ;;
    record-previous) shift; cmd_record_previous "$@" ;;
    rollback) shift; cmd_rollback "$@" ;;
    rollback-status) shift; cmd_rollback_status "$@" ;;
    redeploy) shift; cmd_redeploy "$@" ;;
    _run) shift; cmd_run "$@" ;;
    _redeploy) shift; cmd_run_redeploy "$@" ;;
    _rollback) shift; cmd_run_rollback "$@" ;;
    *) cmd_release "$@" ;;
  esac
}

main "$@"
