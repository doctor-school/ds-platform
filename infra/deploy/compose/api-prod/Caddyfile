# Caddy vhosts for the 003 slice + webinars wave-1 (spec §5.2; #729 / DSO-134).
# Automatic Let's Encrypt (HTTP-01 over :80), auto-renew, no manual certs. Upstream
# ports verified against the built code (DSO-100): api = 3000 (apps/api/src/main.ts
# PORT default), portal = 3001 (apps/portal/Dockerfile ENV PORT=3001), admin = 3002
# (apps/admin/Dockerfile ENV PORT=3002), doctor = 3004 (apps/doctor/Dockerfile ENV
# PORT=3004, #1723), login = 3005 (apps/login/Dockerfile ENV PORT=3005, #3171),
# centrifugo = 8000 (dev-stand parity),
# zitadel core = 8080 (h2c), zitadel-login = 3000. Certs persist in the caddy_data
# volume (compose.yml).

{
	# ACME contact for expiry notices (spec §5.2).
	email a@preencipium.com
}

# ADR-0015 §4 req 2: the storefront-server-only API prefix is reached only on the
# compose network (api:3000), never through a public vhost. Imported by EVERY app
# vhost, not only api.: each Next host also proxies /v1 to the api (and its BFF
# refuses the prefix too, @ds/schemas/internal-api). Caddy's `path` matcher is
# case-insensitive and judges the cleaned, unescaped path, so `/V1/Internal`,
# `/v1//internal` and percent-encoded spellings land here as well.
(internal_api_unreachable) {
	@internal_api path /v1/internal /v1/internal/*
	handle @internal_api {
		respond 404
	}
}

# Portal (Next.js standalone) — user-facing auth screens (#1171).
academy.doctor.school {
	import internal_api_unreachable
	handle {
		reverse_proxy portal:3001
	}
}

# Doctor storefront (Next.js standalone) — the public doctor-facing site (#1723).
# TEMPORARY host: the root doctor.school cut-over waits on data migration and the
# retirement of the old site (owner decision on #1430, 2026-08-26); that cut-over
# also changes Centrifugo client.allowed_origins (centrifugo/config.json — enforced
# by tools/deploy/centrifugo-origins.test.mjs, #2791). Automatic ACME
# over HTTP-01 like every other vhost — which means the Beget A-record
# `new.doctor.school` → 77.233.220.222 MUST already resolve before the deploy that
# adds this block, or issuance fails instead of producing a working vhost
# (infra/deploy/README.md §"Doctor storefront roll-out"). The doctor app proxies
# /v1/* to the api internally (same-origin __Host- cookie, apps/doctor/next.config.ts).
new.doctor.school {
	import internal_api_unreachable
	handle {
		reverse_proxy doctor:3004
	}
}

# The sign-in host (Next.js standalone, ADR-0015 §4, #3171) — the Login V2
# base_uri of both storefront OIDC clients. Automatic ACME over HTTP-01 like every
# other vhost, so the Beget A-record `login.doctor.school` → 77.233.220.222 MUST
# resolve before the release that adds this block (infra/deploy/README.md
# §"Sign-in host roll-out"). It proxies its /v1/* calls to the api internally.
# Cookies stay host-only: no vhost here adds or rewrites a Set-Cookie
# `Domain` (ADR-0015 §4 req 4).
login.doctor.school {
	import internal_api_unreachable
	handle {
		reverse_proxy login:3005
	}
}

# Admin app (Next.js + Refine standalone) — operator event/program management
# (webinars wave-1, #729). Same auto-ACME treatment as the other vhosts (spec §5.2);
# the admin app proxies /v1/* to the api internally (same-origin __Host- cookie,
# apps/admin/next.config.ts).
admin.doctor.school {
	import internal_api_unreachable
	handle {
		reverse_proxy admin:3002
	}
}

# NestJS BFF/API. The portal proxies /v1/* to the api internally (same-origin
# __Host- cookie), but the api is also directly reachable at api.doctor.school.
# This vhost ALSO carries the realtime plane (webinars wave-1, #729): the api
# derives BOTH the browser wss URL (wss://<host>/connection/websocket) and its
# server-side HTTP-API base (<CENTRIFUGO_URL>/api/*) from the ONE CENTRIFUGO_URL
# env (apps/api/src/room/chat.gateway.ts), so api.env sets
# CENTRIFUGO_URL=https://api.doctor.school and this vhost routes those two path
# families to the centrifugo container. Path safety: the NestJS api serves under
# /v1/* (+ /auth/*), so /connection/* and /api/* are free on this origin. The
# Centrifugo server API is key-gated (X-API-Key) — public exposure over TLS is
# authenticated, and clients hold no publish capability (config namespace).
api.doctor.school {
	import internal_api_unreachable
	# Browser websocket connections (portal room chat).
	handle /connection/websocket {
		reverse_proxy centrifugo:8000
	}
	# Centrifugo server HTTP API (the api's gated publish path; X-API-Key).
	handle /api/* {
		reverse_proxy centrifugo:8000
	}
	handle {
		reverse_proxy api:3000
	}
}

# Zitadel OIDC issuer — single-origin split: Login V2 UI vs core (dev-stand
# idp-proxy pattern, infra/dev-stand/idp/Caddyfile). Core runs TLS_ENABLED=false and
# speaks HTTP/2 cleartext, so the core upstream is h2c://.
id.doctor.school {
	# Login V2 UI paths → the login container.
	handle /ui/v2/login/* {
		reverse_proxy zitadel-login:3000
	}
	# Everything else → Zitadel core (Console, OIDC /oauth /.well-known /v2, gRPC-web).
	handle {
		reverse_proxy h2c://zitadel:8080
	}
}
