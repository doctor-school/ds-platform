# stg-infra Caddy — the STAGE edge (C2, spec 2026-09-08 §3 «Hostnames», Issues #2062/#2194).
#
# One public entry for every slot under `*.stage.doctor.school` (wildcard A record,
# owner-managed in the DNS zone). Per-host certificates are issued ON DEMAND: Caddy
# asks the `ask` endpoint below before touching ACME, so a stray name under the
# wildcard never burns a Let's Encrypt slot. Every staging host sends
# `X-Robots-Tag: noindex` and sits behind ONE basic-auth pair (`STAGE_BASIC_AUTH_*`
# from /etc/ds-platform/stage.env, passed in by compose.yml → caddy.environment).
#
# THE EDGE IS STATIC (#2194). There is no slot registry, no generated include and no
# reload on bring-up: this file alone describes every host that can ever exist,
# through ONE host regexp over the §3 naming convention
#
#     <app>-<slot>.{$STAGE_BASE_DOMAIN}   app  ∈ academy|doctor|admin|api
#                                         slot ∈ main|pr-<N>
#
# mapped to the slot's own container `<slot>-<service>` (`academy` → the `portal`
# service; the `map` table below is the §3 «Hostnames» mapping verbatim). A slot
# coming up or going down changes NOTHING here — Caddy is never reloaded by
# `tools/staging/slot.mjs`. Until a slot is up its hosts answer 401 (no credentials)
# or 502 (credentials, no upstream) — never a certificate error, never an indexable
# page.
#
# Basic-auth exemptions — exactly two, both because the caller carries no browser
# credentials and is authenticated by its own mechanism:
#   1. the two Centrifugo path families on `api-<slot>` (websocket upgrade + the
#      api's X-API-Key publish path) — protected by Centrifugo's HMAC token / API
#      key, as in production (infra/deploy/compose/api-prod/Caddyfile);
#   2. the shared IdP host `id.stage.doctor.school` — every slot api reaches it
#      machine-to-machine through this public origin (IDP_ISSUER is the public URL,
#      infra/deploy/api.env.example), and so does the converge form (b)
#      (README → «Zitadel converge»); Zitadel authenticates on its own.
#
# Upstream ports mirror production (api 3000, portal 3001, admin 3002, doctor 3004,
# centrifugo 8000, zitadel core 8080 h2c, login 3000). Slot containers are reached
# by the container name `<slot>-<service>` on the slot network this container is
# attached to — `containerAliases` in tools/staging/slot.mjs, published as
# `container_name` by infra/deploy/compose/slot/compose.yml.
#
# HOSTNAMES come from `{$STAGE_BASE_DOMAIN}` (/etc/ds-platform/stage.env, passed in
# by compose.yml → caddy.environment).
{
	# ACME contact for expiry notices — same as production.
	email a@preencipium.com

	# The admin API on the loopback is what the compose healthcheck probes. Bound to
	# localhost inside the container; never published.
	admin localhost:2019

	# On-demand issuance is gated by the `ask` endpoint served by this same Caddy on
	# a loopback-only port (the 127.0.0.1:2020 site below): 200 for any WELL-FORMED
	# slot host plus the shared IdP host, 404 for everything else.
	on_demand_tls {
		ask http://127.0.0.1:2020/ask
	}
}

# --- snippets ---------------------------------------------------------------

# Every staging response: keep crawlers out, whatever the status.
(staging_guard) {
	header X-Robots-Tag "noindex, nofollow"
}

# The one credential pair guarding every staging host (bcrypt hash from
# `caddy hash-password`; the env value must be single-quoted in stage.env because
# a bcrypt hash contains a dollar sign).
(staging_basic_auth) {
	basic_auth {
		{$STAGE_BASIC_AUTH_USER} {$STAGE_BASIC_AUTH_HASH}
	}
}

# --- ask endpoint (on-demand TLS gate) -----------------------------------------
#
# Caddy calls `GET /ask?domain=<name>`. The answer is a PURE REGEXP TEST over the
# §3 convention — no registry read, no file under /etc/ds-platform/caddy. A
# well-formed name with nothing behind it therefore gets a certificate and then a
# 502 behind the basic-auth challenge; a malformed name is refused before any ACME
# order starts.
#
# THE ALTERNATIONS BELOW MUST AGREE WITH THE `@stage_slot` / `@stage_centrifugo`
# MATCHERS IN THE HTTPS SITE AT THE BOTTOM OF THIS FILE. That agreement is asserted
# by tools/staging/stage-edge.test.mjs — change one, change the other.
#
# The dots inside `{$STAGE_BASE_DOMAIN}` are not escaped (the value is an env
# substitution, not a literal), so they stay regexp wildcards. Harmless: Caddy only
# consults `ask` for names that already matched the `*.{$STAGE_BASE_DOMAIN}` site
# address.
#
# Bound to 127.0.0.1, not `:2020`: this container is attached to every slot network,
# so an unbound listener would be reachable from code running inside a preview.
#
# The `http://` scheme is load-bearing, not decoration. A bare `127.0.0.1:2020`
# address names an IP host, and automatic HTTPS activates for an IP just as it does
# for a domain — the listener would speak TLS with an internal self-signed
# certificate, while the `on_demand_tls ask` option above dials it in PLAIN HTTP.
# Every ask would fail, so every on-demand handshake would be refused and NO host
# under the wildcard site could ever get a certificate. `http://` turns automatic
# HTTPS off for this site and keeps the loopback-only bind. `caddy validate` does not
# catch the difference: both forms are syntactically valid.
http://127.0.0.1:2020 {
	# The asked name arrives as a query parameter; fold it into the path so a plain
	# `path_regexp` can judge it.
	rewrite * /ask/{query.domain}

	@stage_ask path_regexp ask "^/ask/((academy|doctor|admin|api)-(main|pr-[0-9]+)|id)[.]{$STAGE_BASE_DOMAIN}$"
	handle @stage_ask {
		respond 200
	}

	respond 404
}

# --- port 80 -----------------------------------------------------------------

# Plain HTTP: the box liveness probe by IP and ACME HTTP-01 (handled by Caddy before
# routing). Anything else is a blunt 404 so this IP never looks like a misconfigured
# production host.
#
# No explicit redirect to HTTPS here: automatic HTTPS is expected to answer 308 for
# every host the wildcard site below matches, before this site is consulted, so a
# `redir @stage … permanent` line would be config that never runs (#2153 review).
:80 {
	respond /healthz "ok" 200

	respond "stage-1 edge: unknown host" 404
}

# --- HTTPS: every staging host ------------------------------------------------

*.{$STAGE_BASE_DOMAIN} {
	tls {
		on_demand
	}
	import staging_guard

	# Shared IdP — Zitadel core + Login V2 under one origin, production shape
	# (infra/deploy/compose/api-prod/Caddyfile → id.doctor.school). Not behind basic
	# auth: see the header of this file.
	@id host id.{$STAGE_BASE_DOMAIN}
	handle @id {
		handle /ui/v2/login/* {
			reverse_proxy idp-login:3000
		}
		handle {
			reverse_proxy h2c://idp:8080
		}
	}

	# Centrifugo path families on `api-<slot>` — the ONE basic-auth exemption on a
	# slot (spec §3): browser websocket + the api's key-gated publish path. The
	# capture name `slot` is shared with `@stage_slot` below, so `{re.slot.2}` names
	# the slot in either branch.
	@stage_centrifugo {
		header_regexp slot Host "^(api)-(main|pr-[0-9]+)[.]"
		path /connection/websocket /api/*
	}
	handle @stage_centrifugo {
		reverse_proxy {re.slot.2}-centrifugo:8000
	}

	# Every slot host, live or not. The domain suffix is already guaranteed by this
	# site's address, so the regexp only judges the single label in front of it.
	# MUST AGREE WITH the `@stage_ask` matcher above (asserted by
	# tools/staging/stage-edge.test.mjs).
	@stage_slot header_regexp slot Host "^(academy|doctor|admin|api)-(main|pr-[0-9]+)[.]"
	handle @stage_slot {
		# §3 «Hostnames»: the public <app> label → the slot's compose service.
		map {re.slot.1} {slot_service} {slot_port} {
			academy portal 3001
			doctor  doctor 3004
			admin   admin  3002
			api     api    3000
		}

		import staging_basic_auth
		reverse_proxy {re.slot.2}-{slot_service}:{slot_port}
	}

	# A host under the wildcard that is not a well-formed slot host: still guarded,
	# still noindex.
	handle {
		import staging_basic_auth
		respond "stage-1 edge: unknown staging host" 404
	}
}
