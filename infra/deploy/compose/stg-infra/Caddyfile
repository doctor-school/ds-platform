# stg-infra Caddy — the STAGE edge (C2, spec 2026-09-08 §3 «Hostnames», Issue #2062).
#
# One public entry for every slot under `*.stage.doctor.school` (wildcard A record,
# owner-managed in the DNS zone). Per-host certificates are issued ON DEMAND: Caddy
# asks the `ask` endpoint below before touching ACME, so a stray name under the
# wildcard never burns a Let's Encrypt slot. Every staging host sends
# `X-Robots-Tag: noindex` and sits behind ONE basic-auth pair (`STAGE_BASIC_AUTH_*`
# from /etc/ds-platform/stage.env, passed in by compose.yml → caddy.environment).
#
# Basic-auth exemptions — exactly two, both because the caller carries no browser
# credentials and is authenticated by its own mechanism:
#   1. the two Centrifugo path families on `api-<slot>` (websocket upgrade + the
#      api's X-API-Key publish path) — protected by Centrifugo's HMAC token / API
#      key, as in production (infra/deploy/compose/api-prod/Caddyfile);
#   2. the shared IdP host `id.stage.doctor.school` — every slot api reaches it
#      machine-to-machine through this public origin (IDP_ISSUER is the public URL,
#      infra/deploy/api.env.example), and so does the converge form (b)
#      (README → «Zitadel converge»); Zitadel authenticates on its own.
#
# Upstream ports mirror production (api 3000, portal 3001, admin 3002, doctor 3004,
# centrifugo 8000, zitadel core 8080 h2c, login 3000). Slot containers are reached
# by the container name `<slot>-<service>` on the slot network `slot up` attaches
# this container to — `containerAliases` in tools/staging/slot.mjs, published as
# `container_name` by infra/deploy/compose/slot/compose.yml. Until a slot is up its
# hosts answer 401 (no credentials) or 502 (credentials, no upstream) — never a
# certificate error and never an indexable page.
#
# GENERATED INCLUDES. Two files under /etc/caddy/slots (host path
# /etc/ds-platform/caddy, mounted read-only by compose.yml) are rendered by
# `tools/staging/slot.mjs` from ONE slot registry and are never edited by hand:
#   - `ask.caddy`   — the on-demand-TLS allow list (the 127.0.0.1:2020 site below);
#   - `slots.caddy` — one `import slot <name>` line per live slot.
# They move in lockstep because they come from the same registry. `slot render`
# writes both (comment-only files when no slot is up), so this Caddyfile parses on
# a box where nothing has been deployed yet — run it once before the first bring-up.
#
# HOSTNAMES come from `{$STAGE_BASE_DOMAIN}` (/etc/ds-platform/stage.env, passed in
# by compose.yml → caddy.environment). `slot.mjs` reads the SAME variable to derive
# the literal hosts it writes into the includes: one variable, two consumers, one
# value.
{
	# ACME contact for expiry notices — same as production.
	email a@preencipium.com

	# The admin API on the loopback is what the compose healthcheck probes and what
	# `slot up` uses for a config reload. Bound to localhost inside the container;
	# never published.
	admin localhost:2019

	# On-demand issuance is gated by the `ask` endpoint served by this same Caddy on
	# a loopback-only port (the 127.0.0.1:2020 site below): 200 only for the hosts of
	# currently registered slots, straight from the rendered registry include.
	on_demand_tls {
		ask http://127.0.0.1:2020/ask
	}
}

# --- snippets ---------------------------------------------------------------

# Every staging response: keep crawlers out, whatever the status.
(staging_guard) {
	header X-Robots-Tag "noindex, nofollow"
}

# The one credential pair guarding every staging host (bcrypt hash from
# `caddy hash-password`; the env value must be single-quoted in stage.env because
# a bcrypt hash contains `$`).
(staging_basic_auth) {
	basic_auth {
		{$STAGE_BASIC_AUTH_USER} {$STAGE_BASIC_AUTH_HASH}
	}
}

# One slot = four vhosts. The `import slot <name>` lines live in the GENERATED
# `slots.caddy` include, rendered from the slot registry by `slot up` / `slot down`,
# which then reload this config.
(slot) {
	@academy_{args[0]} host academy-{args[0]}.{$STAGE_BASE_DOMAIN}
	handle @academy_{args[0]} {
		import staging_basic_auth
		reverse_proxy {args[0]}-portal:3001
	}

	@doctor_{args[0]} host doctor-{args[0]}.{$STAGE_BASE_DOMAIN}
	handle @doctor_{args[0]} {
		import staging_basic_auth
		reverse_proxy {args[0]}-doctor:3004
	}

	@admin_{args[0]} host admin-{args[0]}.{$STAGE_BASE_DOMAIN}
	handle @admin_{args[0]} {
		import staging_basic_auth
		reverse_proxy {args[0]}-admin:3002
	}

	@api_{args[0]} host api-{args[0]}.{$STAGE_BASE_DOMAIN}
	handle @api_{args[0]} {
		# Centrifugo path families — the single basic-auth exemption on a slot
		# (spec §3): browser websocket + the api's key-gated publish path.
		handle /connection/websocket {
			reverse_proxy {args[0]}-centrifugo:8000
		}
		handle /api/* {
			reverse_proxy {args[0]}-centrifugo:8000
		}
		handle {
			import staging_basic_auth
			reverse_proxy {args[0]}-api:3000
		}
	}
}

# --- ask endpoint (on-demand TLS gate) -----------------------------------------

# Caddy calls `GET /ask?domain=<name>` before issuing. The allow list is the
# GENERATED `ask.caddy` include — the shared IdP host plus every host of every
# registered slot; anything else falls through to the 404 and never reaches ACME.
#
# Bound to 127.0.0.1, not `:2020`: this container is attached to every slot network,
# so an unbound listener would expose the registry to code running inside a preview.
# Caddy dials its own `ask` over the container loopback, which 127.0.0.1 serves.
127.0.0.1:2020 {
	import /etc/caddy/slots/ask.caddy
	respond 404
}

# --- port 80 -----------------------------------------------------------------

# Plain HTTP: the box liveness probe by IP and ACME HTTP-01 (handled by Caddy before
# routing). Anything else is a blunt 404 so this IP never looks like a misconfigured
# production host.
#
# No explicit redirect to HTTPS here: automatic HTTPS already answers 308 for every
# host the wildcard site below matches, before this site is consulted, so a
# `redir @stage … permanent` line would be config that never runs (#2153 review).
:80 {
	respond /healthz "ok" 200

	respond "stage-1 edge: unknown host" 404
}

# --- HTTPS: every staging host ------------------------------------------------

*.{$STAGE_BASE_DOMAIN} {
	tls {
		on_demand
	}
	import staging_guard

	# Shared IdP — Zitadel core + Login V2 under one origin, production shape
	# (infra/deploy/compose/api-prod/Caddyfile → id.doctor.school). Not behind basic
	# auth: see the header of this file.
	@id host id.{$STAGE_BASE_DOMAIN}
	handle @id {
		handle /ui/v2/login/* {
			reverse_proxy idp-login:3000
		}
		handle {
			reverse_proxy h2c://idp:8080
		}
	}

	# Registered slots — one import line per live slot, generated from the registry
	# (see «GENERATED INCLUDES» in the header).
	import /etc/caddy/slots/slots.caddy

	# A host under the wildcard that no slot owns: still guarded, still noindex.
	handle {
		import staging_basic_auth
		respond "stage-1 edge: no slot owns this host" 404
	}
}
