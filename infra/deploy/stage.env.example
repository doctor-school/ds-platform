# stage.env.example — the box env set for stage-1, the STAGE stand box (#2061).
#
# Deployed as /etc/ds-platform/stage.env, 0600 root:root, written by the owner at
# Phase B and NEVER committed with real values (prod precedent: api.env.example,
# data.env.example, zitadel.env.example beside this file).
#
# THE RULE THIS FILE EXISTS TO ENFORCE (tech spec §3 «Secrets and side effects»):
# the box holds NO production credential of any kind. Every value here is a sink, a
# key for a captcha created for this stand, or a secret generated for this box alone.
# Production S3 and the production Zitadel are public endpoints the box can always
# resolve — the control is authorization, not the network, so it is the ABSENCE of
# these values that keeps a preview running arbitrary PR code from touching
# production data.
#
# Consumed by: infra/deploy/compose/stg-infra/compose.yml (env_file) and, per slot,
# by the slot script (step 4, #2064), which derives each slot's DATABASE_URL /
# REDIS_URL / hostnames from these and never re-asks the owner for a secret.
#
# ---------------------------------------------------------------------------
# C1 ACCEPTANCE - the "no production credential" check (README -> AC4)
# ---------------------------------------------------------------------------
# AC4 has TWO halves, because "no production credential" is two different claims and
# one grep cannot carry both. A single must-be-empty list red-lights on a correctly
# provisioned box (this box legitimately sets a captcha key and its own secrets), and
# blanking those to make it pass silently disables the code paths they protect.
# The exact commands are in infra/deploy/compose/stg-infra/README.md -> AC4.
#
# HALF A - MUST BE ABSENT OR EMPTY. These names exist only to carry a PRODUCTION
# credential; there is no staging value for them, so any non-empty value is a finding:
#
#   RESEND_API_KEY                                   (prod transactional email sender)
#   SMSAERO_EMAIL / SMSAERO_API_KEY / SMSAERO_SIGN   (paid SMS gateway - staging sinks)
#   PGBACKREST_REPO1_S3_KEY
#   PGBACKREST_REPO1_S3_KEY_SECRET
#   PGBACKREST_REPO1_CIPHER_PASS                     (no backup repository on this box)
#   IDP_SMTP_REAL_HOST / _USER / _PASSWORD / _SENDER_ADDRESS / _SENDER_NAME
#
# HALF B - MUST BE SET, TO THIS BOX'S OWN VALUE. These names exist in production too,
# but staging carries its own value, so "absent" is the wrong assertion - an empty
# value here silently disables what it protects. AC4 asserts them POSITIVELY:
# non-empty, and never still a `CHANGE_ME_` placeholder.
#
#   BOT_PROTECTION_ENABLED + SMARTCAPTCHA_SERVER_KEY + SMARTCAPTCHA_SITE_KEY
#                                      asserted as a COHERENT trio, not as always-set:
#                                      OFF with an empty site key, or ON with BOTH
#                                      halves of the dedicated staging captcha
#                                      (`ysc2_` / `ysc1_`) — see
#                                      «Bot protection» below (#2207)
#   POSTGRES_PASSWORD / MINIO_ROOT_PASSWORD / IDP_SECRET_KEY
#   IDP_BOOTSTRAP_ADMIN_PASSWORD / STAGE_BASIC_AUTH_HASH / STAGE_GATE_TOKEN
#   AUDIT_IDENTIFIER_PEPPER / LIFECYCLE_IMPACT_TOKEN_SECRET / IDP_WEBHOOK_SECRET
#   CENTRIFUGO_API_KEY / CENTRIFUGO_TOKEN_HMAC_SECRET
#                                      all GENERATED ON THIS BOX (recipe below), which
#                                      is what makes them un-production by construction
#   IDP_SERVICE_TOKEN / IDP_CLIENT_ID / IDP_CLIENT_SECRET / IDP_PROJECT_ID
#                                      issued by THIS box's Zitadel (provision.sh
#                                      output, «API-side IdP credentials» below);
#                                      empty = every slot's api silently boots the
#                                      in-memory FakeIdpClient (#2226)
#   EMAIL_DELIVERY_MODE=mailpit / SMS_DELIVERY_MODE=sink
#   IDP_SMTP_HOST=mailpit:1025 / IDP_SMS_SINK_ENDPOINT=http://sms-sink:8090/sms
#                                      equal to these exact constants
#
# Generate every HALF B secret ON THE BOX - never copy one from anywhere:
#   openssl rand -hex 24        # passwords, peppers, token secrets
#   openssl rand -hex 32        # STAGE_GATE_TOKEN (the stand-wide gate cookie)
#   openssl rand -hex 16        # IDP_SECRET_KEY - exactly 32 characters
#   caddy hash-password         # STAGE_BASIC_AUTH_HASH (bcrypt)
#
# ---------------------------------------------------------------------------
# Datastores (stg-infra)
# ---------------------------------------------------------------------------
# Generated for this box only; unrelated to the production POSTGRES_PASSWORD.
POSTGRES_PASSWORD=CHANGE_ME_stage_only
# MinIO root credentials — and, by the same token, the S3 credentials every slot's
# api uses. S3_ACCESS_KEY doubles as the MinIO root user so a slot's api and the
# object store agree without a second name; MINIO_ROOT_PASSWORD is therefore the S3
# secret key, which the slot compose interpolates into `api` and `migrate` as
# S3_SECRET_KEY (infra/deploy/compose/slot/compose.yml) — it is never copied into a
# per-slot env file.
#
# The rest of the S3 configuration is DERIVED per slot and belongs in no file you
# edit by hand: `renderSlotEnv` (tools/staging/slot.mjs) writes
# S3_ENDPOINT=https://s3.$STAGE_BASE_DOMAIN (the public host — a presigned SigV4 GET
# is bound to the host it was signed for), S3_BUCKET_UPLOADS=ds-<slot>,
# S3_REGION=us-east-1 and S3_FORCE_PATH_STYLE=true into
# /etc/ds-platform/slots/<slot>.env on every `slot up`.
S3_ACCESS_KEY=stageminio
MINIO_ROOT_PASSWORD=CHANGE_ME_stage_only

# ---------------------------------------------------------------------------
# Identity (shared Zitadel — spec §3 «Identity»)
# ---------------------------------------------------------------------------
# Exactly 32 characters, generated for this box.
IDP_SECRET_KEY=CHANGE_ME_32_chars_exactly______
# The origin browsers reach; must equal the Caddy `id` vhost (#2062, live since
# 2026-09-10), or OIDC discovery advertises a wrong issuer.
IDP_EXTERNAL_DOMAIN=id.stage.doctor.school
IDP_EXTERNAL_PORT=443
IDP_EXTERNAL_SECURE=true
# Set to 1 for the FIRST bring-up only (creates the ds-bootstrap machine user whose
# PAT provision.sh authenticates with, plus the console admin), then unset.
IDP_BOOTSTRAP=
IDP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_stage_only
# Root-provisioned path OUTSIDE the repo checkout, so a slot sync never wipes it.
IDP_LOGIN_PAT_FILE=/etc/ds-platform/idp-login-client.pat

# The converge (infra/dev-stand/idp/provision.sh) reads these; they are the staging
# values of what api.env carries in production.
IDP_PROJECT_NAME=ds-platform-stage
IDP_APP_NAME=ds-platform-stage-web
# The PINS: the hosts that must stay registered no matter which slots exist. Both
# writes are WHOLE-SET — `provision.sh` PUTs exactly this list, and `ds-slot` PUTs
# `pins ∪ rendered slots` — so an EMPTY value here is not «no pins»: provision.sh
# substitutes its localhost DEV defaults (infra/dev-stand/idp/provision.sh:53-54) and
# the box would register http://localhost:3000/... on the staging app. Fill both BEFORE
# the first `provision.sh` run and before the first `ds-slot up`; the values below are
# the long-lived `main` slot on STAGE_BASE_DOMAIN — extend them, never blank them, if
# a further non-slot host is ever added.
IDP_REDIRECT_URIS=https://api-main.stage.doctor.school/auth/callback
IDP_POST_LOGOUT_URIS=https://academy-main.stage.doctor.school,https://doctor-main.stage.doctor.school,https://admin-main.stage.doctor.school

# --- API-side IdP credentials — the SAME four keys api.env carries on prod ---
# (`infra/deploy/api.env.example`). Every slot's `api` reads this file through
# `env_file:` (`infra/deploy/compose/slot/compose.yml`) and binds the REAL Zitadel
# adapter only when IDP_ISSUER (rendered by slot.mjs) AND IDP_SERVICE_TOKEN are both
# set (`apps/api/src/auth/idp/idp.module.ts`). Leave them empty and the api boots the
# in-memory FakeIdpClient WITHOUT any error: registration and login "work", but the
# accounts live in that container's memory, vanish on every `sync`/`up`, and the
# golden accounts `reset-identities` writes into Zitadel answer 401 (#2226).
# Fill them AFTER the first `provision.sh` run (stg-infra README → Zitadel converge):
#   IDP_SERVICE_TOKEN  = the bootstrap PAT, `sudo cat /etc/ds-platform/idp-bootstrap-pat.txt`
#   IDP_CLIENT_ID / IDP_PROJECT_ID = the two `IDP_CLIENT_ID=` / `IDP_PROJECT_ID=` lines
#                        provision.sh prints on STDOUT at the end of every run (NOT the
#                        `reused app <id>` stderr line — that id is the Zitadel app id,
#                        not the OIDC client id; pasting it boots the real adapter whose
#                        token exchange then fails closed)
#   IDP_CLIENT_SECRET  = the `IDP_CLIENT_SECRET=` stdout line, printed ONCE when
#                        provision.sh creates the app; if lost, rotate:
#                        `POST /management/v1/projects/{p}/apps/{a}/oidc_config/_generate_client_secret`
# Then recreate the api of every live slot: `up -d --no-deps --force-recreate api`.
IDP_SERVICE_TOKEN=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_PROJECT_ID=

# ---------------------------------------------------------------------------
# Side effects — SINKS ONLY (nothing here can reach a real recipient)
# ---------------------------------------------------------------------------
# `mailpit` IS the email sink: it is the in-network catcher below, and `mailpit` /
# `real` are the only values provision.sh and apps/api/src/config/env.schema.ts accept.
EMAIL_DELIVERY_MODE=mailpit
SMS_DELIVERY_MODE=sink
# Mailpit, in-network. Zitadel and every slot's api point here.
IDP_SMTP_HOST=mailpit:1025
IDP_SMTP_SENDER_ADDRESS=no-reply@stage.doctor.school
IDP_SMTP_SENDER_NAME="Doctor.School (stage)"
IDP_SMS_SINK_ENDPOINT=http://sms-sink:8090/sms
# Present so the converge's `real` branch has a shape to validate against; NEVER
# selected on this box (SMS_DELIVERY_MODE stays `sink`).
IDP_SMS_AERO_ENDPOINT=http://sms-aero-adapter:8091/sms
# Deliberately EMPTY — see the acceptance grep above. A real key here would let a
# preview running arbitrary PR code spend money and text real doctors.
IDP_SMTP_REAL_PROVIDER=
IDP_SMTP_REAL_HOST=
IDP_SMTP_REAL_USER=
IDP_SMTP_REAL_PASSWORD=
IDP_SMTP_REAL_SENDER_ADDRESS=
IDP_SMTP_REAL_SENDER_NAME=
RESEND_ENABLED=false
RESEND_API_KEY=
SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_SIGN=

# ---------------------------------------------------------------------------
# Bot protection — the DEDICATED STAGING captcha, never the production pair
# ---------------------------------------------------------------------------
# Yandex SmartCaptcha has no vendor test key pair: every key pair belongs to ONE
# captcha created in the Yandex Cloud console and is bound to a host list (or created
# with «Отключить проверку домена»). The stand therefore runs its OWN captcha — created
# by the owner for the stage hostnames, its two halves placed here — so the captcha code
# path runs on every preview without ever touching the production pair. It is ONE SWITCH
# WITH TWO HALVES, and half a pair has exactly one outcome — every slot login answers 403
# at its OTP step (the api guard is on and rejects the empty token the storefront sends
# when its image was baked with no site key; observed on all three slots, 2026-09-14,
# #2207). `pnpm stage:slot up|sync` therefore refuse an incoherent trio by name
# (`assertCaptchaCoherent`):
#   OFF (the default this template ships — a template carries no key material):
#        BOT_PROTECTION_ENABLED=false and an EMPTY SMARTCAPTCHA_SITE_KEY (a placeholder
#        site key would mount a widget the api never validates and break the login form
#        client-side). The guard passes without a token.
#   ON  (what stage-1 itself runs since 2026-09-17, #2209): BOTH halves real — the
#        `ysc2_` server key here (the api reads it) AND the matching `ysc1_` site key
#        here too (the slot compose bakes it into the storefront images as
#        NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY; a slot built while it was empty must be
#        re-converged). Take BOTH halves from the staging captcha in the Yandex Cloud
#        console, never from /etc/ds-platform/api.env on api-prod. Never a `CHANGE_ME_`
#        placeholder here: this is the one HALF B name AC4 asserts as COHERENT, not as
#        always-set.
BOT_PROTECTION_ENABLED=false
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_SITE_KEY=

# ---------------------------------------------------------------------------
# Per-box application secrets (generated here, unrelated to production values)
# ---------------------------------------------------------------------------
# HALF B: generated with `openssl rand -hex 24` ON THIS BOX. AC4 asserts each is
# non-empty and no longer a `CHANGE_ME_` placeholder - being generated here is what
# makes "not a production value" true; blanking them would break the path instead.
AUDIT_IDENTIFIER_PEPPER=CHANGE_ME_stage_only
LIFECYCLE_IMPACT_TOKEN_SECRET=CHANGE_ME_stage_only
IDP_WEBHOOK_SECRET=CHANGE_ME_stage_only
# Centrifugo runs INSIDE each slot, not in stg-infra; these are the shared secrets
# the slot script injects into every slot's api + centrifugo pair.
CENTRIFUGO_API_KEY=CHANGE_ME_stage_only
CENTRIFUGO_TOKEN_HMAC_SECRET=CHANGE_ME_stage_only

# ---------------------------------------------------------------------------
# Edge (consumed by step 2, #2062 — listed here so the owner provisions once)
# ---------------------------------------------------------------------------
# The single basic-auth pair guarding every staging host. Caddy wants a bcrypt hash
# (`caddy hash-password`). SINGLE-QUOTE the hash: the box sources this file with
# `set -a; . stage.env`, so an unquoted bcrypt value has its `$2a`/`$14` fragments
# expanded as shell variables and silently shrinks (60 chars to 56, observed
# 2026-09-09) — Caddy then rejects every password.
STAGE_BASIC_AUTH_USER=stage
STAGE_BASIC_AUTH_HASH='CHANGE_ME_bcrypt_hash'
STAGE_BASE_DOMAIN=stage.doctor.school
# The stand-wide gate cookie value (#2210). After ONE basic-auth success the edge
# sets `ds_stage_gate=<this value>` on `Domain=STAGE_BASE_DOMAIN`, and every slot
# host — current and future — lets that cookie through without a challenge. Same
# trust level as the basic-auth password; hex only (the Caddyfile matches it inside
# a regexp). Rotate: new value here, then `docker compose up -d caddy` — every browser
# is asked once more.
STAGE_GATE_TOKEN=CHANGE_ME_openssl_rand_hex_32
#
# STAGE_BASIC_AUTH_PASS IS NOT A BOX VARIABLE and must NOT be added to this file.
# The box stores only the bcrypt HASH above, which cannot be reversed, so the
# operator-side health check in `pnpm stage:slot up` — the `/v1/health` call against
# `api-<slot>.{STAGE_BASE_DOMAIN}` — has no way to authenticate without the
# PLAINTEXT of the same pair. It is therefore a variable of the OPERATOR MACHINE,
# exported in the shell that runs `pnpm stage:slot` (#2194):
#
#   export STAGE_BASIC_AUTH_PASS='<the plaintext behind STAGE_BASIC_AUTH_HASH>'
#
# `slot.mjs` fails closed by name when it is unset rather than skipping the check.

# ---------------------------------------------------------------------------
# Golden accounts on the shared IdP (consumed by `ds-slot reset-identities`, #2064)
# ---------------------------------------------------------------------------
# The golden dataset's doctors and admin live on the SHARED stage Zitadel, not per
# slot. `ds-slot reset-identities <slot>` converges them: it creates each account
# when absent, always sets its password from the variables below, converges the
# email-verified state, and ensure-ABSENTs the soft-deleted doctor (that one has no
# live IdP account by contract — `packages/db/src/seed/golden/idp.ts`, which is why
# no `DS_GOLDEN_PASSWORD_DOCTOR_DELETED` appears here).
#
# Secrets, owner-placed — the tool only reads them.
DS_GOLDEN_PASSWORD_DOCTOR_UNVERIFIED=CHANGE_ME_golden_password
DS_GOLDEN_PASSWORD_DOCTOR_VERIFIED=CHANGE_ME_golden_password
DS_GOLDEN_PASSWORD_DOCTOR_MFA=CHANGE_ME_golden_password
DS_GOLDEN_PASSWORD_ADMIN=CHANGE_ME_golden_password
#
# The matching `DS_GOLDEN_SUB_*` (the five opaque subject ids the golden seed resolves)
# are NOT placed here and must NOT be filled by hand: they are tool-managed. The same
# `ds-slot reset-identities` run writes all five idempotently to
# `/etc/ds-platform/golden-subjects.env` (root, 0644 — subjects are opaque ids, not
# secrets) and `slot up|sync` merges that file into every rendered slot env, so
# `seed:golden` resolves them with no human step. A slot env rendered before
# `reset-identities` has ever run fails closed naming that command rather than
# emitting blanks.
#
# MFA/TOTP enrolment for the `doctorMfa` and `admin` accounts is deliberately NOT
# converged here — TOTP secrets belong to the scenario runner's secret set (#2067).

# ---------------------------------------------------------------------------
# Observability — intentionally NOT wired
# ---------------------------------------------------------------------------
# No SENTRY_DSN: staging errors are read from container logs and the Playwright
# report. Pointing previews at the production GlitchTip project would poison
# production error triage with failures from unmerged code.
SENTRY_DSN=
SENTRY_ENVIRONMENT=stage
