{
  "name": "@ds/db",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle ORM data layer — schema + createDrizzle factory (ADR-0003). Postgres + pgvector.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./seed/golden": {
      "types": "./dist/seed/golden/index.d.ts",
      "default": "./dist/seed/golden/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:golden": "tsx src/seed/golden/run.ts",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
