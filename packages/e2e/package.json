{
  "name": "@ds/e2e",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "DS Platform end-to-end regression contract (C6) — shared Gherkin step definitions, the two derived walks, and the host navigation-model contract both storefronts render from (tech spec 2026-09-08-staging-previews-and-regression-contour-en.md §6).",
  "exports": {
    ".": "./index.ts",
    "./navigation-model": "./navigation-model.ts",
    "./route-params": "./route-params.ts",
    "./hosts": "./hosts.ts",
    "./captcha-stub": "./lib/captcha-stub.ts",
    "./sign-in": "./lib/sign-in.ts",
    "./live-stand-env": "./lib/live-stand-env.ts",
    "./stand-http-credentials": "./lib/stand-http-credentials.ts",
    "./account-auth-paths": "./lib/account-auth-paths.ts",
    "./storefront-entry": "./lib/storefront-entry.ts",
    "./sign-in-host-api": "./lib/sign-in-host-api.ts",
    "./storefront-entry-watch": "./lib/storefront-entry-watch.ts",
    "./admin-events": "./admin/index.ts",
    "./feed-card": "./lib/feed-card.ts"
  },
  "scripts": {
    "check:host-tags": "tsx bin/check-host-tags.ts",
    "bddgen": "pnpm run check:host-tags && bddgen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest:e2e": "pnpm exec turbo run build --filter=@ds/e2e...",
    "test:e2e": "pnpm run bddgen && playwright test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "playwright-bdd": "^9.2.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@ds/db": "workspace:*",
    "@ds/legal-content": "workspace:*"
  }
}
