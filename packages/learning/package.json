{
  "name": "@ds/learning",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DS Platform learning path — the structure model, the element-type and condition-type catalogs, layered rules with presets, the evaluator and the rule-sentence builder (`.`), and the server half over packages/db (`./server`) (024, ADR-0013 A1).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@ds/db": "workspace:*",
    "@ds/schemas": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
