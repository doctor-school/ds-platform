{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  // `./client` and `./ui` ship as sources the storefront transpiles (like
  // `@ds/event-page`); `tsconfig.ui.json` typechecks them.
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/client/**",
    "src/ui/**"
  ]
}
