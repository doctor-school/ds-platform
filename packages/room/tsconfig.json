{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // jsdom hook/component tests use jest-dom matchers and the Vitest globals
    // (`describe`/`it`/`expect`); declare both so `tsc --noEmit` sees the matcher
    // and global augmentations the same way the runtime setup wires them.
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
