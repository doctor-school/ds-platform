{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "src/styles/tokens.css",
        "src/styles/allowed-tokens.json"
      ],
      "env": ["API_PROXY_TARGET"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "CI",
        "GITHUB_WORKSPACE",
        "IDP_ISSUER",
        "IDP_SERVICE_TOKEN",
        "IDP_CLIENT_ID",
        "IDP_CLIENT_SECRET",
        "IDP_PROJECT_ID",
        "IDP_ORG_ID",
        "IDP_REDIRECT_URI",
        "IDP_SCOPES",
        "IDP_WEBHOOK_SECRET",
        "IDP_VERIFY_EMAIL_CODE_TTL_S",
        "IDP_ACADEMY_CLIENT_ID",
        "IDP_DOCTOR_CLIENT_ID",
        "IDP_SIGN_IN_BASE_URI",
        "SIGN_IN_ACADEMY_LOGIN_URL",
        "SIGN_IN_DOCTOR_LOGIN_URL",
        "SIGN_IN_RECORD_KEY",
        "INTERNAL_API_TOKEN",
        "IDP_ACADEMY_CLIENT_KEY",
        "IDP_DOCTOR_CLIENT_KEY",
        "MAILPIT_URL",
        "SMS_SINK_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
