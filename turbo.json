{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "src/styles/tokens.css",
        "src/styles/allowed-tokens.json"
      ],
      "env": ["API_PROXY_TARGET", "NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "CI",
        "GITHUB_WORKSPACE",
        "IDP_ISSUER",
        "IDP_SERVICE_TOKEN",
        "IDP_CLIENT_ID",
        "IDP_CLIENT_SECRET",
        "IDP_PROJECT_ID",
        "IDP_ORG_ID",
        "IDP_REDIRECT_URI",
        "IDP_SCOPES",
        "IDP_WEBHOOK_SECRET"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
